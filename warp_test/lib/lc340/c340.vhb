--------------------------------------------------------------------------
--		Components for Generic RTL.				--
--------------------------------------------------------------------------

PACKAGE rtlpkg IS

component cy_bufoe
    port   (x	: in bit;
	    oe	: in bit;
	    y	: inout x01z;
	    yfb	: out bit);
end component;

    attribute atomic_rtl of cy_bufoe : component is bufoe_type;

component cy_dltch
    port   (d	: in bit;
	    e	: in bit;
	    q	: out bit);
end component;

    attribute atomic_rtl of cy_dltch : component is dltch_type;

component cy_dff
    port   (d	: in bit;
	    clk	: in bit;
	    q	: out bit);
end component;

    attribute atomic_rtl of cy_dff : component is dff_type;

component cy_xdff
    port   (x1	: in bit;
	    x2	: in bit;
	    clk	: in bit;
	    q	: out bit);
end component;

    attribute atomic_rtl of cy_xdff : component is xdff_type;

component cy_jkff
    port   (j	: in bit;
	    k	: in bit;
	    clk	: in bit;
	    q	: out bit);
end component;

    attribute atomic_rtl of cy_jkff : component is jkff_type;

component cy_buf
    port   (x	: in bit;
	    y	: out bit);
end component;

    attribute atomic_rtl of cy_buf : component is buf_type;

component cy_srlch
    port   (s	: in bit;
	    r	: in bit;
	    q	: out bit);
end component;

component cy_srff
    port   (s	: in bit;
	    r	: in bit;
	    clk	: in bit;
	    q	: out bit);
end component;

    attribute atomic_rtl of cy_srff : component is srff_type;

component cy_dsrff
    port   (d	: in bit;
	    s	: in bit;
	    r	: in bit;
	    clk	: in bit;
	    q	: out bit);
end component;

    attribute atomic_rtl of cy_dsrff : component is dsrff_type;

component cy_tsrff
    port   (t	: in bit;
	    s	: in bit;
	    r	: in bit;
	    clk	: in bit;
	    q	: out bit);
end component;

    attribute atomic_rtl of cy_tsrff : component is tsrff_type;

component cy_tff
    port   (t	: in bit;
	    clk	: in bit;
	    q	: out bit);
end component;

    attribute atomic_rtl of cy_tff : component is tff_type;

component cy_xbuf
    port   (x1	: in bit;
	    x2	: in bit;
	    q	: out bit);
end component;

    attribute atomic_rtl of cy_xbuf : component is xbuf_type;

component cy_triout
    port   (x	: in bit;
	    oe	: in bit;
	    y	: out x01z);
end component;

    attribute atomic_rtl of cy_triout : component is triout_type;

    type reg_sel	is (d_type,dlatch,comb); -- Register type selection.

    component MC_C340
	generic (
	    mcr	: reg_sel := d_type	-- Select type of register:
					-- Register, latch, or Comb.
	);
	port(
	    x1	: in bit;		-- Exor Macro Input (Single).
	    x2	: in bit;		-- Exor Macro Input (Multiple).
	    as	: in bit;		-- Async PreSet input.
	    ar	: in bit;		-- Async Reset input.
	    clk	: in bit;		-- Positive edge clock.
	    oe	: in bit;		-- Output Enable.
	    y	: out x01z;		-- Macro Cell In/Out Pin.
	    fb	: out bit;		-- feedback from before buffer as bit.
	    yfb	: out bit		-- feedback from pin as bit.
	);
    end component;
    attribute atomic_rtl of MC_C340 : component is MC_C340_type;

    component MC340DL                   -- Latch
	port(
	    x1	: in bit;		-- Exor Macro Input (Single).
	    x2	: in bit;		-- Exor Macro Input (Multiple).
	    as	: in bit;		-- Async PreSet input.
	    ar	: in bit;		-- Async Reset input.
	    clk	: in bit;		-- Positive edge clock.
	    oe	: in bit;		-- Output Enable.
	    y	: out x01z;		-- Macro Cell In/Out Pin.
	    fb	: out bit;		-- feedback from before buffer as bit.
	    yfb	: out bit		-- feedback from pin as bit.
	);
    end component;

    component MC340NR                   -- No register.
	port(
	    x1	: in bit;		-- Exor Macro Input (Single).
	    x2	: in bit;		-- Exor Macro Input (Multiple).
	    as	: in bit;		-- Async PreSet input.
	    ar	: in bit;		-- Async Reset input.
	    clk	: in bit;		-- Positive edge clock.
	    oe	: in bit;		-- Output Enable.
	    y	: out x01z;		-- Macro Cell In/Out Pin.
	    fb	: out bit;		-- feedback from before buffer as bit.
	    yfb	: out bit		-- feedback from pin as bit.
	);
    end component;

    component MC340RG                   -- Register.
	port(
	    x1	: in bit;		-- Exor Macro Input (Single).
	    x2	: in bit;		-- Exor Macro Input (Multiple).
	    as	: in bit;		-- Async PreSet input.
	    ar	: in bit;		-- Async Reset input.
	    clk	: in bit;		-- Positive edge clock.
	    oe	: in bit;		-- Output Enable.
	    y	: out x01z;		-- Macro Cell In/Out Pin.
	    fb	: out bit;		-- feedback from before buffer as bit.
	    yfb	: out bit		-- feedback from pin as bit.
	);
    end component;

    component MC_C340_b
	generic (
	    mcr	: reg_sel := d_type	-- Select type of register:
				        -- Register, latch, or Comb.
	);
	port(
	    x1	: in bit;		-- Exor Macro Input (Single).
	    x2	: in bit;		-- Exor Macro Input (Multiple).
	    as	: in bit;		-- Async PreSet input.
	    ar	: in bit;		-- Async Reset input.
	    clk	: in bit;		-- Positive edge clock.
	    fb	: out bit		-- Macro Cell Out bit.
	);
    end component;
    attribute atomic_rtl of MC_C340_b : component is MC_C340_b_type;

    component MC340BDL                  -- Latch
	port(
	x1	: in bit;		-- Exor Macro Input (Single).
	x2	: in bit;		-- Exor Macro Input (Multiple).
	as	: in bit;		-- Async PreSet input.
	ar	: in bit;		-- Async Reset input.
	clk	: in bit;		-- Positive edge clock.
	fb	: out bit		-- Macro Cell Out bit.
	);
    end component;

    component MC340BNR                  -- No register.
	port(
	    x1	: in bit;		-- Exor Macro Input (Single).
	    x2	: in bit;		-- Exor Macro Input (Multiple).
	    as	: in bit;		-- Async PreSet input.
	    ar	: in bit;		-- Async Reset input.
	    clk	: in bit;		-- Positive edge clock.
	    fb	: out bit		-- Macro Cell Out bit.
	);
    end component;

    component MC340BRG                  -- Register.
	port(
	    x1	: in bit;		-- Exor Macro Input (Single).
	    x2	: in bit;		-- Exor Macro Input (Multiple).
	    as	: in bit;		-- Async PreSet input.
	    ar	: in bit;		-- Async Reset input.
	    clk	: in bit;		-- Positive edge clock.
	    fb	: out bit		-- Macro Cell Out bit.
	);
    end component;

    component fb_C340
	port(
	    exp	: in bit;		-- Input to expander.
	    fb	: out bit		-- Output from expander.
	);
    end component;
    attribute atomic_rtl of fb_C340 : component is fb_C340_type;

component cy_dsrffe
    port   (d	: in bit;
	    s	: in bit;
	    r	: in bit;
	    e	: in bit;
	    clk	: in bit;
	    q	: out bit);
end component;

component cy_c39kcarry
    port   (SelIn	: in bit;
	    Cpt0	: in bit;
	    Cpt1	: in bit;
	    SelOut	: out bit);
end component;

component cy_c39kxor
    port   (SIn 	: in bit;
	    PtmPts	: in bit;
	    XorOut	: out bit);
end component;

component cy_c39kmultiply
    generic(IsSigned	: BOOLEAN := FALSE;
	DataWidthA	: positive;
	DataWidthB	: positive;
	DataWidthP	: positive;

	Hint		: goal_type := memory);

    port   (Data_A	: in  bit_vector(DataWidthA-1 downto 0);
	    Data_B	: in  bit_vector(DataWidthB-1 downto 0);
	    Product	: out bit_vector(DataWidthP-1 downto 0));
end component;

    attribute atomic_rtl of cy_c39kmultiply : component is not_allowed_type;

TYPE fdbk_source IS (DIRECT, CLOCK_TREE, EXTERNAL);

component cy_c39kpll
    generic(feedback	: fdbk_source	:= DIRECT;
	    multiply	: positive	:= 1;
	    gclk0_phase	: natural	:= 0;
	    gclk0_divide: positive	:= 1;
	    gclk1_phase	: natural	:= 0;
	    gclk1_divide: positive	:= 1;
	    gclk2_phase	: natural	:= 0;
	    gclk2_divide: positive	:= 1;
	    gclk3_phase	: natural	:= 0;
	    gclk3_divide: positive	:= 1;
	    input_freq	: natural	:= 0;
	    ext_fdbk_delay_ps	: natural	:= 0;
	    ext_fdbk_port_out	: string:="");
    port   (pll_in	: in  bit;
	    ext_fdbk	: in  bit	:= '0';
	    lock_detect	: out bit;
	    gclk0	: out bit;
	    gclk1	: out bit;
	    gclk2	: out bit;
	    gclk3	: out bit);
end component;

    attribute atomic_rtl of cy_c39kpll : component is not_allowed_type;

component cy_25g01serdes

    port   (txd		: in  bit_vector (15 downto 0) ;
	    fifo_rstb	: in  bit ;
	    loop_time	: in  bit ;
	    diagloop	: in  bit ;
	    loopa	: in  bit ;
	    lineloop	: in  bit ;
	    resetb	: in  bit ;
	    pwrdnb	: in  bit ;
	    lockrefb	: in  bit ;
	    refclk_n	: in  bit ;
	    refclk_p	: in  bit ;
	    serial_in_n : in  bit ;
	    serial_in_p	: in  bit ;
	    sd		: in  bit ;
	    serial_out_n: out bit ;
	    serial_out_p: out bit ;
	    fifo_err	: out bit ;
	    txclk	: out bit ;
	    rxd		: out bit_vector (15 downto 0) ;
	    rxclk	: out bit ;
	    lfib	: out bit );

end component;

    attribute atomic_rtl of cy_25g01serdes : component is not_allowed_type;

component cy_15g04serdes

    port (  txda		: in	bit_vector(7 downto 0) := (others => '0');
	    txdb		: in	bit_vector(7 downto 0) := (others => '0');
	    txdc		: in	bit_vector(7 downto 0) := (others => '0');
	    txdd		: in	bit_vector(7 downto 0) := (others => '0');
	    txpera		: out	bit;
	    txperb		: out	bit;
	    txperc		: out	bit;
	    txperd		: out	bit;
	    txcta		: in	bit_vector(1 downto 0) := (others => '0');
	    txctb		: in	bit_vector(1 downto 0) := (others => '0');
	    txctc		: in	bit_vector(1 downto 0) := (others => '0');
	    txctd		: in	bit_vector(1 downto 0) := (others => '0');

	    txclka		: in	bit;

	    txclko_p		: out	bit;

	    txrate		: in	bit;
	    txmode		: in	bit_vector(1 downto 0);
	    txcksel		: in	bit;
	    txrstb		: in	bit;

	    rxda		: out	bit_vector(7 downto 0);
	    rxdb		: out	bit_vector(7 downto 0);
	    rxdc		: out	bit_vector(7 downto 0);
	    rxdd		: out	bit_vector(7 downto 0);
	    rxsta		: out	bit_vector(2 downto 0);
	    rxstb		: out	bit_vector(2 downto 0);
	    rxstc		: out	bit_vector(2 downto 0);
	    rxstd		: out	bit_vector(2 downto 0);

	    rxrate		: in	bit;
	    rfen		: in	bit;
	    rxmode		: in	bit_vector(1 downto 0);
	    rxcksel		: in	bit;
	    framchar		: in	bit;
	    rfmode		: in	bit;
	    decmode		: in	bit;

	    spdsel		: in	bit;
	    rxclka_p		: out	bit;
	    rxclkb_p		: inout	bit;
	    rxclkc_p		: out	bit;
	    rxclkd_p		: inout	bit;

	    refclk_p		: in	bit;
	    refclk_n		: in	bit;
	    serial_outa1_p	: out	bit;
	    serial_outb1_p	: out	bit;
	    serial_outc1_p	: out	bit;
	    serial_outd1_p	: out	bit;
	    serial_outa2_p	: out	bit;
	    serial_outb2_p	: out	bit;
	    serial_outc2_p	: out	bit;
	    serial_outd2_p	: out	bit;
	    serial_ina1_p	: in	bit;
	    serial_inb1_p	: in	bit;
	    serial_inc1_p	: in	bit;
	    serial_ind1_p	: in	bit;
	    serial_ina2_p	: in	bit;
	    serial_inb2_p	: in	bit;
	    serial_inc2_p	: in	bit;
	    serial_ind2_p	: in	bit;
	    serial_outa1_n	: out	bit;
	    serial_outb1_n	: out	bit;
	    serial_outc1_n	: out	bit;
	    serial_outd1_n	: out	bit;
	    serial_outa2_n	: out	bit;
	    serial_outb2_n	: out	bit;
	    serial_outc2_n	: out	bit;
	    serial_outd2_n	: out	bit;
	    serial_ina1_n	: in	bit;
	    serial_inb1_n	: in	bit;
	    serial_inc1_n	: in	bit;
	    serial_ind1_n	: in	bit;
	    serial_ina2_n	: in	bit;
	    serial_inb2_n	: in	bit;
	    serial_inc2_n	: in	bit;
	    serial_ind2_n	: in	bit;
	    insela		: in	bit;
	    inselb		: in	bit;
	    inselc		: in	bit;
	    inseld		: in	bit;
	    sdasel		: in	bit;
	    lpen		: in	bit;
	    oele		: in	bit;
	    bistle		: in	bit;
	    rxle		: in	bit;
	    boe			: in	bit_vector(7 downto 0);
	    bondst		: inout	bit_vector(1 downto 0);
	    masterb		: in	bit;
	    bond_all		: inout	bit;
	    bond_inhb		: in	bit;
	    lfiab		: out	bit;
	    lfibb		: out	bit;
	    lficb		: out	bit;
	    lfidb		: out	bit;
	    trstzb		: in	bit);

end component;

    attribute atomic_rtl of cy_15g04serdes : component is not_allowed_type;

component cy_c39kdualport
    generic(DataWidth	: positive := 8;
	AddressWidth	: positive := 11;
	indata_reg	: BOOLEAN  := TRUE;
	addr_ctrl_reg	: BOOLEAN  := TRUE;
	outdataA_reg	: BOOLEAN  := FALSE;
	outdataB_reg	: BOOLEAN  := FALSE;
	FileName	: string   := "");
    port   (DIn_A	: in bit_vector(DataWidth-1 downto 0) :=(others => '0');
	    DIn_B	: in bit_vector(DataWidth-1 downto 0) :=(others => '0');
	    Addr_A	: in bit_vector(AddressWidth-1 downto 0):=(others=>'0');
	    Addr_B	: in bit_vector(AddressWidth-1 downto 0):=(others=>'0');
	    WEA	        : in  bit := '0';
	    WEB	        : in  bit := '0';
	    InClk_A	: in  bit := '0';
	    OutClk_A	: in  bit := '0';
	    OutRegA_AR  : in  bit := '0';
	    InClk_B	: in  bit := '0';
	    OutClk_B	: in  bit := '0';
	    OutRegB_AR  : in  bit := '0';
	    Addr_matchb	: out bit;
	    DOut_A	: out bit_vector(DataWidth-1 downto 0); 
	    DOut_B	: out bit_vector(DataWidth-1 downto 0));
end component;

    attribute atomic_rtl of cy_c39kdualport : component is not_allowed_type;

component cy_c39kfifo
    generic(DataWidth	: positive := 8;
	NumWords	: positive := 512;
	PAFE_Distance	: natural  := 0);
    port   (DIn	        : in  bit_vector(DataWidth-1 downto 0);
	    DOut	: out bit_vector(DataWidth-1 downto 0);
	    ENR	        : in bit := '0';
	    ENW   	: in bit := '0';
	    CKR         : in bit := '0';
	    CKW         : in bit := '0';
	    MRb	        : in bit := '0';
	    EFb	        : out bit;
	    HFb	        : out bit;
	    PAFEb	: out bit);
end component;

    attribute atomic_rtl of cy_c39kfifo : component is not_allowed_type;

component cy_c39ksingleport
    generic(DataWidth  	: positive := 8;
	AddressWidth	: positive := 13;
	indata_reg	: BOOLEAN  := TRUE;
	addr_ctrl_reg	: BOOLEAN  := TRUE;
	outdata_reg	: BOOLEAN  := FALSE;
	FileName	: string   := "");
    port   (Din		: in bit_vector(DataWidth-1 downto 0):=(others => '0');
	    Addr	: in bit_vector(AddressWidth-1 downto 0);
	    WE		: in bit := '0';
	    InClk	: in bit := '0';
	    OutClk	: in bit := '0';
	    OutReg_AR	: in bit := '0';
	    DOut	: out bit_vector(DataWidth-1 downto 0));
end component;

    attribute atomic_rtl of cy_c39ksingleport : component is not_allowed_type;

END rtlpkg;

--------------------------------------------------------------------------
--	Special Macro-cell definitions
--	Entities and  Architectrues
--------------------------------------------------------------------------

library cypress;
use work.rtlpkg.all;
entity MC340DL is                       -- Latch
    port(
	x1	: in bit;		-- Exor Macro Input (Single).
	x2	: in bit;		-- Exor Macro Input (Multiple).
	as	: in bit;		-- Async PreSet input.
	ar	: in bit;		-- Async Reset input.
	clk	: in bit;		-- Positive edge clock.
	oe	: in bit;		-- Output Enable.
	y	: out x01z;		-- Macro Cell In/Out Pin.
	fb	: out bit;		-- feedback from before buffer as bit.
	yfb	: out bit		-- feedback from pin as bit.
    );
end MC340DL;

ARCHITECTURE struct OF MC340DL IS

BEGIN  --  struct 
U1:MC_C340 generic map(dlatch)
          port map(x1, x2, as, ar, clk, oe, y, fb, yfb);
END struct;

library cypress;
use work.rtlpkg.all;
entity MC340NR is                       -- No register.
    port(
	x1	: in bit;		-- Exor Macro Input (Single).
	x2	: in bit;		-- Exor Macro Input (Multiple).
	as	: in bit;		-- Async PreSet input.
	ar	: in bit;		-- Async Reset input.
	clk	: in bit;		-- Positive edge clock.
	oe	: in bit;		-- Output Enable.
	y	: out x01z;		-- Macro Cell In/Out Pin.
	fb	: out bit;		-- feedback from before buffer as bit.
	yfb	: out bit		-- feedback from pin as bit.
    );
end MC340NR;

ARCHITECTURE struct OF MC340NR IS

BEGIN  --  struct 
U1:MC_C340 generic map(comb)
          port map(x1, x2, as, ar, clk, oe, y, fb, yfb);
END struct;

library cypress;
use work.rtlpkg.all;
entity MC340RG is                       -- Register.
    port(
	x1	: in bit;		-- Exor Macro Input (Single).
	x2	: in bit;		-- Exor Macro Input (Multiple).
	as	: in bit;		-- Async PreSet input.
	ar	: in bit;		-- Async Reset input.
	clk	: in bit;		-- Positive edge clock.
	oe	: in bit;		-- Output Enable.
	y	: out x01z;		-- Macro Cell In/Out Pin.
	fb	: out bit;		-- feedback from before buffer as bit.
	yfb	: out bit		-- feedback from pin as bit.
    );
end MC340RG;

ARCHITECTURE struct OF MC340RG IS

BEGIN  --  struct 
U1:MC_C340 generic map(d_type)
          port map(x1, x2, as, ar, clk, oe, y, fb, yfb);
END struct;

library cypress;
use work.rtlpkg.all;
entity MC340BDL is                      -- Latch
    port(
	x1	: in bit;		-- Exor Macro Input (Single).
	x2	: in bit;		-- Exor Macro Input (Multiple).
	as	: in bit;		-- Async PreSet input.
	ar	: in bit;		-- Async Reset input.
	clk	: in bit;		-- Positive edge clock.
	fb	: out bit		-- Macro Cell Out bit.
    );
end MC340BDL;

ARCHITECTURE struct OF MC340BDL IS

BEGIN  --  struct 
U1:MC_C340_B generic map(dlatch)
          port map(x1, x2, as, ar, clk, fb);
END struct;

library cypress;
use work.rtlpkg.all;
entity MC340BNR is                      -- No register.
    port(
	x1	: in bit;		-- Exor Macro Input (Single).
	x2	: in bit;		-- Exor Macro Input (Multiple).
	as	: in bit;		-- Async PreSet input.
	ar	: in bit;		-- Async Reset input.
	clk	: in bit;		-- Positive edge clock.
	fb	: out bit		-- Macro Cell Out bit.
    );
end MC340BNR;

ARCHITECTURE struct OF MC340BNR IS

BEGIN  --  struct 
U1:MC_C340_B generic map(comb)
          port map(x1, x2, as, ar, clk, fb);
END struct;

library cypress;
use work.rtlpkg.all;
entity MC340BRG is                      -- Register.
    port(
	x1	: in bit;		-- Exor Macro Input (Single).
	x2	: in bit;		-- Exor Macro Input (Multiple).
	as	: in bit;		-- Async PreSet input.
	ar	: in bit;		-- Async Reset input.
	clk	: in bit;		-- Positive edge clock.
	fb	: out bit		-- Macro Cell Out bit.
    );
end MC340BRG;

ARCHITECTURE struct OF MC340BRG IS

BEGIN  --  struct 
U1:MC_C340_B generic map(d_type)
          port map(x1, x2, as, ar, clk, fb);
END struct;

--------------------------------------------------------------------------
--      Here are the device entitys.
--------------------------------------------------------------------------

entity c341 is
    port (
	pin1	: in bit;
	pin2	: in bit;
	pin4	: inout x01z;
	pin5	: inout x01z;
	pin6	: inout x01z;
	pin7	: inout x01z;
	pin8	: inout x01z;
	pin9	: inout x01z;
	pin10	: inout x01z;
	pin11	: inout x01z;
	pin12	: inout x01z;
	pin13	: inout x01z;
	pin14	: inout x01z;
	pin15	: inout x01z;
	pin16	: inout x01z;    
	pin17	: inout x01z;
	pin20	: inout x01z;
	pin21	: inout x01z;
	pin22	: inout x01z;
	pin23	: inout x01z;
	pin25	: inout x01z;
	pin26	: inout x01z;
	pin27	: inout x01z;
	pin28	: inout x01z;
	pin29	: inout x01z;
	pin30	: inout x01z;
	pin31	: inout x01z;  
	pin32	: inout x01z;
	pin33	: inout x01z;    
	pin34	: inout x01z;
	pin35	: inout x01z;
	pin36	: inout x01z;    
	pin37	: inout x01z;
	pin38	: inout x01z;
	pin41	: in bit;
	pin42	: in bit;
	pin43	: in bit;
