    // Generate the ATD for A
    always @(addr_a)
    begin : XATD_A
	time	expire_time_a;
	if (cfgbits[4] == 1'b0)
	begin
	    if (atd_a == 1'b0)
	    begin
	    	atd_a <= 1'b1;
	    end
	    else if (expire_time_a >= $time)
	    begin
		atd_a <= #(expire_time_a - $time) 1'b1;
	    end
	    atd_a <= #(xcmAddrTransDetect) 1'b0;
	    expire_time_a = $time + xcmAddrTransDetect;
	end
    end

    // Generate the ATD for B
