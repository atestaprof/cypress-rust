    //									//
    //      Copyright Cypress Semiconductor Corporation, 1994-2001	//
    //      as an unpublished work.					//
    //									//

`define invt	0
`define ninv	1
`define dreg	0
`define treg	1
`define oltch	2
`define cmb	3
`define comb	0
`define ireg	1
`define dblireg	2
`define iltch	3
`define regi	4
`define dblreg	5
`define src_ptm	0
`define src_adj	1
`define xpin	0
`define xreg	1
`define  adj	2
`define xadj	3
`define nopt	0
`define ckpt	1
`define fast	0
`define slow	1
`define hipw	0
`define lopw	1


`timescale 1ps/1ps

module c16v8m (d, clk, oe, adj, y, fb, yfb);
input d, clk, oe, adj;
inout y;
output fb, yfb;

reg fb;
reg yfb;
reg ytemp;

wire y = ytemp;

parameter registered = `regi, inv_setting = `invt, bta_sel = `xreg;

parameter Tpd = 10000, Ten = 10000, Tdis = 10000, Tco = 7000, Tsu = 7000,
          Th = 0, Twh = 8000, Twl = 8000, Tcf = 6000;

	reg	q	;
	reg	q_not	;
	reg	d_mod	;
	reg	d_pol	;
	reg	q_tsu	;
	reg	q_th	;
	reg	q_twh	;
	reg	q_twl	;

	reg	prev_clk, prev_d;
	reg	prev_oe;

	time    dlastev;
	time    clklastev, clklastev_2;

initial
begin
    q_tsu = 1'b0; q_th = 1'b0; q_twh = 1'b0; q_twl = 1'b0; 

    dlastev = 0; clklastev = 0; clklastev_2 = 0;
    prev_clk = clk; prev_d = d; prev_oe = oe;

    if (inv_setting == `invt)
	d_pol = ~d;
    else
	d_pol =  d;

    if (registered == `comb)
	d_mod = d_pol;
    else if (registered == `regi)
	d_mod = q;

    q     =  d_pol;
    q_not = ~d_pol;

    if (oe != 1'b1)
	ytemp = 1'bz;
    else
	ytemp = ~d_mod;

     fb = y;
    yfb = y;
end

always @(d or posedge clk)
	// Check only if the cell is registered.
	if (registered == `regi)
	begin
	    if (prev_clk !== clk && clk == 1'b1)
	    begin
	    // setup violation check
		if ($time != 0 && (($time - dlastev) < Tsu))
		begin
		    $display ("\n%m");
		    $display(" Setup ERROR ON D: Setting output to unknown");
		    q_tsu = 1'b1;
		    q_tsu = #1 1'b0;
		end
		clklastev = $time;
	    end
	    if (prev_d !== d)
	    begin
	    // hold violation check
		if ($time != 0 && (($time - clklastev) < Th))
		begin
		    $display ("\n%m");
		    $display(" Hold ERROR ON D: Setting output to unknown");
		    q_th = 1'b1;
		    q_th = #1 1'b0;
		end
		#0 dlastev = $time;
	    end
	end

always @(clk)
    begin
	// Check only if the cell is registered.
	if (registered == `regi)
	begin
	    if (clk == 1'b0)
	    // H violation
		if ($time != 0 && (($time - clklastev_2) < Twh))
		begin
		    $display ("\n%m");
		    $display("Pulse Width (H) ERROR on CLK: Setting output to unknown");
		    q_twh = 1'b1;
		    q_twh = #1 1'b0;
		end
	    else if (clk == 1'b1)
	    // L violation
		if ($time != 0 && (($time - clklastev_2) < Twl))
		begin
		    $display ("\n%m");
		    $display("Pulse Width (L) ERROR on CLK: Setting output to unknown");
		    q_twl = 1'b1;
		    q_twl = #1 1'b0;
		end
	    #0 clklastev_2 = $time;
	    #0 prev_clk = clk;
	end
    end 


always @(clk or q_tsu or q_th or q_twh or q_twl) 
	 if ((q_tsu == 1'b1) || (q_th  == 1'b1) ||
	     (q_twh == 1'b1) || (q_twl == 1'b1))
	 begin
	     #Tco q <= 1'bx;
	     #Tcf q_not <= 1'bx;
	 end
	 else if (prev_clk !== clk && clk == 1'b1)
	 begin
	     q <= #Tco d_pol;
	     if (d_pol == 1'b1)
	       q_not <= #Tcf 1'b0;
	     else
	       q_not <= #Tcf 1'b1;
	 end

always @(d_pol or q)
	if (registered == `comb)
	    #Tpd d_mod = d_pol;
	else if (registered == `regi)
	    d_mod = q;

always @(d) #0 prev_d = d;
always @(d)
	if (inv_setting == `invt)
	    d_pol = ~d;
	else
	    d_pol =  d;

always @(oe) #0 prev_oe = oe;
always @(oe or d_mod)
	if (prev_oe !== oe)
	    if (oe == 1'b1)
	       #Ten ytemp = ~d_mod;
	    else
	       #Tdis ytemp = 1'bz;
	else
	    if (oe == 1'b1)
	       ytemp = ~d_mod;
	    else
	       ytemp = 1'bz;

always @(y or q_not or adj)
	if (bta_sel == `xpin)
	    if (y == 1'b1)
		fb = 1'b1;
	    else
		fb = 1'b0;
	else if (bta_sel == `xreg)
	    fb = q_not;
	else if (bta_sel == `xadj)
	    fb = adj;

always @(y)
	if (y == 1'b1) 
	    yfb = 1'b1;
	else
	    yfb = 1'b0;

endmodule


`timescale 1ps/1ps

module c20g10m ( d, clk, oe, y, fb); 
input d, clk, oe;
inout y;
output fb;

reg fb;
initial fb <= 1'b0;
reg ytemp;
initial
begin
    if (oe == 1'b1) 
	ytemp <= 1'b0;
    else
	ytemp <= 1'bz;
end

wire y = ytemp;

	// Default: REGistered, NotINVerted, XRegisterd
parameter registered = `regi, inv_setting = `ninv,
	  bta_sel = `xreg;
	// default timing parameters  C20G10C-25JC
parameter Tpd = 25000, Tpzx = 20000, Tpxz = 20000, Tco = 15000, Ts = 15000,
          Th = 0, Twh = 12000, Twl = 12000;

	reg	q	;
	reg	d_mod	;
	reg	d_pol	;
	reg	q_ts	;
	reg	q_th	;
	reg	q_twh	;
	reg	q_twl	;
	reg	prev_clk, prev_d, prev_oe;

	time    dlastev ;
	time    clklastev;

initial
begin
	q_ts = 1'b0; q_th = 1'b0; q_twh = 1'b0;
	q_twl = 1'b0; 
	d_pol = 1'b1;

	dlastev = 0; clklastev = 0;
	prev_clk = clk; prev_d = d; prev_oe = oe;
end

always @(d) #0 prev_d = d;
always @( d or posedge clk )
    begin
	if( registered == `regi)
	begin
	    // setup violation check
	    if( prev_clk !== clk && clk == 1'b1)
	    begin
		if( $time != 0 && (($time - dlastev) < Ts))
		begin
		    $display ("\n%m");
		    $display(" Setup ERROR ON D: Setting output to unknown");
		    q_ts = 1'b1;
		    q_ts <= #1 1'b0;
		end
		clklastev <= $time;
	    end
	    if( prev_d !== d)
	    begin
		if( $time != 0 && (($time - clklastev) < Th))
		begin
		    $display ("\n%m");
		    $display(" Hold ERROR ON D: Setting output to unknown");
		    q_th = 1'b1;
		    q_th <= #1 1'b0;
		end
		dlastev <= $time;	   
	    end
	end
    end 

always @( clk )
    begin
	// Check only if the cell is registered.
	if( registered == `regi)
	begin
	    if( clk == 1'b0 )
		  // H violation
		if( $time != 0 && (($time - clklastev) < Twh))
		begin
		    $display ("\n%m");
		    $display("Pulse Width (H) ERROR on CLK: Setting output to unknown");
		    q_twh = 1'b1;
		    q_twh <= #1 1'b0;
		end
	    else if( clk == 1'b1)
	    begin
		  // L violation
		if( $time != 0 && (($time - clklastev) < Twl))
		begin
		    $display ("\n%m");
		    $display("Pulse Width (L) ERROR on CLK: Setting output to unknown");
		    q_twl = 1'b1;
		    q_twl <= #1 1'b0;
		end
		clklastev <= $time;
		#0 prev_clk = clk;
	    end
	end
    end 

always @( clk or q_ts or q_th or q_twh or q_twl) 
	if ((q_ts  == 1'b1) || (q_th  == 1'b1) ||
	    (q_twh == 1'b1) || (q_twl == 1'b1))
	    q <= #Tco 1'bx;
	else if( prev_clk !== clk && clk == 1'b1)
	    q <= #Tco d;
	else
	    ;

always @( d or q)
	if( registered == `comb)
	    d_mod <= #Tpd d;
	else if( registered == `regi)
	    d_mod <= q;
	else
	    ;

always @( d_mod )
	if( inv_setting == `ninv)
	    if( (d_mod == 1'b0) || (d_mod == 1'b1))
	        d_pol <= ~d_mod;
	    else
	        d_pol <= 1'bx;
	else
	    d_pol <= d_mod;

always @(oe) #0 prev_oe = oe;
always @( oe or d_pol)
    begin
	if( prev_oe !== oe)
	    if( oe == 1'b1)
		if( (d_pol == 1'b0) || (d_pol == 1'b1))
		    ytemp <= #Tpzx ~d_pol;
		else
		    ytemp <= #Tpzx 1'bx;
	    else
		ytemp <= #Tpxz 1'bz;
	else
	    if( oe == 1'b1)
		if( (d_pol == 1'b0) || (d_pol == 1'b1))
		    ytemp <= ~d_pol;
		else
		    ytemp <= 1'bx;
	    else
		ytemp <= 1'bz;
    end

always @( y or q )
	if( bta_sel == `xpin)
	    if( y == 1'b1)
		fb <= 1'b1;
	    else
		fb <= 1'b0;
	else if( bta_sel == `xreg)
	    if( (q == 1'b0) || (q == 1'b1)) 
		fb <= ~q;
	    else
	        fb <= 1'bx;
endmodule


`timescale 1ps/1ps

module c20m (x, oe, y, yfb);
input x, oe;
inout y;
output yfb;

parameter Tpd = 25000, Tea = 25000, Ter = 25000, Tpzx = 20000, Tpxz = 20000, 
          Tco = 15000, Ts = 20000, Th = 0, Tw = 15000; 

reg prev_oe;
initial prev_oe = 1'b0;
reg yfb;
initial yfb = 1'b0;
reg ytemp;
initial
begin
    if (oe == 1'b1)
	ytemp = ~x;
    else
	ytemp = 1'bz;
end

wire y = ytemp;


always @(oe) #0 prev_oe = oe;
always @(oe or x)
	if (prev_oe !== oe)
	    if (oe == 1'b1)
		if (x == 1'b1)
		    ytemp <= #Tea 1'b0;
		else
		    ytemp <= #Tea 1'b1;
	    else
		ytemp <= #Ter 1'bz;
	else
	    if (oe == 1'b1)
		if (x == 1'b1)
		    ytemp <= #Tpd 1'b0;
		else
		    ytemp <= #Tpd 1'b1;
	    else
		ytemp <= 1'bz;

always @(y)
	if (y == 1'b1) 
	    yfb = 1'b1;
	else
	    yfb = 1'b0;

endmodule


`timescale 1ps/1ps

module c20r ( d, oe, clk, y, qfb);
input d, oe, clk;
output y, qfb;

reg y, qfb;

parameter Tpd = 25000, Tea = 25000, Ter = 25000, Tpzx = 20000, Tpxz = 20000, 
          Tco = 15000, Ts = 20000, Th = 0, Tw = 15000; 

	reg	q	;
	reg	q_ts	;
	reg	q_th	;
	reg	q_tw	;
	reg	prev_clk;
	reg	prev_oe;
	reg	prev_d;

	time    dlastev ;
	time    clklastev;
	time    clklastev_2;

initial
begin
	q_ts = 1'b0; q_th = 1'b0; q_tw = 1'b0;

	dlastev = 0; clklastev = 0; clklastev = 0;
	qfb = 1'b1;
end

always @( d or posedge clk )
    begin
	// setup violation check
	if( prev_clk !== clk && clk == 1'b1)
	begin
	    if( $time != 0 && (($time - dlastev) < Ts))
	    begin
		$display ("\n%m");
		$display(" Setup ERROR ON D: Setting output to unknown");
		q_ts = 1'b1;
		#1 q_ts = 1'b0;
	    end
	clklastev = $time;
	end
	if( prev_d !== d)
	begin
	    if( $time != 0 && (($time - clklastev) < Th))
	    begin
		$display ("\n%m");
		$display(" Hold ERROR ON D: Setting output to unknown");
		q_th = 1'b1;
		#1 q_th = 1'b0;
	    end
	dlastev = $time;
	end
    end 

always @( clk )
    begin
	if( $time != 0 && (($time - clklastev_2) < Tw))
	begin
	    $display ("\n%m");
	    $display("Pulse Width ERROR on CLK: Setting output to unknown");
	    q_tw = 1'b1;
	    #1 q_tw = 1'b0;
	end
	clklastev_2 = $time;
	#0 prev_clk = clk;
    end 


always @( clk or q_ts or q_th or q_tw) 
    begin
	 if( (q_ts == 1'b1) || (q_th == 1'b1) || (q_tw == 1'b1) ) 
	 begin
	     #Tco q   = 1'bx;
	     #Tco qfb = 1'bx;
	 end
	 else if( prev_clk !== clk && clk == 1'b1)
	 begin
	     q   <= #Tco  d;
	     qfb <= #Tco ~d;
	 end
    end

always @( oe or q)
	if( prev_oe !== oe)
	begin
	    if( oe == 1'b0)
		if( q == 1'b1)
		    #Tpzx y = 1'b0;
		else if( q == 1'b0)
		    #Tpzx y = 1'b1;
		else
		    #Tpzx y = 1'bx;
	    else
		#Tpxz y = 1'bz;
	    #0 prev_oe = oe;
	end
	else
	    if( oe == 1'b0)
		if( q == 1'b1)
		    y = 1'b0;
		else if( q == 1'b0)
		    y = 1'b1;
		else
		    y = 1'bx;
	    else
		y = 1'bz;

endmodule


`timescale 1ps/1ps

module c20ra10m ( d, clk, oe, pl, as, ar, y, yfb); 
input d;   // D input to register.
input clk; // Positive edge clock
input oe;  // Output Enable.
input pl;  // Preload (Synchronous --  Active Low.)
input as;  // Asynchronous Set (chip wide).
input ar;  // Asynchronous Reset (chip wide)
inout y;   // IO pin
output yfb;  // Bit To Array (is output from macro cell)

	// Default: INVerTed
parameter ibr = `invt;
	  
	// default timing parameters  C20ra10-15
parameter Tpd = 15000, Tpzx = 12000, Tpxz = 12000, Tco = 15000, Tsu = 7000, 
          Th = 3000, Twh = 10000, Twl = 10000, Ts = 15000, Tr = 15000, Tarw = 15000,
          Tasw = 15000, Tar = 10000, Twp = 15000, Tsup = 15000, Thp = 15000; 

	reg	q_tsu	;
	reg	q_th	;
	reg	q_twh	;
	reg	q_twl	;
	reg	q_tarw	;
	reg	q_tasw	;
	reg	q_tar	;
	reg	q_twp	;
	reg	q_tsup 	;
	reg 	q_thp	;

	reg	prev_clk;
	reg	prev_d_mod;
	reg	prev_pl;
	reg	prev_y;
	reg	prev_ar, prev_as;
	time	oepedge;
	time	oenedge;

	time	d_modlastev ;
	time	clklastev, clklastev_2;
	time	pllastev, pllastev_2;
	time	ylastev;

	time	arlastev, arlastev_2;
	time	aslastev, aslastev_2;

reg q;
initial
begin
    if (ibr == `invt)
	q = ~d;
    else
	q =  d;
end

wire d_mod;

reg yfb;
reg ytemp;
initial
begin
    if (oe == 1'b1)
	ytemp = ~q;
    else
	ytemp = 1'bz;

    yfb = ytemp;
end

wire y = ytemp;

initial
begin

	q_tsu = 1'b0; q_th = 1'b0; q_twh = 1'b0;
	q_twl = 1'b0; q_tarw = 1'b0; q_tasw = 1'b0;
	q_tar = 1'b0; q_twp = 1'b0;
	q_tsup = 1'b0; q_thp = 1'b0;

	d_modlastev = 0; clklastev = 0; clklastev_2 = 0;
	pllastev = 0; ylastev = 0;
	pllastev_2 = 0;
	arlastev = 0; aslastev = 0;
	arlastev_2 = 0; aslastev_2 = 0;
	prev_clk = clk; prev_d_mod = d_mod; prev_pl = pl; prev_y = y;
	prev_ar = ar; prev_as = as;
end


always @(d_mod) #0 prev_d_mod = d_mod;

always @( d_mod or posedge clk )
    begin
	// 
	if( (as == 1'b0) && (ar == 1'b0) && (pl == 1'b1))
	begin
	    if( prev_clk !== clk && clk == 1'b1)
	    begin
		// setup violation check
		if( $time != 0 && (($time - d_modlastev) < Tsu))
		begin
		    $display ("\n%m");
		    $display(" Setup ERROR ON D: Setting output unknown");
		    q_tsu = 1'b1;
		    #1 q_tsu = 1'b0;
		end
		clklastev = $time;
	    end
	    if( prev_d_mod !== d_mod)
	    begin
		if( $time != 0 && (($time - clklastev) < Th))
		begin
		    $display ("\n%m");
		    $display(" Hold ERROR ON D: Setting output unknown");
		    q_th = 1'b1;
		    #1 q_th = 1'b0;
		end
		d_modlastev = $time;
	    end
	end
    end 


always @(y) #0 prev_y = y;
always @(pl) #0 prev_pl = pl;

always @(y or pl)
    begin
	// 
	if( (as == 1'b0) && (ar == 1'b0) && (pl == 1'b0))
	begin
	    if( prev_pl !== pl && pl == 1'b0)
	    begin
		// setup violation check
		if( $time != 0 && (($time - ylastev) < Tsup))
		begin
		    $display ("\n%m");
		    $display(" Setup ERROR ON Y: Setting output unknown");
		    q_tsup = 1'b1;
		    #1 q_tsup = 1'b0;
		end
		pllastev = $time;
	    end
	    if( prev_y !== y)
	    begin
		if( $time != 0 && (($time - pllastev) < Thp))
		begin
		    $display ("\n%m");
		    $display(" Hold ERROR ON Y: Setting output unknown");
		    q_thp = 1'b1;
		    #1 q_thp = 1'b0;
		end
		ylastev = $time;
	    end
	end
    end 


always @( as or ar )
    begin
	if( prev_as !== as)
	    aslastev = $time;
	if( as == 1'b0)
	begin
	    if( prev_ar !== ar && ar == 1'b0)
	    begin
	    if( $time != 0 && (($time - aslastev) < Tar))
		begin
		    $display ("\n%m");
		    $display("Recovery ERROR on AS against AR: Setting output unknown");
		    q_tar = 1'b1;
		    #1 q_tar = 1'b0;
		    arlastev = $time;
		end
	    end
	end
    end 

always @( clk )
    begin
	if( clk == 1'b0 )
	begin
	     // H violation
	     if( $time != 0 && (($time - clklastev_2) < Twh))
	     begin
		  $display ("\n%m");
		  $display("Pulse Width (H) ERROR on CLK: Setting output unknown");
		  q_twh = 1'b1;
		  #1 q_twh = 1'b0;
	     end
	end
	else if( clk == 1'b1)
	begin
		  // L violation
	     if( $time != 0 && (($time - clklastev_2) < Twl))
	     begin
		$display ("\n%m");
		$display("Pulse Width (L) ERROR on CLK: Setting output unknown");
		q_twl = 1'b1;
		#1 q_twl = 1'b0;
	     end
	end
	clklastev_2 = $time;
	#0 prev_clk = clk;
    end 

always @( ar )
    begin
	if( ar == 1'b0) 
	begin
	    if( $time != 0 && (($time - arlastev_2) < Tarw))
	    begin
		 $display ("\n%m");
		 $display("Pulse Width ERROR on AR: Setting output unknown");
		 q_tarw = 1'b1;
		 #1 q_tarw = 1'b0;
	    end
	end
	arlastev_2 = $time;
	#0 prev_ar = ar;
    end 

always @( as )
    begin
	if( as == 1'b0) 
	begin
	    if( $time != 0 && (($time - aslastev_2) < Tasw))
	    begin
		 $display ("\n%m");
		 $display("Pulse Width ERROR on AS: Setting output unknown");
		 q_tasw = 1'b1;
		 #1 q_tasw = 1'b0;
	    end
	end
	aslastev_2 = $time;
	#0 prev_as = as;
    end 

always @( pl )
    begin
	if( pl == 1'b0) 
	begin
	    if( $time != 0 && (($time - pllastev_2) < Twp))
	    begin
		 $display ("\n%m");
		 $display("Pulse Width ERROR on PL: Setting output unknown");
		 q_twp = 1'b1;
		 #1 q_twp = 1'b0;
	    end
	end
	pllastev_2 = $time;
    end 

assign d_mod = (ibr == `invt) ? ~d : d ;


always @( d_mod or clk or ar or as or q_tsu or q_th or q_twh or q_twl or q_tarw or q_tasw or q_tar or q_twp or q_tsup or q_thp)
    begin
	 if( (q_tsu == 1'b1) || (q_th == 1'b1) || (q_twh == 1'b1) || (q_twl == 1'b1) || (q_tarw == 1'b1) || (q_tasw == 1'b1) || (q_tar == 1'b1) || (q_twp == 1'b1) || (q_tsup == 1'b1) || (q_thp == 1'b1))

		 #Tco q = 1'bx;
	  else if( (ar == 1'b1) && (as == 1'b1))
	         #Tpd q = d_mod;
	  else if( ar == 1'b1)
		 #Tr q = 1'b0;
          else if( as == 1'b1)
                 #Ts q = 1'b1;
	  else if( prev_clk !== clk && clk == 1'b1)
	  begin
	    if( pl == 1'b0)
	    begin
		if( y == 1'b1)
		    q <= #Tco 1'b0;
		else
		    q <= #Tco 1'b1;
	    end    
	    else
		q <= #Tco d_mod;
	  end
    end


always @(posedge oe) oepedge = $time;
always @(negedge oe) oenedge = $time;

always @(oe or q)
	if      (oepedge == $time)
	    #Tpzx ytemp = ~q;
	else if (oenedge == $time)
	    #Tpxz ytemp = 1'bz;
	else if (oe == 1'b1)      
	    ytemp = ~q;
	else
	    ytemp = 1'bz;


always @( y )
	if( y == 1'b1)
	    yfb = 1'b1;
	else
	    yfb = 1'b0;

endmodule


`timescale 1ps/1ps

module c20tri ( x, oe, y);
input x, oe;
output y;

reg y;

parameter Tpd = 25000, Tea = 25000, Ter = 25000, Tpzx = 20000, Tpxz = 20000, 
          Tco = 15000, Ts = 20000, Th = 0, Tw = 15000; 
reg prev_oe;

always @(oe) #0 prev_oe = oe;
always @( oe or x)
	if( prev_oe !== oe)
	    if( oe == 1'b1)
		if( x == 1'b1)
		    y <= #Tea 1'b0;
	        else
		    y <= #Tea 1'b1;
	    else
		y <= #Ter 1'bz;
	else
	    if( oe == 1'b1)
		if( x == 1'b1)
	            y <= #Tpd 1'b0;
	        else
		    y <= #Tpd 1'b1;
	    else
		y <= 1'bz;
endmodule



`timescale 1ps/1ps

module c22v10m (d, clk, oe, ss, ar, y, fb); // Device C22V10C macro cell
input d, clk, oe, ss, ar;
inout y;
output fb;

	// Default: REGistered, INVerTed, Registerd
parameter registered = `regi, inv_setting = `invt,
	  bta_sel = `xreg;
	// default timing parameters  PALC22V10C-10 
parameter Tpd = 10000, Tea = 10000, Ter = 10000, Tco = 7500, Ts = 3600,
          Th = 0, Twh = 3000, Twl = 3000, Tcf = 6400, Taw = 10000,
          Tar = 6000,  Tap = 12000, Tspr = 6000;

	reg	q_ts	;
	reg	q_th	;
	reg	q_twh	;
	reg	q_twl	;
	reg	q_tar	;
	reg	q_ss	;
	reg	q_tspr	;
	reg	q_taw	;
	reg	prev_clk;
	reg	prev_d;
	reg	prev_oe;
	reg	prev_ar;
	reg	prev_ss;

	time    dlastev ;
	time    clklastev;
	time    arlastev,arlastev_2;
	time    sslastev;

initial
begin
	q_ts = 1'b0; q_th = 1'b0; q_twh = 1'b0;
	q_twl = 1'b0; q_tar = 1'b0; q_ss = 1'b0;
	q_tspr = 1'b0; q_taw = 1'b0;
	dlastev = 0; clklastev = 0;
	arlastev = 0; sslastev = 0; arlastev_2 = 0;
	prev_clk = clk; prev_d = d; prev_oe = 1'b1; prev_ar = ar; prev_ss = ss;
end

always @(d) #0 prev_d = d;
always @(d or posedge clk)
    begin
	// Check only if the cell is registered.
	if (registered == `regi)
	    begin
		if (prev_clk !== clk && clk == 1'b1)
		begin
		// setup violation check
		    if ($time != 0 && (($time - dlastev) < Ts))
		    begin
			$display ("\n%m");
			$display("Setup ERROR ON D: Setting output to unknown");
			q_ts = 1'b1;
			q_ts <= #1 1'b0;
		    end
		    clklastev <= $time;
		end
		if (prev_d !== d)
		begin
		    if ($time != 0 && (($time - clklastev) < Th))
		    begin
			$display ("\n%m");
			$display("Hold ERROR ON D: Setting output to unknown");
			q_th = 1'b1;
			q_th <= #1 1'b0;
		    end
		    dlastev <= $time;
		end
	    end
    end 

always @(ar or clk)
    begin
	// Check only if the cell is registered.
	if (registered == `regi)
	begin
	    if (prev_ar !== ar) arlastev = $time;
	    if (ar == 1'b0 && prev_clk !== clk && clk == 1'b1)
	    begin
		// setup violation check
		if ($time != 0 && (($time - arlastev) < Tar))
		begin
		    $display ("\n%m");
		    $display("Recovery ERROR on AR: Setting output to unknown");
		    q_tar = 1'b1;
		    q_tar <= #1 1'b0;
		end
		clklastev <= $time;
	    end
	end
    end 

always @(ss) #0 prev_ss = ss;
always @(ss or clk)
    begin
	// Check only if the cell is registered.
	if (registered == `regi)
	begin
	    if (prev_ss !== ss) sslastev = $time;
	    if (ss == 1'b0 && prev_clk !== clk && clk == 1'b1)
	    begin
		    // setup violation check
		if ($time != 0 && (($time - sslastev) < Tspr))
		begin
		    $display ("\n%m");
		    $display("Recovery ERROR on SS: Setting output to unknown");
		    q_tspr = 1'b1;
		    q_tspr <= #1 1'b0;
		end
		clklastev <= $time;
	    end
	end
    end 

always @(clk)
    begin
	// Check only if the cell is registered.
	if (registered == `regi)
	begin
	    if (clk == 1'b0)
	    begin
			  // H violation
		if ($time != 0 && (($time - clklastev) < Twh))
		begin
		    $display ("\n%m");
		    $display("Pulse Width (H) ERROR on CLK: Setting output to unknown");
		    q_twh = 1'b1;
		    q_twh <= #1 1'b0;
		end
	    end
	    else if (clk == 1'b1)
	    begin
		  // L violation
		if ($time != 0 && (($time - clklastev) < Twl))
		begin
		    $display ("\n%m");
		    $display("Pulse Width (L) ERROR on CLK: Setting output to unknown");
		    q_twl = 1'b1;
		    q_twl <= #1 1'b0;
		end
	    end
	    clklastev <= $time;
	end
	#0 prev_clk = clk;
    end 

always @(ar)
    begin
	// Check only if the cell is registered.
	if (registered == `regi)
	begin
	    if (clk == 1'b0)
	    begin
			  // AW violation
		if ($time != 0 && (($time - arlastev_2) < Taw))
		begin
		    $display ("\n%m");
		    $display("Pulse Width ERROR on AR: Setting output to unknown");
		    q_taw = 1'b1;
		    q_taw <= #1 1'b0;
		end
	    end
	end
	arlastev_2 <= $time;
	#0 prev_ar = ar;
    end 


wire errflg = (q_ts || q_th || q_twh || q_twl ||
		q_taw || q_tar || q_tspr || q_ss);
reg q;
reg q_not;
initial q <= 1'b0;
initial q_not <= 1'b0;
always @(clk or ar or ss or errflg)
begin
    case (errflg)
	0 : case (ar)
		0 : case (prev_clk !== clk && clk == 1'b1)
			0 :;
			1 : case (ss)
				0 : begin
					q <= #Tco d;
					case (d)
					    0 : q_not <= #Tcf 1'b1;
					    1 : q_not <= #Tcf 1'b0;
					endcase
				    end
				1 : begin
					q <= #Tco 1'b1;
					q_not <= #Tcf 1'b0;
				    end
			    endcase
		    endcase
		1 : begin
			q <= #Tap 1'b0;
			q_not <= #Tcf 1'b1;
		    end
	    endcase
	1 : begin
		q <= #Tco 1'bx;
		q_not <= #Tcf 1'bx;
	    end
    endcase
end


reg d_mod;
initial d_mod <= 1'b0;
always @(d or q)
begin
    case (registered)
	`comb : d_mod <= #Tpd d;
	`regi : d_mod <= q;
    endcase
end


reg d_pol;
initial d_pol <= 1'b0;
always @(d_mod)
begin
    case (inv_setting)
	`ninv : d_pol <= ~d_mod;
	`invt : d_pol <=  d_mod;
    endcase
end


reg ytemp;
wire y = ytemp;
initial
begin
    if (oe == 1'b1)
	ytemp <= ~d_pol;
    else
	ytemp <= 1'bz;
end

always @(oe) prev_oe = oe;

always @(oe or d_pol or y)
begin
    case (prev_oe === oe)
	0 : case (oe)
		0 : ytemp <= #Ter 1'bz;
		1 : ytemp <= #Tea ~d_pol;
	    endcase
	1 : case (oe)
		0 : ytemp <= 1'bz;
		1 : ytemp <= ~d_pol;
	    endcase
    endcase
end


reg fb;
initial fb <= 1'b0;
always @(y or q_not)
begin
    case (bta_sel)
	`xpin : case (y)
		    0 : fb <= 1'b0;
		    1 : fb <= 1'b1;
		endcase
	`xreg : fb <= q_not;
    endcase
end

endmodule


`timescale 1ps/1ps

module c331ckmx(clksrc, clk); 

input clksrc;
output clk;

reg clk;

parameter		// Defaults to CY7C331-20
	Tpd   = 20000,
	Tico  = 35000,
	Tioh  = 5000,
	Tis   = 2000,
	Tih   = 11000,
	Tiar  = 35000,
	Tirw  = 35000,
	Tirr  = 35000,
	Tias  = 35000,
	Tisw  = 35000,
	Tisr  = 35000,
	Twh   = 12000,
	Twl   = 12000,
	Tco   = 20000,
	Ts    = 12000,
	Th    = 8000,
	Toar  = 20000,
	Torw  = 20000,
	Torr  = 20000,
	Toas  = 20000,
	Tosw  = 20000,
	Tosr  = 20000,
	Tpzx  = 20000,
	Tpxz  = 20000;

	reg clksrc_twh;
	reg clksrc_twl;
	time clksrclastev;

initial
begin
	clksrc_twh = 0;
	clksrc_twl = 0;
	clksrclastev = 0;
end


always @(clksrc)
    begin
	if (clksrc == 1'b0)
	begin
	     // H violation
	     if ($time != 0 && (($time - clksrclastev) < Twh))
	     begin
		  $display ("\n%m");
		  $display("Pulse Width (H) ERROR on CLKSRC: Setting output to unknown");
		  clksrc_twh = 1'b1;
		  clksrc_twh <= #1 1'b0;
	     end
	end
	else if (clksrc == 1'b1)
	begin
		  // L violation
	     if ($time != 0 && (($time - clksrclastev) < Twl))
	     begin
		$display ("\n%m");
		$display("Pulse Width (L) ERROR on CLKSRC: Setting output to unknown");
		clksrc_twl = 1'b1;
		clksrc_twl <= #1 1'b0;
	     end
	end
	else
	    begin
	    end
	#0 clksrclastev = $time;
    end 

always @(clksrc or clksrc_twh or clksrc_twl)
    begin
	if ((clksrc_twh == 1'b1) || (clksrc_twl == 1'b1))
	    clk <= 1'bx;
	else
	    clk <= clksrc;
    end

endmodule


`timescale 1ps/1ps

module c331m (x1, x2, clk, iclk, oe, as, ar, ias, iar, qfb, y, qifb);

input x1;
input x2;
input clk;
input iclk;
input oe;
input as;
input ar;
input ias;
input iar;
inout y;
output qfb;
output qifb;

parameter		// Defaults to CY7C331-20
	Tpd   = 20000,
	Tico  = 35000,
	Tioh  = 5000,
	Tis   = 2000,
	Tih   = 11000,
	Tiar  = 35000,
	Tirw  = 35000,
	Tirr  = 35000,
	Tias  = 35000,
	Tisw  = 35000,
	Tisr  = 35000,
	Twh   = 12000,
	Twl   = 12000,
	Tco   = 20000,
	Ts    = 12000,
	Th    = 8000,
	Toar  = 20000,
	Torw  = 20000,
	Torr  = 20000,
	Toas  = 20000,
	Tosw  = 20000,
	Tosr  = 20000,
	Tpzx  = 20000,
	Tpxz  = 20000;

	reg	iregq_tis;
	reg	iregq_tih;
	reg	iregq_tirw;
	reg	iregq_tirr;
	reg	iregq_tisw;
	reg	iregq_tisr;
	reg	iregq_twh;
	reg	iregq_twl;
	reg	q_twh;
	reg	q_twl;
	reg	q_ts;
	reg	q_th;
	reg	q_torw;
	reg	q_torr;
	reg	q_tosw;
	reg	q_tosr;
	reg	q_tpzx;
	reg	q_tpxz;

	reg     prev_clk, prev_x1, prev_x2;
	reg     prev_ar, prev_as, prev_iar, prev_ias;
	reg     prev_y, prev_iclk;
	reg     prev_oe;

	time 	xlastev;
	time 	clklastev, clklastev_2;
	time	ylastev;
	time	iclklastev, iclklastev_2;
	time	arlastev, arlastev_2;
	time	aslastev, aslastev_2;
	time	iarlastev, iarlastev_2;
	time	iaslastev, iaslastev_2;

reg ytemp;
initial
begin
    if (oe == 1'b1)
	ytemp <= ~(x1 ^ x2);
    else
	ytemp <= 1'bz;
end

wire y = ytemp;

initial
    begin
	iregq_tis = 1'b0; iregq_tih = 1'b0; iregq_tirw = 1'b0; iregq_tirr = 1'b0;
	iregq_tisw = 1'b0; iregq_tisr = 1'b0; iregq_twh = 1'b0; iregq_twl = 1'b0;
	q_twh = 1'b0; q_twl = 1'b0; q_ts = 1'b0; q_th = 1'b0; q_torw = 1'b0; q_torr = 1'b0;
	q_tosw = 1'b0; q_tosr = 1'b0; q_tpzx  = 1'b0; q_tpxz = 1'b0;

	xlastev = 0; clklastev = 0; clklastev_2 = 0; ylastev = 0;
	iclklastev = 0; iclklastev_2 = 0;
	arlastev = 0; aslastev = 0; iarlastev = 0; iaslastev = 0;
	arlastev_2 = 0; aslastev_2 = 0; iarlastev_2 = 0; iaslastev_2 = 0;
	prev_clk = clk; prev_x1 = x1; prev_x2 = x2; prev_ar = ar; prev_as = as;
	prev_iar = iar; prev_ias = ias; prev_iclk = iclk;
	prev_oe = oe; prev_y = y;
    end

always @(x1 or x2 or posedge clk)
    begin
	// only check constraints if as and ar are not enabled
	if ((as == 1'b0) && (ar == 1'b0))
	    begin
               if (prev_clk !== clk && clk == 1'b1)
               begin
	           if (($time != 0 && (($time - xlastev) < Ts)))
                     begin
			$display ("\n%m");
			$display("Setup ERROR on X: Setting output Unknown");
                        q_ts = 1'b1;
                        q_ts <= #1 1'b0;
		     end
	           #0 clklastev = $time;
               end
               if (prev_x1 !== x1 || prev_x2 !== x2)
               begin
	          if (($time != 0 && (($time - clklastev) < Th)))
                  begin
		     $display ("\n%m");
		     $display("Hold ERROR ON X: Setting output unknown");
                     q_th = 1'b1;
                     q_th <= #1 1'b0;
	          end
	          #0 xlastev = $time;
               end
	    end
    end

always @(x1) #0 prev_x1 = x1;
always @(x2) #0 prev_x2 = x2;


always @(y) #0 prev_y = y;
always @(y or posedge iclk)
    begin
	// if iar, ias are disabled
	if ((ias == 1'b0) && (iar == 1'b0))
	    begin
                if (prev_iclk !== iclk && iclk == 1'b1)
                  begin
		// setup violation check
		    if ($time != 0 && (($time - ylastev) < Tis))
		    begin
			$display ("\n%m");
			$display(" Setup ERROR ON Y: Setting output unknown");
			iregq_tis = 1'b1;
			iregq_tis <= #1 1'b0;
		    end
		    #0 iclklastev = $time;
                  end
                if (prev_y !== y)
                  begin
	             if ($time != 0 && (($time - iclklastev) < Tih))
	             begin
			 $display ("\n%m");
		         $display(" Hold ERROR ON Y: Setting output unknown");
		         iregq_tih = 1'b1;
		         iregq_tih <= #1 1'b0;
	             end
	             #0 ylastev = $time;
                  end
	    end
    end 


always @(clk)
    begin
	// Only check constraints when as & ar are disabled
	if (as == 1'b0 && ar == 1'b0)
	begin
	    if (clk == 1'b0)
	    begin
		  if ($time != 0 && ($time - clklastev_2) < Twh)
		  begin
		      $display ("\n%m");
		      $display("Pulse Width (H) ERROR on CLK: Setting output unknown");
		      q_twh = 1'b1;
		      q_twh <= #1 1'b0;
		  end
	    end
	    else if (clk == 1'b1)
		  begin
		      if ($time != 0 && ($time - clklastev_2) < Twl)
		      begin
			  $display ("\n%m");
			  $display("Pulse Width (L) ERROR on CLK: Setting output unknown");
			  q_twl = 1'b1;
			  q_twl <= #1 1'b0;
		      end
		  end
	end
	#0 clklastev_2 = $time;
        #0 prev_clk = clk;
    end


always @(iclk)
    begin
	// Only check constraints when ias & iar are disabled
	if (ias == 1'b0 && iar == 1'b0)
	begin
	    if (iclk == 1'b0)
	    begin
		  if ($time != 0 && ($time - iclklastev_2) < Twh)
		  begin
		      $display ("\n%m");
		      $display("Pulse Width (H) ERROR on ICLK: Setting output unknown");
		      iregq_twh = 1'b1;
		      iregq_twh <= #1 1'b0;
		  end
	    end
	    else if (iclk == 1'b1)
		  begin
		      if ($time != 0 && ($time - iclklastev_2) < Twl)
		      begin
			  $display ("\n%m");
			  $display("Pulse Width (L) ERROR on ICLK: Setting output unknown");
			  iregq_twl = 1'b1;
			  iregq_twl <= #1 1'b0;
		      end
		  end
	end
	iclklastev_2 = $time;
        #0 prev_iclk = iclk;
    end


always @(ar or posedge clk)
    begin
	if (prev_ar !== ar) arlastev = $time;
	if (ar == 1'b0)
	    begin
		if ((prev_clk !== clk && clk == 1'b1) && ($time != 0) && (($time - arlastev) < Torr))
		    begin
			$display ("\n%m");
			$display("Recovery ERROR on AR: Setting output unknown");
			q_torr = 1'b1;
			q_torr <= #1 1'b0;
		    end
	    end
    end 


always @(as or posedge clk)
    begin
	if (prev_as !== as) aslastev = $time;
	if (as == 1'b0)
	    begin
		if ((prev_clk !== clk && clk == 1'b1) && ($time != 0) && (($time - aslastev) < Tosr))
		    begin
			$display ("\n%m");
			$display("Recovery ERROR on AS: Setting output unknown");
			q_tosr = 1'b1;
			q_tosr <= #1 1'b0;
		    end
	    end
    end 


always @(iar or posedge iclk)
    begin
	if (prev_iar !== iar) iarlastev = $time;
	if (iar == 1'b0)
	    begin
		if ((prev_iclk !== iclk && iclk == 1'b1) && ($time != 0) && (($time - iarlastev) < Tirr))
		    begin
			$display ("\n%m");
			$display("Recovery ERROR on IAR: Setting output unknown");
			iregq_tirr = 1'b1;
			iregq_tirr <= #1 1'b0;
		    end
	    end
    end 


always @(ias or posedge iclk)
    begin
	if (prev_ias !== ias) iaslastev = $time;
	if (ias == 1'b0)
	    begin
		if ((prev_iclk !== iclk && iclk == 1'b1) && ($time != 0) && (($time - iaslastev) < Tisr))
		    begin
			$display ("\n%m");
			$display("Recovery ERROR on IAS: Setting output unknown");
			iregq_tisr = 1'b1;
			iregq_tisr <= #1 1'b0;
		    end
	    end
    end 


always @(ar)
    begin
	if (clk == 1'b0)
	begin
	    if ($time != 0 && (($time - arlastev_2) < Torw))
		begin
			$display ("\n%m");
			$display("Pulse Width ERROR on AR: Setting output unknown");
			q_torw = 1'b1;
			q_torw <= #1 1'b0;
		end
	end
	#0 arlastev_2 = $time;
        #0 prev_ar = ar;
    end 


always @(as)
    begin
	if (clk == 1'b0)
	begin
	    if ($time != 0 && (($time - aslastev_2) < Tosw))
		begin
			$display ("\n%m");
			$display("Pulse Width ERROR on AS: Setting output unknown");
			q_tosw = 1'b1;
			q_tosw <= #1 1'b0;
		end
	end
	#0 aslastev_2 = $time;
        #0 prev_as = as;
    end 


always @(iar)
    begin
	if (iclk == 1'b0)
	begin
	    if ($time != 0 && (($time - iarlastev_2) < Tirw))
		begin
			$display ("\n%m");
			$display("Pulse Width ERROR on IAR: Setting output unknown");
			iregq_tirw = 1'b1;
			iregq_tirw <= #1 1'b0;
		end
	end
	#0 iarlastev_2 = $time;
        #0 prev_iar = iar;
    end 


always @(ias)
    begin
	if (iclk == 1'b0)
	begin
	    if ($time != 0 && (($time - iaslastev_2) < Tisw))
		begin
			$display ("\n%m");
			$display("Pulse Width ERROR on IAS: Setting output unknown");
			iregq_tisw = 1'b1;
			iregq_tisw <= #1 1'b0;
		end
	end
	#0 iaslastev_2 = $time;
        #0 prev_ias = ias;
    end 


reg q;

always @(clk or ar or as or q_ts or q_th or q_twh or q_twl or q_tosw or q_torw or q_tosr or q_torr or x1 or x2)

    begin
	if ((q_ts == 1'b1) || (q_th == 1'b1) || (q_twh == 1'b1) || (q_twl == 1'b1) ||
	(q_tosw == 1'b1) || (q_torw == 1'b1) || (q_tosr == 1'b1) || (q_torr == 1'b1))
		q <= #Tco 1'bx;
	else if (ar == 1'b1 && as == 1'b1)
	    q <= #Tpd (x1 ^ x2);
	else if (ar == 1'b1)
		q <= #Toar 1'b0;
	else if (as == 1'b1)
		q <= #Toas 1'b1;
	else if ((prev_clk !== clk && clk == 1'b1))
		q <= #Tco (x1 ^ x2);
    end


reg qfb;
initial qfb <= 1'b0;
always @(q)
    begin
	qfb <= ~q;
    end

always @(oe) #0 prev_oe = oe;

always @(q or oe)
    begin
	if (oe == 1'b1)
        begin
            if (prev_oe !== oe)
	        ytemp <= #Tpzx ~q;
            else 
                ytemp <= ~q;
        end
	else
        begin
            if (prev_oe !== oe)
	        ytemp <= #Tpxz 1'bz;
            else
                ytemp <= 1'bz;                
        end
    end


reg qifb;
initial qifb <= 1'b0;
always @(iclk or iar or ias or y or iregq_tis or iregq_tih or iregq_twh or
	iregq_twl or iregq_tisw or iregq_tirw or iregq_tisr or iregq_tirr)
    begin
	if ((iregq_tis == 1'b1) || (iregq_tih == 1'b1) || (iregq_twh == 1'b1)
	|| (iregq_twl == 1'b1) || (iregq_tisw == 1'b1) || (iregq_tirw == 1'b1)
	|| (iregq_tisr == 1'b1) || (iregq_tirr == 1'b1))
	begin
		qifb <= #(Tico-Tpd) 1'bx;
	end
	else if (iar == 1'b1 && ias == 1'b1)
	begin
	    if (y == 1'b1) 
	        qifb <= 1'b1;
	    else
		qifb <= 1'b0;
	end
	else if (iar == 1'b1)
	begin
		qifb <= #Tiar 1'b0;
	end
	else if (ias == 1'b1)
	begin
		qifb <= #Tias 1'b1;
	end
	else if (prev_iclk !== iclk && iclk == 1'b1)
	begin
            if (y == 1'b1)
		qifb <= #(Tico - Tpd) 1'b1; 
            else
                qifb <= #(Tico - Tpd) 1'b0;
	end
    end

endmodule

 
`timescale 1ps/1ps

module c335ckmx( clksrc, clk ) ;
 
input clksrc ;
output clk ;
 
reg clk ;
 
parameter               // Defaults to CY7C33
	Tpd = 15000,
	Twh = 5000,
	Twl = 5000,
	Tis = 2000,
	Tih = 2000,
	Tico = 18000,
	Tpzx = 12000,
	Tpxz = 12000,
	Ts   = 9000,
	Th   = 0,
	Tco  = 10000,
	Tco2 = 18000 ;

 
        reg clksrc_twh ;
        reg clksrc_twl ;
        time clksrclastev ;
 
initial
begin
        clksrc_twh = 0 ;
        clksrc_twl = 0 ;
        clksrclastev = 0 ;
end


always @( clksrc )
    begin
        if( clksrc == 1'b0 )
        begin
             // H violation
             if( $time != 0 && (($time - clksrclastev) < Twh))
             begin
		  $display ("\n%m");
                  $display("Pulse Width (H) ERROR on CLKSRC: Setting output to unknown") ;
                  clksrc_twh = 1'b1 ;
                  clksrc_twh <= #1 1'b0 ;
             end
        end
        else if( clksrc == 1'b1)
        begin
                  // L violation
             if( $time != 0 && (($time - clksrclastev) < Twl))
             begin
		$display ("\n%m");
                $display("Pulse Width (L) ERROR on CLKSRC: Setting output to unknown") ;
                clksrc_twl = 1'b1 ;
                clksrc_twl <= #1 1'b0 ;
             end
        end
        else
            begin
            end
        clksrclastev <= $time ;
    end

always @(clksrc or clksrc_twh or clksrc_twl)
    begin
        if( (clksrc_twh == 1'b1) || (clksrc_twl == 1'b1))
            clk <= 1'bx ;
        else
            clk <= clksrc ;
    end

endmodule



`timescale 1ps/1ps

module c335h( x1, x2, clk, ss, sr, qfb);

input x1;
input x2;
input clk;
input ss;
input sr;
output qfb;

reg qfb;

parameter               // Defaults to CY7C33
	Tpd = 15000,
	Twh = 5000,
	Twl = 5000,
	Tis = 2000,
	Tih = 2000,
	Tico = 18000,
	Tpzx = 12000,
	Tpxz = 12000,
	Ts   = 9000,
	Th   = 0,
	Tco  = 10000,
	Tco2 = 18000;

	reg q_ts;
	reg q_th;
	reg q_twh;
	reg q_twl;
	reg q_setreset;
	reg prev_clk, prev_x1, prev_x2;
	
	time xlastev;
	time clklastev, clklastev_2;

initial
    begin
	q_ts = 1'b0; q_th = 1'b0; q_twh = 1'b0; q_twl = 1'b0; q_setreset = 1'b0;
	xlastev = 0; clklastev = 0; clklastev_2 = 0;
	prev_clk = clk; prev_x1 = x1; prev_x2 = x2;
    end 

always @(x1) #0 prev_x1 = x1;
always @(x2) #0 prev_x2 = x2;
always @( x1 or x2 or posedge clk)
    begin
	if( prev_clk !== clk && clk == 1'b1)
	begin
	   if( $time != 0 && (($time - xlastev ) < Ts))
           begin
	     $display ("\n%m");
             $display("Setup ERROR on X: Setting output to Unknown");
             q_ts = 1'b1;
             q_ts <= #1 1'b0;
           end
           clklastev = $time;
	end
	if( prev_x1 !== x1 || prev_x2 !== x2)
	begin
            if( $time != 0 && (($time - clklastev ) < Th))
            begin
		$display ("\n%m");
                $display("Hold ERROR ON X: Setting output to unknown");
                q_th = 1'b1;
                q_th <= #1 1'b0;
            end
            #0 xlastev = $time;
	end
    end


always @( clk)
    begin
            if( clk == 1'b0)
            begin
                  if( $time != 0 && ($time - clklastev_2) < Twh)
                  begin
		      $display ("\n%m");
                      $display("Pulse Width (H) ERROR on CLK: Setting output to unknown");
                      q_twh = 1'b1;
                      q_twh <= #1 1'b0;
                  end
            end
            else if( clk == 1'b1)
                  begin
                      if( $time != 0 && ($time - clklastev_2) < Twl)
                      begin
			  $display ("\n%m");
                          $display("Pulse Width (L) ERROR on CLK: Setting output to unknown");
                          q_twl = 1'b1;
                          q_twl <= #1 1'b0;
                      end
                  end
            #0 clklastev_2 = $time;
            #0 clklastev = $time;
	    #0 prev_clk = clk;
    end

always @(posedge clk)
    begin
	if( clk == 1'b1)
	begin
	    if( ss == 1'b1 && sr == 1'b1)
	    begin
		$display ("\n%m");
		$display("ERROR: Preset & Clear both Active: Setting outputs to unknown");
		q_setreset = 1'b1;
		q_setreset <= #1 1'b0;
	    end
	end
    end


always @(clk or  sr or  ss or  q_ts or  q_th or  q_twh or  q_twl or  q_setreset)
    begin
	if( (q_ts == 1'b1) || (q_th == 1'b1) || (q_twh == 1'b1) || (q_twl == 1'b1) || (q_setreset == 1'b1))
	begin
	    qfb <= #Tco 1'bx;
	end
	else if( prev_clk !== clk && clk == 1'b1)
	begin
	   if( sr == 1'b1)
	     qfb <= 1'b0;
	   else if( ss == 1'b1)
	     qfb <= 1'b1;
	   else
	     qfb <= #Tco ~( x1 ^ x2);
	end
    end

endmodule


`timescale 1ps/1ps

module c335ireg( d, iclk, fb);
input d;
input iclk;
output fb;

reg fb;

parameter               // Defaults to CY7C33
        iregister = `regi,
        Tpd = 15000,
        Twh = 5000,
        Twl = 5000,
        Tis = 2000,
        Tih = 2000,
        Tico = 18000,
        Tpzx = 12000,
        Tpxz = 12000,
        Ts   = 9000,
        Th   = 0,
        Tco  = 10000,
        Tco2 = 18000;

	reg iregq;
        reg iregq_ts;
        reg iregq_th;
        reg iregq_twh;
        reg iregq_twl;

	reg prev_d, prev_iclk;

	time dlastev;
        time iclklastev;
        time iclklastev_2;
 
initial
    begin
	iregq_ts = 1'b0; iregq_th = 1'b0; iregq_twh = 1'b0; iregq_twl = 1'b0;
	dlastev = 0; iclklastev = 0; iclklastev_2 = 0;
    end

always @(d) #0 prev_d = d;
always @( d or posedge iclk)
    begin
	if( iregister == `regi)
	begin
           if( prev_iclk !== iclk && iclk == 1'b1)
           begin
              if( $time != 0 && (($time - dlastev ) < Tis))
              begin
		 $display ("\n%m");
                 $display("Setup ERROR on D: Setting output to Unknown");
                 iregq_ts = 1'b1;
                 iregq_ts <= #1 1'b0;
              end
              iclklastev = $time;
           end
           if( prev_d !== d)
           begin
              if( $time != 0 && (($time - iclklastev ) < Tih))
              begin
		 $display ("\n%m");
                 $display("Hold ERROR ON D: Setting output to unknown");
                 iregq_th = 1'b1;
                 iregq_th <= #1 1'b0;
	      end
              dlastev = $time;
           end
	end
    end
 
 
always @( iclk)
    begin
	if( iregister == `regi)
	begin
            if( iclk == 1'b0)
            begin
                  if( $time != 0 && ($time - iclklastev_2) < Twh)
                  begin
		      $display ("\n%m");
                      $display("Pulse Width (H) ERROR on CLK: Setting output to unknown");
                      iregq_twh = 1'b1;
                      iregq_twh <= #1 1'b0;
                  end
            end
            else if( iclk == 1'b1)
                  begin
                      if( $time != 0 && ($time - iclklastev_2) < Twl)
                      begin
			  $display ("\n%m");
                          $display("Pulse Width (L) ERROR on CLK: Setting output to unknown");
                          iregq_twl = 1'b1;
                          iregq_twl <= #1 1'b0;
                      end
                  end
            #0 iclklastev_2 = $time;
            #0 iclklastev = $time;
        end
        #0 prev_iclk = iclk;
    end


always @( iclk or  iregq_ts or  iregq_th or  iregq_twh or  iregq_twl)
    begin
	if( (iregq_ts == 1'b1) || (iregq_th == 1'b1) || (iregq_twh == 1'b1) || (iregq_twl == 1'b1))
	    iregq <= #(Tico - Tpd) 1'bx; 
	else if( prev_iclk !== iclk && iclk == 1'b1)
	   begin
	     if( d == 1'b1)
	        iregq <= #(Tico - Tpd) 1'b1;
	     else
	        iregq <= #(Tico - Tpd) 1'b0;
           end
    end

always @(d or iregq)
    begin
	if( iregister == `regi)
	    fb <= iregq;
	else if( iregister == `comb)
	begin
	    if( d == 1'b1)
		fb <= 1'b1;
	    else
		fb <= 1'b0;
	end
    end

endmodule


`timescale 1ps/1ps

module c335m( x1, x2, clk, iclk, ss, sr, oe, qfb, fb, y);

input x1;
input x2;
input clk;
input iclk;
input ss;
input sr;
input oe;
inout y;
output qfb;
output fb;

reg ytemp;
initial
begin
    if (oe == 1'b1)
	ytemp <= ~(x1 ^ x2);
    else
	ytemp <= 1'bz;
end

wire y = ytemp;

parameter
	registered	= `regi ,
	bta_sel		= `xreg , 
        Tpd = 15000,
        Twh = 5000,
        Twl = 5000,
        Tis = 2000,
        Tih = 2000,
        Tico = 18000,
        Tpzx = 12000,
        Tpxz = 12000,
        Ts   = 9000,
        Th   = 0,
        Tco  = 10000,
        Tco2 = 18000;

        reg     q   ;
        reg     q_ts;
        reg     q_th;
	reg     q_twh;
	reg     q_twl;
	reg	iregq;
	reg	iregq_ts;
	reg	iregq_th;
	reg	iregq_twh;
	reg	iregq_twl;
	reg	q_setreset;
	reg	prev_clk, prev_x1, prev_x2;
	reg	prev_iclk, prev_y;
	reg	prev_oe;

	time	xlastev;
	time	clklastev, clklastev_2;
	time	ylastev;
	time	iclklastev, iclklastev_2;

initial
    begin
 
	q_ts = 1'b0;q_th = 1'b0; q_twh = 1'b0;q_twl = 1'b0; 
	iregq_twh = 1'b0;iregq_twl = 1'b0; iregq_ts = 1'b0; iregq_th = 1'b0;
	q_setreset = 1'b0;
	xlastev = 0; clklastev = 0; ylastev = 0; iclklastev = 0;
    end

always @(x1) #0 prev_x1 = x1;
always @(x2) #0 prev_x2 = x2;
always @( x1 or x2 or posedge clk)
    begin
        // only if registered
        if( registered == `regi) 
            begin
		if( prev_clk !== clk && clk == 1'b1)
		begin
                    if( $time != 0 && (($time - xlastev ) < Ts))
                    begin
			$display ("\n%m");
                        $display("Setup ERROR on X: Setting output to Unknown");
                        q_ts = 1'b1;
                        q_ts <= #1 1'b0;
                    end
		    clklastev = $time;
		end
		if( prev_x1 !== x1 || prev_x2 !== x2)
		begin
		   if( $time != 0 && (($time - clklastev ) < Th))
		   begin
		      $display ("\n%m");
		      $display("Hold ERROR ON X: Setting output to unknown");
		      q_th = 1'b1;
		      q_th <= #1 1'b0;
		   end
                   #0 xlastev = $time;
		end
            end
    end

always @(y) #0 prev_y = y;
always @( y or posedge iclk )
    begin
	if (bta_sel == `xreg)
	begin
	    if( prev_iclk !== iclk && iclk == 1'b1)
	    begin
                // setup violation check
                if( $time != 0 && (($time - ylastev) < Tis))
                    begin
			$display ("\n%m");
                        $display("Setup ERROR ON Y: Setting output to unknown");
                        iregq_ts = 1'b1;
                        iregq_ts <= #1 1'b0;
                    end
                iclklastev = $time;
            end
	    if( prev_y !== y)
	    begin
		if( $time != 0 && (($time - iclklastev) < Tih))
		begin
		   $display ("\n%m");
		   $display("Hold ERROR ON Y: Setting output to unknown");
		   iregq_th = 1'b1;
		   iregq_th <= #1 1'b0;
		end
	        #0 ylastev = $time;
            end
	end
    end

always @(clk)
    begin
	// only if the cell is registered.
	if (registered == `regi)
	begin
            if( clk == 1'b0)
            begin
                  if( $time != 0 && ($time - clklastev_2) < Twh)
                  begin
		      $display ("\n%m");
                      $display("Pulse Width (H) ERROR on CLK: Setting output to unknown");
                      q_twh = 1'b1;
                      q_twh <= #1 1'b0;
                  end
            end
            else if( clk == 1'b1)
                  begin
                      if( $time != 0 && ($time - clklastev_2) < Twl)
                      begin
			  $display ("\n%m");
                          $display("Pulse Width (L) ERROR on CLK: Setting output to unknown");
                          q_twl = 1'b1;
                          q_twl <= #1 1'b0;
                      end
                  end
            #0 clklastev_2 = $time;
            #0 clklastev = $time;
            #0 prev_clk = clk;
        end
    end

 
always @( iclk)
    begin
	if (bta_sel == `xreg)
	begin
	    if( iclk == 1'b0)
	    begin
		  if( $time != 0 && ($time - iclklastev_2) < Twh)
		  begin
		      $display ("\n%m");
		      $display("Pulse Width (H) ERROR on CLK: Setting output to unknown");
		      iregq_twh = 1'b1;
		      iregq_twh <= #1 1'b0;
		  end
	    end
	    else if( iclk == 1'b1)
		  begin
		      if( $time != 0 && ($time - iclklastev_2) < Twl)
		      begin
			  $display ("\n%m");
			  $display("Pulse Width (L) ERROR on CLK: Setting output to unknown");
			  iregq_twl = 1'b1;
			  iregq_twl <= #1 1'b0;
		      end
		  end
            #0 iclklastev_2 = $time;
            #0 iclklastev = $time;
            #0 prev_iclk = iclk;
	end
    end

always @(posedge clk)
    begin
	if( clk == 1'b1)
	begin
	    if( ss == 1'b1 && sr == 1'b1)
	    begin
		$display ("\n%m");
		$display("ERROR: Preset & Clear both Active: Setting outputs to unknown");
		q_setreset = 1'b1;
		q_setreset <= #1 1'b0;
	    end
	end
    end


always @(clk or  sr or  ss or  q_ts or  q_th or  q_twh or  q_twl or  q_setreset)
    begin
	if( (q_ts == 1'b1) || (q_th == 1'b1) || (q_twh == 1'b1) || (q_twl == 1'b1) || (q_setreset == 1'b1))
	begin
	    q <= #Tco 1'bx;
	end
	else if( prev_clk !== clk && clk == 1'b1)
	begin
	    if( sr == 1'b1)
	       q <= 1'b0;
	    else if( ss == 1'b1)
	       q <= 1'b1;
	    else
	       q <= #Tco ( x1 ^ x2);
	end
    end


reg qfb;
initial qfb <= 1'b0;
 
always @(q) 
    begin
	if( q == 1'b1)
	    qfb <= 1'b0;
	else
	    qfb <= 1'b1;
    end

always @(oe) #0 prev_oe = oe;

always @(q or oe or x1 or x2) 
    begin
	if( oe == 1'b1)
	begin
	    if( prev_oe !== oe)
	    begin
	       if( registered == `regi)
		   ytemp <= #Tpzx ~q;
	       else if( registered == `comb)
		   ytemp <= #Tpzx ~(x1 ^ x2);
	    end
	    else
	    begin
	       if( registered == `regi)
		   ytemp <= ~q;
	       else if( registered == `comb)
		   ytemp <= #Tpd ~(x1 ^ x2);
	    end
	end
	else
	begin
	    if( prev_oe !== oe)
	        ytemp <= #Tpxz 1'bz;
	    else
	        ytemp <= 1'bz;
	end
    end

always @( iclk or  iregq_ts or  iregq_th or  iregq_twh or  iregq_twl)
    begin
	if( (iregq_ts == 1'b1) || (iregq_th == 1'b1) || (iregq_twh == 1'b1) || (iregq_twl == 1'b1))
	    iregq <= #(Tico - Tpd) 1'bx;
	else if( prev_iclk !== iclk && iclk == 1'b1)
	begin
	    if( y == 1'b1)
	       iregq <= #(Tico - Tpd) 1'b1;
	    else
	       iregq <= #(Tico - Tpd) 1'b0;
	end
    end

reg fb;
initial fb <= 1'b0;

always @( iregq or y)
    begin
	if( bta_sel == `xreg)
	    fb <= iregq;
	else if( bta_sel == `xpin)
	begin
	    if( y == 1'b1)
		fb <= 1'b1;
	    else
		fb <= 1'b0;
	end
    end

endmodule



`timescale 1ps/1ps

module c34xckmx ( x, oe, fb ) ;

input x;
input oe;
output fb ;

reg fb ;

parameter		// Defaults to C341-30
	Tin 	= 7000 ,
	Texp	= 14000 ,
	Tpia	= 16000 ,
	Tlac	= 12000 ,
	Tlad	= 14000 ,
	Tic 	= 16000 ,
	Tics	= 2000 ,
	Tclr	= 6000 ,
	Tpre	= 6000 ,
	Trsu	= 8000 ,
	Trh 	= 8000 ,
	Tcomb	= 4000 ,
	Tlatch	= 4000 ,
	Trd 	= 2000 ,
	Tio 	= 6000 ,
	Tod 	= 5000 ,
	Txz 	= 11000 ,
	Tzx 	= 11000 ,
	Tfd 	= 1000 ,
	Tpcw	= 6000 ,
	Tpcr	= 6000 ,
	Tch	= 10000 ,
	Tcl	= 10000 ;


initial
    begin
	fb <= (~x) && oe ;
    end

always @(x or oe)
    begin
	fb <= (~x) && oe ;
    end

endmodule



`timescale 1ps/1ps

module c34xexin ( x, expsrc, exp, fb) ;

input x ;
input expsrc ;
input exp ;
output fb ;

reg fb ;

parameter		// Defaults to C341-30
	Tin 	= 7000 ,
	Texp	= 14000 ,
	Tpia	= 16000 ,
	Tlac	= 12000 ,
	Tlad	= 14000 ,
	Tic 	= 16000 ,
	Tics	= 2000 ,
	Tclr	= 6000 ,
	Tpre	= 6000 ,
	Trsu	= 8000 ,
	Trh 	= 8000 ,
	Tcomb	= 4000 ,
	Tlatch	= 4000 ,
	Trd 	= 2000 ,
	Tio 	= 6000 ,
	Tod 	= 5000 ,
	Txz 	= 11000 ,
	Tzx 	= 11000 ,
	Tfd 	= 1000 ,
	Tpcw	= 6000 ,
	Tpcr	= 6000 ,
	Tch	= 10000 ,
	Tcl	= 10000 ;


always @(x or expsrc or exp)
    begin
	if( exp == 1'b1)
	    fb <= #Texp x ;
	else
	    fb <= #Texp ~expsrc ;
    end

endmodule



`timescale 1ps/1ps

module c34xexp ( x, expsrc, exp, fb) ;

input x ;
input expsrc ;
input exp ;
output fb ;

reg fb ;

parameter		// Defaults to C341-30
	Tin 	= 7000 ,
	Texp	= 14000 ,
	Tpia	= 16000 ,
	Tlac	= 12000 ,
	Tlad	= 14000 ,
	Tic 	= 16000 ,
	Tics	= 2000 ,
	Tclr	= 6000 ,
	Tpre	= 6000 ,
	Trsu	= 8000 ,
	Trh 	= 8000 ,
	Tcomb	= 4000 ,
	Tlatch	= 4000 ,
	Trd 	= 2000 ,
	Tio 	= 6000 ,
	Tod 	= 5000 ,
	Txz 	= 11000 ,
	Tzx 	= 11000 ,
	Tfd 	= 1000 ,
	Tpcw	= 6000 ,
	Tpcr	= 6000 ,
	Tch	= 10000 ,
	Tcl	= 10000 ;


always @(x or expsrc or exp)
    begin
	if( exp == 1'b1)
	    fb <= #Texp x ;
	else
	    fb <= #Texp expsrc ;
    end

endmodule



`timescale 1ps/1ps

module c34xh (x1, x2, as, ar, clkpt, clklab, clksel, exp, qfb);

input x1;
input x2;
input as;
input ar;
input clkpt;
input clklab;
input clksel;
input exp;             // This is unused
output qfb;

parameter		// Defaults to C341-30
	Tin 	= 7000,
	Texp	= 14000,
	Tpia	= 16000,
	Tlac	= 12000,
	Tlad	= 14000,
	Tic 	= 16000,
	Tics	= 2000,
	Tclr	= 6000,
	Tpre	= 6000,
	Trsu	= 8000,
	Trh 	= 8000,
	Tcomb	= 4000,
	Tlatch	= 4000,
	Trd 	= 2000,
	Tio 	= 6000,
	Tod 	= 5000,
	Txz 	= 11000,
	Tzx 	= 11000,
	Tfd 	= 1000,
	Tpcw	= 6000,
	Tpcr	= 6000,
	Tch	= 10000,
	Tcl	= 10000;

	reg	qfb;
    	reg	x1_in;
    	reg	x2_in;
    	reg	as_in;
    	reg	ar_in;
    	reg	clkpt_in;
    	reg	clklab_in;
    	reg	clkcell;
    	reg	q_trsu;
    	reg	q_trh;
    	reg	q_tchpt;
    	reg	q_tclpt;
    	reg	q_tchsys;
    	reg	q_tclsys;
    	reg	q_tpcwr;
    	reg	q_tpcws;
    	reg	q_tpcrr;
    	reg	q_tpcrs;
    	reg	q_clkchk;

        reg     prev_clkcell, prev_ar_in, prev_as_in;
	reg	prev_x1_in, prev_x2_in;

	time 	xlastev;
	time 	clklastev;
	time 	clkptlastev;
	time 	clklablastev;
	time 	ar_inlastev, ar_inlastev_2;
	time 	as_inlastev, as_inlastev_2;

initial
    begin
	q_trsu  = 1'b0; q_trh    = 1'b0; q_tchpt  = 1'b0;
	q_tclpt = 1'b0; q_tchsys = 1'b0; q_tclsys = 1'b0;
	q_tpcwr = 1'b0; q_tpcws  = 1'b0; q_tpcrr  = 1'b0;
	q_tpcrs = 1'b0; q_clkchk = 1'b0;

	x1_in     = x1;
	x2_in     = x2;
	ar_in     = ar;
	as_in     = as;
	clkpt_in  = clkpt;
	clkcell   = (clkpt || (clksel && clklab));
	clklab_in = clklab;

	qfb = 1'b0;

        prev_x1_in = x1_in; prev_x2_in = x2_in;
	prev_ar_in = ar_in; prev_as_in = as_in;
        prev_clkcell = clkcell;

	xlastev       = 0; clklastev     = 0;
	clkptlastev   = 0; clklablastev  = 0;
	ar_inlastev   = 0; as_inlastev   = 0;
	ar_inlastev_2 = 0; as_inlastev_2 = 0;

    end


always @(x1) x1_in <= #Tlad x1;
always @(x2) x2_in <= #Tlad x2;
always @(as) as_in <= #Tlac as;
always @(ar) ar_in <= #Tlac ar;
always @(clkpt) clkpt_in <= #Tic clkpt;
always @(clklab) clklab_in <= #Tics clklab;


always @(clkpt_in or clklab_in)
	clkcell <= (clkpt_in || (clksel && clklab_in));


always @(x1_in) #0 prev_x1_in = x1_in;
always @(x2_in) #0 prev_x2_in = x2_in;
always @(clkcell) #0 prev_clkcell = clkcell;

always @(x1_in or x2_in or posedge clkcell)
	// Check if Set & Reset are not enabled
	if (as_in == 1'b1 && ar_in == 1'b1)
	begin
	    // setup check
	    if (prev_clkcell != clkcell && clkcell == 1'b1)
	    begin
		if (($time > Tlac) && ($time - xlastev) < Trsu)
		begin
		    $display ("\n%m");
		    $display(" Setup ERROR ON X: Setting output unknown");
		    q_trsu = 1'b1;
		    q_trsu <= #1 1'b0;
		end
		#0 clklastev = $time;
	    end
	    // hold check
	    if (prev_x1_in != x1_in || prev_x2_in != x2_in)
	    begin
		if (($time > Tlad) && ($time - clklastev) < Trh)
		begin
		    $display ("\n%m");
		    $display(" Hold ERROR ON X: Setting output unknown");
		    q_trh = 1'b1;
		    q_trh <= #1 1'b0;
		end
		#0 xlastev = $time;
	    end
	end


always @(clkpt_in)
    // Check if Set and Reset are not enabled
    if (as_in == 1'b1 && ar_in == 1'b1)
    begin
	if (clkpt_in == 1'b0)
	    if ($time > Tlac && ($time - clkptlastev) < Tch)
	    begin
		$display ("\n%m");
		$display("Clk Width (H) ERROR on CLK: Setting output unknown");
		q_tchpt = 1'b1;
		q_tchpt <= #1 1'b0;
	    end
	else if (clkpt_in == 1'b1)
	    if ($time > Tlac && ($time - clkptlastev) < Tcl)
	    begin
		$display ("\n%m");
		$display("Clk Width (L) ERROR on CLK: Setting output unknown");
		q_tclpt = 1'b1;
		q_tclpt <= #1 1'b0;
	    end
	#0 clkptlastev = $time;
    end


always @(clklab_in)
    // Check if Set and Reset are not enabled
    if (as_in == 1'b1 && ar_in == 1'b1)
    begin
	if (clklab_in == 1'b0)
	    if ($time > Tlac && ($time - clklablastev) < Tch)
	    begin
		$display ("\n%m");
		$display("Clk Width (H) ERROR on CLK: Setting output unknown");
		q_tchsys = 1'b1;
		q_tchsys <= #1 1'b0;
	    end
	else if (clklab_in == 1'b1)
	    if ($time > Tlac && ($time - clklablastev) < Tcl)
	    begin
		$display ("\n%m");
		$display("Clk Width (L) ERROR on CLK: Setting output unknown");
		q_tclsys = 1'b1;
		q_tclsys <= #1 1'b0;
	    end
	#0 clklablastev = $time;
    end


always @(as_in)
    begin
	// Check if Set is not enabled
	if (as_in == 1'b1)
	    if ($time > Tlac && ($time - as_inlastev) < Tpcw)
	    begin
		$display ("\n%m");
		$display("Pulse Width (L) ERROR on AS: Setting output unknown");
		q_tpcws = 1'b1;
		q_tpcws <= #1 1'b0;
	    end
	#0 as_inlastev = $time;
	#0 prev_as_in = as_in;
    end


always @(ar_in)
    begin
	// Check if Reset is not enabled
	if (ar_in == 1'b1)
	    if ($time > Tlac && ($time - ar_inlastev) < Tpcw)
	    begin
		$display ("\n%m");
		$display("Pulse Width (L) ERROR on AR: Setting output unknown");
		q_tpcwr = 1'b1;
		q_tpcwr <= #1 1'b0;
	    end
	#0 ar_inlastev = $time;
	#0 prev_ar_in = ar_in;
    end


always @(ar_in or posedge clkcell)
    begin
        if (prev_ar_in != ar_in)
	    ar_inlastev_2 = $time;
	if (ar_in == 1'b0)
	    // setup violation check
	    if (prev_clkcell != clkcell && clkcell == 1'b1)
	    	if (($time > Tlac) && (($time - ar_inlastev_2) < Tpcr))
		begin
		    $display ("\n%m");
		    $display("Recovery ERROR on AR: Setting output unknown");
		    q_tpcrr = 1'b1;
		    q_tpcrr <= #1 1'b0;
		end
    end 



always @(as_in or posedge clkcell)
    begin
        if (prev_as_in != as_in)
	    as_inlastev_2 = $time;
	if (as_in == 1'b0)
	    // setup violation check
	    if (prev_clkcell != clkcell && clkcell == 1'b1)
		if (($time > Tlac) && (($time - as_inlastev_2) < Tpcr))
		begin
		    $display ("\n%m");
		    $display("Recovery ERROR on AS: Setting output unknown");
		    q_tpcrs = 1'b1;
		    q_tpcrs <= #1 1'b0;
		end
    end 


always @(x1_in or x2_in or clkcell or ar_in or as_in or q_trsu or q_trh or
    q_tchpt or q_tchsys or q_tclpt or q_tclsys or q_tpcwr or q_tpcws or
    q_tpcrr or q_tpcrs or q_clkchk)

    begin
	if ((q_trsu  == 1'b1) || (q_trh    == 1'b1) || (q_tchpt  == 1'b1) ||
	    (q_tclpt == 1'b1) || (q_tchsys == 1'b1) || (q_tclsys == 1'b1) ||
	    (q_tpcwr == 1'b1) || (q_tpcws  == 1'b1) || (q_tpcrr  == 1'b1) ||
	    (q_tpcrs == 1'b1) || (q_clkchk == 1'b1))
	    qfb <= #(Trd+Tfd) 1'bx;
	else if (ar_in == 1'b0 && as_in == 1'b0)
	begin
	    if (clkcell == 1'b1 && prev_clkcell == clkcell)
		qfb <= #(Tcomb + Tfd) (x1_in ^ x2_in);
	    else
		qfb <= #(Tlatch + Tfd) (x1_in ^ x2_in);
	end
	else if (ar_in == 1'b0)
	    qfb <= #(Tclr+Tfd) 1'b0;
	else if (as_in == 1'b0)
	    qfb <= #(Tpre+Tfd) 1'b1;
	else if (clkcell == 1'b1 && prev_clkcell != clkcell)
	    qfb <= #(Trd + Tfd) (x1_in ^ x2_in);
    end

endmodule



`timescale 1ps/1ps

module c34xin ( x, fb) ;

input x ;
output fb ;

wire fb ;

parameter		// Defaults to C341-30
	Tin 	= 7000 ,
	Texp	= 14000 ,
	Tpia	= 16000 ,
	Tlac	= 12000 ,
	Tlad	= 14000 ,
	Tic 	= 16000 ,
	Tics	= 2000 ,
	Tclr	= 6000 ,
	Tpre	= 6000 ,
	Trsu	= 8000 ,
	Trh 	= 8000 ,
	Tcomb	= 4000 ,
	Tlatch	= 4000 ,
	Trd 	= 2000 ,
	Tio 	= 6000 ,
	Tod 	= 5000 ,
	Txz 	= 11000 ,
	Tzx 	= 11000 ,
	Tfd 	= 1000 ,
	Tpcw	= 6000 ,
	Tpcr	= 6000 ,
	Tch	= 10000 ,
	Tcl	= 10000 ;


assign #Tin fb =  x ;

endmodule



`timescale 1ps/1ps

module c34xm (x1, x2, as, ar, clkpt, clklab, clksel, oe, y, qfb, yfb);

input x1;
input x2;
input as;
input ar;
input clkpt;
input clklab;
input clksel;
input oe;
inout y;
output qfb;
output yfb;

parameter		// Defaults to C341-30
	Tin 	= 7000,
	Texp	= 14000,
	Tpia	= 16000,
	Tlac	= 12000,
	Tlad	= 14000,
	Tic 	= 16000,
	Tics	= 2000,
	Tclr	= 6000,
	Tpre	= 6000,
	Trsu	= 8000,
	Trh 	= 8000,
	Tcomb	= 4000,
	Tlatch	= 4000,
	Trd 	= 2000,
	Tio 	= 6000,
	Tod 	= 5000,
	Txz 	= 11000,
	Tzx 	= 11000,
	Tfd 	= 1000,
	Tpcw	= 6000,
	Tpcr	= 6000,
	Tch	= 10000,
	Tcl	= 10000;

    	reg	q;
	reg	qfb;
	reg	ytemp;
	reg	yfb;
    	reg	x1_in;
    	reg	x2_in;
    	reg	as_in;
    	reg	ar_in;
    	reg	clkpt_in;
    	reg	clklab_in;
    	reg	clkcell;
    	reg	oe_in;
    	reg	q_trsu;
    	reg	q_trh;
    	reg	q_tchpt;
    	reg	q_tclpt;
    	reg	q_tchsys;
    	reg	q_tclsys;
    	reg	q_tpcwr;
    	reg	q_tpcws;
    	reg	q_tpcrr;
    	reg	q_tpcrs;
    	reg	q_clkchk;
        reg     prev_oe_in, prev_clkcell, prev_ar_in, prev_as_in;
	reg	prev_x1_in, prev_x2_in;

	time 	xlastev;
	time 	clklastev;
	time 	clkptlastev;
	time 	clklablastev;
	time 	ar_inlastev, ar_inlastev_2;
	time 	as_inlastev, as_inlastev_2;

initial
    begin
	q_trsu  = 1'b0; q_trh    = 1'b0; q_tchpt  = 1'b0;
	q_tclpt = 1'b0; q_tchsys = 1'b0; q_tclsys = 1'b0;
	q_tpcwr = 1'b0; q_tpcws  = 1'b0; q_tpcrr  = 1'b0;
	q_tpcrs = 1'b0; q_clkchk = 1'b0;

	x1_in     = x1;
	x2_in     = x2;
	ar_in     = ar;
	as_in     = as;
	oe_in     = oe;
	clkpt_in  = clkpt;
	clkcell   = (clkpt || (clksel && clklab));
	clklab_in = clklab;

	q   = 1'b0;
	qfb = 1'b0;

	if (oe != 1'b1)
	    ytemp = 1'bz;
	else
	    ytemp = q;

        prev_x1_in = x1_in; prev_x2_in = x2_in;
	prev_ar_in = ar_in; prev_as_in = as_in;
        prev_oe_in = oe_in; prev_clkcell = clkcell;

	xlastev       = 0; clklastev     = 0;
	clkptlastev   = 0; clklablastev  = 0;
	ar_inlastev   = 0; as_inlastev   = 0;
	ar_inlastev_2 = 0; as_inlastev_2 = 0;
    end


always @(x1) x1_in <= #Tlad x1;
always @(x2) x2_in <= #Tlad x2;
always @(as) as_in <= #Tlac as;
always @(ar) ar_in <= #Tlac ar;
always @(oe) oe_in <= #Tlac oe;
always @(clkpt) clkpt_in <= #Tic clkpt;
always @(clklab) clklab_in <= #Tics clklab;


always @(clkpt_in or clklab_in)
	clkcell <= (clkpt_in || (clksel && clklab_in));


always @(x1_in) #0 prev_x1_in = x1_in;
always @(x2_in) #0 prev_x2_in = x2_in;
always @(clkcell) #0 prev_clkcell = clkcell;

always @(x1_in or x2_in or posedge clkcell)
	// Check if Set & Reset are not enabled
	if (as_in == 1'b1 && ar_in == 1'b1)
	begin
	// setup check
            if (prev_clkcell != clkcell && clkcell == 1'b1)
            begin
		if (($time > Tlac) && ($time - xlastev) < Trsu)
		begin
		    $display ("\n%m");
		    $display(" Setup ERROR ON X: Setting output unknown");
		    q_trsu = 1'b1;
		    q_trsu <= #1 1'b0;
		end
		#0 clklastev = $time;
            end
	// hold check
	    if (prev_x1_in != x1_in || prev_x2_in != x2_in)
	    begin
		if (($time > Tlad) && ($time - clklastev) < Trh)
		begin
		    $display ("\n%m");
		    $display(" Hold ERROR ON X: Setting output unknown");
		    q_trh = 1'b1;
		    q_trh <= #1 1'b0;
		end
		#0 xlastev = $time;
	    end
	end


always @(clkpt_in)
	// Check if Set and Reset are not enabled
	if (as_in == 1'b1 && ar_in == 1'b1)
	begin
	    if (clkpt_in == 1'b0)
		if ($time > Tlac && ($time - clkptlastev) < Tch)
		begin
		    $display ("\n%m");
		    $display("Clk Width (H) ERROR on CLK: Setting output unknown");
		    q_tchpt = 1'b1;
		    q_tchpt <= #1 1'b0;
		end
	    else if (clkpt_in == 1'b1)
		if ($time > Tlac && ($time - clkptlastev) < Tcl)
		begin
		    $display ("\n%m");
		    $display("Clk Width (L) ERROR on CLK: Setting output unknown");
		    q_tclpt = 1'b1;
		    q_tclpt <= #1 1'b0;
		end
	    #0 clkptlastev = $time;
	end


always @(clklab_in)
	// Check if Set and Reset are not enabled
	if (as_in == 1'b1 && ar_in == 1'b1)
	begin
	    if (clklab_in == 1'b0)
		if ($time > Tlac && ($time - clklablastev) < Tch)
		begin
		    $display ("\n%m");
		    $display("Clk Width (H) ERROR on CLK: Setting output unknown");
		    q_tchsys = 1'b1;
		    q_tchsys <= #1 1'b0;
		end
	    else if (clklab_in == 1'b1)
		if ($time > Tlac && ($time - clklablastev) < Tcl)
		begin
		    $display ("\n%m");
		    $display("Clk Width (L) ERROR on CLK: Setting output unknown");
		    q_tclsys = 1'b1;
		    q_tclsys <= #1 1'b0;
		end
	    #0 clklablastev = $time;
	end


always @(as_in)
    begin
	// Check if Set is not enabled
	if (as_in == 1'b1)
	    if ($time > Tlac && ($time - as_inlastev) < Tpcw)
	    begin
		$display ("\n%m");
		$display("Pulse Width (L) ERROR on AS: Setting output unknown");
		q_tpcws = 1'b1;
		q_tpcws <= #1 1'b0;
	    end
	#0 as_inlastev = $time;
	#0 prev_as_in = as_in;
    end


always @(ar_in)
    begin
	// Check if Reset is not enabled
	if (ar_in == 1'b1)
	    if ($time > Tlac && ($time - ar_inlastev) < Tpcw)
	    begin
		$display ("\n%m");
		$display("Pulse Width (L) ERROR on AR: Setting output unknown");
		q_tpcwr = 1'b1;
		q_tpcwr <= #1 1'b0;
	    end
	#0 ar_inlastev = $time;
	#0 prev_ar_in = ar_in;
    end


always @(ar_in or posedge clkcell)
    begin
	if (prev_ar_in != ar_in)
	    ar_inlastev_2 = $time;
	if (ar_in == 1'b0)
	    // setup violation check
	    if (prev_clkcell != clkcell && clkcell == 1'b1)
		if (($time > Tlac) && (($time - ar_inlastev_2) < Tpcr))
		begin
		    $display ("\n%m");
		    $display("Recovery ERROR on AR: Setting output unknown");
		    q_tpcrr = 1'b1;
		    q_tpcrr <= #1 1'b0;
		end
    end 


always @(as_in or posedge clkcell)
    begin
	if (prev_as_in != as_in)
	    as_inlastev_2 = $time;
	if (as_in == 1'b0)
	    // setup violation check
	    if (prev_clkcell != clkcell && clkcell == 1'b1)
		if (($time > Tlac) && (($time - as_inlastev_2) < Tpcr))
		begin
		    $display ("\n%m");
		    $display("Recovery ERROR on AS: Setting output unknown");
		    q_tpcrs = 1'b1;
		    q_tpcrs <= #1 1'b0;
		end
    end 


always @(x1_in or x2_in or clkcell or ar_in or as_in or q_trsu or q_trh or
    q_tchpt or q_tchsys or q_tclpt or q_tclsys or q_tpcwr or q_tpcws or
    q_tpcrr or q_tpcrs or q_clkchk)

    begin
	if ((q_trsu  == 1'b1) || (q_trh    == 1'b1) || (q_tchpt  == 1'b1) ||
	    (q_tclpt == 1'b1) || (q_tchsys == 1'b1) || (q_tclsys == 1'b1) ||
	    (q_tpcwr == 1'b1) || (q_tpcws  == 1'b1) || (q_tpcrr  == 1'b1) ||
	    (q_tpcrs == 1'b1) || (q_clkchk == 1'b1))
	    q <= #Trd 1'bx;
	else if (ar_in == 1'b0 && as_in == 1'b0)
	begin
	    if (clkcell == 1'b1 && prev_clkcell == clkcell)
		q <= #Tcomb (x1_in ^ x2_in);
	    else
		q <= #Tlatch (x1_in ^ x2_in);
	end
	else if (ar_in == 1'b0)
	    q <= #Tclr 1'b0;
	else if (as_in == 1'b0)
	    q <= #Tpre 1'b1;
	else if (clkcell == 1'b1 && prev_clkcell != clkcell)
	    q <= #Trd (x1_in ^ x2_in);
    end

always @(q) qfb <= #Tfd q;


always @(q or oe_in)
    begin
	if (oe_in == 1'b1)
            if (prev_oe_in != oe_in)
	        ytemp <= #Tzx q;
	    else
                ytemp <= #Tod q;
	else
            if (prev_oe_in != oe_in)
	        ytemp <= #Txz 1'bz;
	    else
                ytemp <= 1'bz;
	#0 prev_oe_in = oe_in;
    end

wire y = ytemp;


always @(y)
	if (y == 1'b1)
	    yfb <= #Tio 1'b1;
	else
	    yfb <= #Tio 1'b0;

endmodule



`timescale 1ps/1ps

module c34xpia ( x, fb) ;

input x ;
output fb ;

wire fb ;

parameter		// Defaults to C341-30
	Tin 	= 7000 ,
	Texp	= 14000 ,
	Tpia	= 16000 ,
	Tlac	= 12000 ,
	Tlad	= 14000 ,
	Tic 	= 16000 ,
	Tics	= 2000 ,
	Tclr	= 6000 ,
	Tpre	= 6000 ,
	Trsu	= 8000 ,
	Trh 	= 8000 ,
	Tcomb	= 4000 ,
	Tlatch	= 4000 ,
	Trd 	= 2000 ,
	Tio 	= 6000 ,
	Tod 	= 5000 ,
	Txz 	= 11000 ,
	Tzx 	= 11000 ,
	Tfd 	= 1000 ,
	Tpcw	= 6000 ,
	Tpcr	= 6000 ,
	Tch	= 10000 ,
	Tcl	= 10000 ;



assign #Tpia fb = x ;

endmodule


`timescale 1ps/1ps

module c37xclk ( x, fb ) ;
    input x ;
    output fb ;

    parameter bsel = `ninv ;


    parameter	Tclk	=  4000 ,
		Tird	=  1000 ,
		Ticomb	=  3000 ,
		Tilat	=  5500 ,
		Tirsu	=  6000 ,
		Tirh	=  2000 ,
		Tsop	=  1500 ,
		Tord	=  1000 ,
		Tocomb	=  3000 ,
		Tolat	=  5500 ,
		Torsu	=  4500 ,
		Torh	=  0000 ,
		Tod	=  1000 ,
		Txz	=  8500 ,
		Tzx	=  8500 ,
		Tfb	=  0000 ,
		Trst	=  8500 ,
		Tpst	=  8500 ,
		Twl	=  2500 ,
		Twh	=  2500 ,
		Trw	=  8000 ,
		Trr	= 10000 ,
		Tpw	=  8000 ,
		Tpr	= 10000 ,
		Tvcco	=     0 ;

    wire #Tclk fb = (bsel == `ninv) ? x : ~x ;
endmodule


`timescale 1ps/1ps

module c37xinp (d, clk, fb);
    input d;
    input clk;
    output fb;

    parameter iregister = `ireg;


    parameter	Tclk	=  4000 ,
		Tird	=  1000 ,
		Ticomb	=  3000 ,
		Tilat	=  5500 ,
		Tirsu	=  6000 ,
		Tirh	=  2000 ,
		Tsop	=  1500 ,
		Tord	=  1000 ,
		Tocomb	=  3000 ,
		Tolat	=  5500 ,
		Torsu	=  4500 ,
		Torh	=  0000 ,
		Tod	=  1000 ,
		Txz	=  8500 ,
		Tzx	=  8500 ,
		Tfb	=  0000 ,
		Trst	=  8500 ,
		Tpst	=  8500 ,
		Twl	=  2500 ,
		Twh	=  2500 ,
		Trw	=  8000 ,
		Trr	= 10000 ,
		Tpw	=  8000 ,
		Tpr	= 10000 ,
		Tvcco	=     0 ;

    reg	iregq_tsh, iregq_twh, iregq_twl;
    reg iregq_tis, iregq_tih, prev_d;
    reg	prev_clk, q1, fb;
    time clklastevlo, clklastevhi, clklastev, dlastev;

    initial
    begin
	iregq_tsh = 1'b0; iregq_twh = 1'b0; iregq_twl = 1'b0;
	iregq_tis = 1'b0; iregq_tih = 1'b0; prev_d = d;
	prev_clk = clk; q1 = 1'b0; fb = 1'b0;
	clklastevlo = 0; clklastevhi = 0; clklastev = 0; dlastev = 0;
    end

    // Add the clock delay

    wire dclk = clk;

    // check clk pulse width
    always @(dclk)
	// Check only if the cell is not combinational.
	if(iregister != `comb)
	begin
	    if(dclk == 1'b0)
	    begin
		if(clklastevhi != 0 && (($time - clklastevhi) < Twh))
		begin
		    $display ("\n%m");
		    $write("Width (H) ERROR on CLK: Setting output unknown");
		    $display($time);
		    iregq_twh = 1'b1;
		    iregq_twh = #1 1'b0;
		end
		clklastevlo = $time;
	    end
	    if (dclk == 1'b1)
	    begin
		if(clklastevlo != 0 && (($time - clklastevlo) < Twl))
		begin
		    $display ("\n%m");
		    $write("Width (L) ERROR on CLK: Setting output unknown");
		    $display($time);
		    iregq_twl = 1'b1;
		    iregq_twl = #1 1'b0;
		end
		clklastevhi = $time;
	    end
	end

    // check for clk setup/hold violations
    always @(d or posedge dclk)
	// Check only if the cell is not combinational.
	if(iregister != `comb)
	begin
	    // setup violation check
	    if(prev_clk !== dclk && dclk == 1'b1)
	    begin
		if(dlastev != 0 && (($time - dlastev) < Tirsu))
		begin
		    $display ("\n%m");
		    $write("Setup ERROR ON D: Setting output unknown");
		    $display($time);
		    iregq_tis = 1'b1;
		    iregq_tis = #1 1'b0;
		end
		clklastev = $time;
	    end
	    // hold violation check
	    if(prev_d !== d)
	    begin
		if(clklastev !== 0 && (($time - clklastev) < Tirh))
		begin
		    $display ("\n%m");
		    $write("Hold ERROR ON D: Setting output unknown");
		    $display($time);
		    iregq_tih = 1'b1;
		    iregq_tih = #1 1'b0;
		end
		dlastev = $time;
		#0 prev_d = d;
	    end
	    iregq_tsh = iregq_tis || iregq_tih;
	end

    // Simulate the Register.
    wire errflg = (iregq_tsh || iregq_twh || iregq_twl);

    always @(d)
	case (iregister)
	    `comb :     #Ticomb fb = d;
	endcase

    always @(dclk) #0 prev_clk = dclk;
    always @(d or dclk or errflg)
    begin
	case (errflg)
	    0 : case (iregister)
		`ireg :     if(prev_clk !== dclk && dclk == 1'b1) fb <= #Tird d;
		`dblireg :  if(prev_clk !== dclk && dclk == 1'b1) begin
								fb <= #Tird q1;
								q1 <= #Tird d;
								end
		`iltch :    case (prev_clk !== dclk && dclk == 1'b1)
				0 : if (dclk == 1'b1) #Tilat fb = d;
				1 : fb <= #Tird d;
			    endcase
		endcase
	    1 : #Tird fb = 1'bx;
	endcase
    end
endmodule


`timescale 1ps/1ps

module c37xm (x, oe, y, fb);
    input x;
    input oe;
    inout y;
    output fb;

    parameter	bsel	= `ninv;


    parameter	Tclk	=  4000 ,
		Tird	=  1000 ,
		Ticomb	=  3000 ,
		Tilat	=  5500 ,
		Tirsu	=  6000 ,
		Tirh	=  2000 ,
		Tsop	=  1500 ,
		Tord	=  1000 ,
		Tocomb	=  3000 ,
		Tolat	=  5500 ,
		Torsu	=  4500 ,
		Torh	=  0000 ,
		Tod	=  1000 ,
		Txz	=  8500 ,
		Tzx	=  8500 ,
		Tfb	=  0000 ,
		Trst	=  8500 ,
		Tpst	=  8500 ,
		Twl	=  2500 ,
		Twh	=  2500 ,
		Trw	=  8000 ,
		Trr	= 10000 ,
		Tpw	=  8000 ,
		Tpr	= 10000 ,
		Tvcco	=     0 ;

    reg prev_oe;
    reg ytmp;
    reg fbtmp;


    initial
    begin
	prev_oe = oe;
	if (oe == 1'b1)
	    if (bsel == `invt)
		ytmp = ~x;
	    else
		ytmp =  x;
	else
	    ytmp = 1'bz;
	fbtmp = ytmp;
    end

    wire y = ytmp;

    always @(oe) #0 prev_oe = oe;
    always @(y or x or oe)
    begin
	case (prev_oe === oe)
	    0 : case (oe)

		0 : #(Txz + Tvcco) ytmp = 1'bz;

		1 : case (bsel)
		    `invt : #(Tzx + Tvcco) ytmp = ~x;
		    `ninv : #(Tzx + Tvcco) ytmp =  x;
		endcase

	    endcase
	    1 : case (oe)
		0 : ytmp = 1'bz;

		1 : case (bsel)
		    `invt : #(Tod + Tvcco) ytmp = ~x;
		    `ninv : #(Tod + Tvcco) ytmp =  x;
		    endcase

	    endcase
	endcase
    end

    always @(y)
    begin
	case (y)
	    1'b0 : fbtmp = 1'b0;
	    1'b1 : fbtmp = 1'b1;
	    1'bx : fbtmp = 1'bx;
	    1'bz : fbtmp = 1'bx;
	endcase
    end

    wire fb = fbtmp;

endmodule


`timescale 1ps/1ps

module c37xmux (x, fb) ;
    input x ;
    output fb ;


    parameter	Tclk	=  4000 ,
		Tird	=  1000 ,
		Ticomb	=  3000 ,
		Tilat	=  5500 ,
		Tirsu	=  6000 ,
		Tirh	=  2000 ,
		Tsop	=  1500 ,
		Tord	=  1000 ,
		Tocomb	=  3000 ,
		Tolat	=  5500 ,
		Torsu	=  4500 ,
		Torh	=  0000 ,
		Tod	=  1000 ,
		Txz	=  8500 ,
		Tzx	=  8500 ,
		Tfb	=  0000 ,
		Trst	=  8500 ,
		Tpst	=  8500 ,
		Twl	=  2500 ,
		Twh	=  2500 ,
		Trw	=  8000 ,
		Trr	= 10000 ,
		Tpw	=  8000 ,
		Tpr	= 10000 ,
		Tvcco	=     0 ;

    reg fb;
    initial fb <= 1'b0;

    always @x #Tsop fb = x;

endmodule


`timescale 1ps/1ps

module c37xoreg (as, x, clk, ar, fb, q);
    input as;
    input x;
    input clk;
    input ar;
    output fb;
    output q;

    parameter oregister = `dreg;
    parameter source = `src_ptm;


    parameter	Tclk	=  4000 ,
		Tird	=  1000 ,
		Ticomb	=  3000 ,
		Tilat	=  5500 ,
		Tirsu	=  6000 ,
		Tirh	=  2000 ,
		Tsop	=  1500 ,
		Tord	=  1000 ,
		Tocomb	=  3000 ,
		Tolat	=  5500 ,
		Torsu	=  4500 ,
		Torh	=  0000 ,
		Tod	=  1000 ,
		Txz	=  8500 ,
		Tzx	=  8500 ,
		Tfb	=  0000 ,
		Trst	=  8500 ,
		Tpst	=  8500 ,
		Twl	=  2500 ,
		Twh	=  2500 ,
		Trw	=  8000 ,
		Trr	= 10000 ,
		Tpw	=  8000 ,
		Tpr	= 10000 ,
		Tvcco	=     0 ;

    reg	regq_tsh, regq_twh, regq_twl;
    reg regq_tpw, regq_tpr, regq_trw, regq_trr;
    reg	prev_clk, q;

    reg regq_ts, regq_th;
    reg prev_x, prev_ar, prev_as;
    time xlastev, clklastev, clklastevhi, clklastevlo, arlastev, aslastev;

    initial
    begin
	regq_tsh = 1'b0; regq_twh = 1'b0; regq_twl = 1'b0;
	regq_tpw = 1'b0; regq_tpr = 1'b0; regq_trw = 1'b0; regq_trr = 1'b0;
	prev_clk = clk;

	regq_ts = 1'b0; regq_th = 1'b0;
	prev_x = x; prev_ar = ar; prev_as = as;
	xlastev = 0; clklastev = 0; clklastevhi = 0; clklastevlo = 0;
	arlastev = 0; aslastev = 0;

	if (oregister == `cmb)
	    q = x;
	else
	    q = 1'b0;
    end

    // Add the clock delay(s)

    wire dclk = clk;

    // check clk pulse width
    always @(dclk)
	// Check only if the cell is not combinational.
	if (oregister != `cmb)
	begin
	    if (dclk == 1'b0)
	    begin
		if ((clklastevhi != 0) && (($time - clklastevhi) < Twh))
		begin
		    $display ("\n%m");
		    $write("CLK Width (H) ERROR: Setting output unknown");
		    $display($time);
		    regq_twh = 1'b1;
		    regq_twh = #1 1'b0;
		end
		clklastevlo = $time;
	    end
	    if (dclk == 1'b1)
	    begin
		if ((clklastevlo != 0) && (($time - clklastevlo) < Twl))
		begin
		    $display ("\n%m");
		    $write("CLK Width (L) ERROR: Setting output unknown");
		    $display($time);
		    regq_twl = 1'b1;
		    regq_twl = #1 1'b0;
		end
		clklastevhi = $time;
	    end
	end

    // check for clk setup/hold violations
    always @(x or posedge dclk)
	// Check if the cell is not combinational.
	if (oregister != `cmb)
	begin // setup violation check
	    if (prev_clk !== dclk && dclk == 1'b1)
	    begin
		if (source == `src_ptm)
		begin

			if ((xlastev != 0) && (($time - xlastev) < Torsu))
			begin
			    $display ("\n%m");
			    $write("Setup ERROR ON X: Setting output unknown");
			    $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end

		end
		else   // Buried macrocell used as input register
		begin

			if ((xlastev != 0) && ($time - xlastev) < Tirsu)
			begin
			   $display ("\n%m");
			   $write("Setup ERROR ON X: Setting output unknown");
			   $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end

		end
		clklastev = $time;
	    end
	    // hold violation check
	    if (prev_x !== x)
	    begin
		if (source == `src_ptm)
		begin

			if ((clklastev != 0) && (($time - clklastev) < Torh))
			begin
			    $display ("\n%m");
			    $write(" Hold ERROR ON X: Setting output unknown");
			    $display($time);
			    regq_th = 1'b1;
			    regq_th = #1 1'b0;
			end

		end
		else   // Buried macrocell used as input register
		begin

			if ((clklastev != 0) && ($time - clklastev) < Tirh)
			begin
			    $display ("\n%m");
			    $write("Hold ERROR ON X: Setting output unknown");
			    $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end

		end
		xlastev = $time;
		#0 prev_x = x;
	    end
	    regq_tsh = regq_ts || regq_th;
	end

    // Check RESET minimum pulse width
    always @(ar)
	if (oregister != `cmb)
	begin
	    if ((ar == 1'b0) && (prev_ar == 1'b1) &&
		(arlastev != 0) && (($time - arlastev) < Trw))
	    begin
		$display ("\n%m");
		$write("Pulse Width ERROR on AR: Setting output unknown");
		$display($time);
		regq_trw = 1'b1;
		regq_trw = #1 1'b0;
	    end
	    arlastev = $time;
	    #0 prev_ar = ar;
	end

    // Check PRESET minimum pulse width
    always @(as)
	if (oregister != `cmb)
	begin
	    if ((as == 1'b0) && (prev_as == 1'b1) &&
		(aslastev != 0) && (($time - aslastev) < Tpw))
	    begin
		$display ("\n%m");
		$write("Pulse Width ERROR on AS: Setting output unknown");
		$display($time);
		regq_tpw = 1'b1;
		regq_tpw = #1 1'b0;
	    end
	    aslastev = $time;
	    #0 prev_as = as;
	end

    // Check for Asynchronous Reset/Preset Recovery violation
    always @(posedge dclk)
	if (oregister != `cmb)
	begin
	    if (ar == 1'b0)
	    begin
		if ((arlastev != 0) && (($time - arlastev) < Trr))
		begin
		    $display ("\n%m");
		    $write("Recovery ERROR on AR: Setting output unknown");
		    $display($time);
		    regq_trr = 1'b1;
		    regq_trr = #1 1'b0;
		end
	    end
	    if (as == 1'b0)
	    begin
		if ((aslastev != 0) && (($time - aslastev) < Tpr))
		begin
		    $display ("\n%m");
		    $write("Recovery ERROR on AS: Setting output unknown");
		    $display($time);
		    regq_tpr = 1'b1;
		    regq_tpr = #1 1'b0;
		end
	    end
	end

    // Simulate the register.
    wire errflg = (regq_tsh || regq_twh || regq_twl
		|| regq_trw || regq_tpw || regq_trr || regq_tpr);

    always @(x)
	case (oregister)
	    `cmb : case (source)
		    `src_ptm : q <= #Tocomb x;
		    `src_adj : $display ("Illegal config: Input combinatorial");
	    endcase
	endcase

    always @(dclk) #0 prev_clk = dclk;
    always @(dclk or x or as or ar or errflg)
    begin
	case (oregister)
	    `cmb : ;
	    default : case (errflg)
		0 : case (ar)
		    0 : case (as)
			0 : case (source)
			    `src_ptm : case (oregister)
				`oltch : case(prev_clk !== dclk && dclk == 1'b1)
				    0 : if (dclk == 1'b1) #Tolat q = x;
				    1 : q <= #Tord x;
				endcase
				`dreg : if (prev_clk !== dclk && dclk == 1'b1)
						 q <= #Tord x;
				`treg : if (prev_clk !== dclk && dclk == 1'b1 &&
					x == 1'b1) q <= #Tord ~q;
			    endcase
			    `src_adj : case (oregister)
				`oltch : case(prev_clk !== dclk && dclk == 1'b1)
				    0 : if (dclk == 1'b1) #Tilat q = x;
				    1 : q <= #Tird x;
				endcase
				`dreg : if (prev_clk !== dclk  && dclk == 1'b1)
						 q <= #Tird x;
				`treg : $display ("Illegal config: Input T-ff");
			    endcase
			endcase
			1 : q <= #Tpst 1'b1;
		    endcase
		    1 : q <= #Trst 1'b0;
		endcase
		1 : case (source)
		    `src_ptm : #Tord q = 1'bx;
		    `src_adj : #Tird q = 1'bx;
		endcase
	    endcase
	endcase
    end

    // Simulate the feedback
    wire #Tfb dq = q;
    wire fb = (source == `src_ptm) ? dq : q;
endmodule


`timescale 1ps/1ps

module c37xprod (x, fb) ;
    input x ;
    output fb ;


    parameter	Tclk	=  4000 ,
		Tird	=  1000 ,
		Ticomb	=  3000 ,
		Tilat	=  5500 ,
		Tirsu	=  6000 ,
		Tirh	=  2000 ,
		Tsop	=  1500 ,
		Tord	=  1000 ,
		Tocomb	=  3000 ,
		Tolat	=  5500 ,
		Torsu	=  4500 ,
		Torh	=  0000 ,
		Tod	=  1000 ,
		Txz	=  8500 ,
		Tzx	=  8500 ,
		Tfb	=  0000 ,
		Trst	=  8500 ,
		Tpst	=  8500 ,
		Twl	=  2500 ,
		Twh	=  2500 ,
		Trw	=  8000 ,
		Trr	= 10000 ,
		Tpw	=  8000 ,
		Tpr	= 10000 ,
		Tvcco	=     0 ;

    assign fb = x;
endmodule


`timescale 1ps/1ps

module c37kinp (d, clk, fb);
    input d;
    input clk;
    output fb;

    parameter iregister = `ireg;

    parameter	Tclk	= 2000 ,
		Tird	=  500 ,
		Ticomb	= 1000 ,
		Tilat	= 3500 ,
		Tirsu	= 4000 ,
		Tirh	= 0000 ,
		Twl	= 2500 ,
		Twh	= 2500 ;

    reg	iregq_tsh, iregq_twh, iregq_twl;
    reg iregq_tis, iregq_tih, prev_d;
    reg	prev_clk, q1, fb;
    time clklastevlo, clklastevhi, clklastev, dlastev;

    initial
    begin
	iregq_tsh = 1'b0; iregq_twh = 1'b0; iregq_twl = 1'b0;
	iregq_tis = 1'b0; iregq_tih = 1'b0; prev_d = d;
	prev_clk = clk; q1 = 1'b0; fb = 1'b0;
	clklastevlo = 0; clklastevhi = 0; clklastev = 0; dlastev = 0;
    end

    // Add the clock delay

    wire #Tclk dclk = clk;

    // check clk pulse width
    always @(dclk)
	// Check only if the cell is not combinational.
	if(iregister != `comb)
	begin
	    if(dclk == 1'b0)
	    begin
		if(clklastevhi != 0 && (($time - clklastevhi) < Twh))
		begin
		    $display ("\n%m");
		    $write("Width (H) ERROR on CLK: Setting output unknown");
		    $display($time);
		    iregq_twh = 1'b1;
		    iregq_twh = #1 1'b0;
		end
		clklastevlo = $time;
	    end
	    if (dclk == 1'b1)
	    begin
		if(clklastevlo != 0 && (($time - clklastevlo) < Twl))
		begin
		    $display ("\n%m");
		    $write("Width (L) ERROR on CLK: Setting output unknown");
		    $display($time);
		    iregq_twl = 1'b1;
		    iregq_twl = #1 1'b0;
		end
		clklastevhi = $time;
	    end
	end

    // check for clk setup/hold violations
    always @(d or posedge dclk)
	// Check only if the cell is not combinational.
	if(iregister != `comb)
	begin
	    // setup violation check
	    if(prev_clk !== dclk && dclk == 1'b1)
	    begin
		if(dlastev != 0 && (($time - dlastev) < Tirsu))
		begin
		    $display ("\n%m");
		    $write("Setup ERROR ON D: Setting output unknown");
		    $display($time);
		    iregq_tis = 1'b1;
		    iregq_tis = #1 1'b0;
		end
		clklastev = $time;
	    end
	    // hold violation check
	    if(prev_d !== d)
	    begin
		if(clklastev !== 0 && (($time - clklastev) < Tirh))
		begin
		    $display ("\n%m");
		    $write("Hold ERROR ON D: Setting output unknown");
		    $display($time);
		    iregq_tih = 1'b1;
		    iregq_tih = #1 1'b0;
		end
		dlastev = $time;
		#0 prev_d = d;
	    end
	    iregq_tsh = iregq_tis || iregq_tih;
	end

    // Simulate the Register.
    wire errflg = (iregq_tsh || iregq_twh || iregq_twl);

    always @(d)
	case (iregister)
	    `comb :     #Ticomb fb = d;
	endcase

    always @(dclk) #0 prev_clk = dclk;
    always @(d or dclk or errflg)
    begin
	case (errflg)
	    0 : case (iregister)
		`ireg :     if(prev_clk !== dclk && dclk == 1'b1) fb <= #Tird d;
		`dblireg :  if(prev_clk !== dclk && dclk == 1'b1) begin
								fb <= #Tird q1;
								q1 <= #Tird d;
								end
		`iltch :    case (prev_clk !== dclk && dclk == 1'b1)
				0 : if (dclk == 1'b1) #Tilat fb = d;
				1 : fb <= #Tird d;
			    endcase
		endcase
	    1 : #Tird fb = 1'bx;
	endcase
    end
endmodule


`timescale 1ps/1ps

module c37km (x, oe, y, fb);
    input x;
    input oe;
    inout y;
    output fb;

    parameter	bsel	= `ninv;

    parameter	Ticomb	= 1000 ,
		Tod	= 2000 ,
		Txz	= 5500 ,
		Tzx	= 5500 ,
		Tsl	= 2000 ,
		slsel	= `fast;

    reg prev_oe;
    reg ytmp;
    reg fbtmp;


    initial
    begin
	prev_oe = oe;
	if (oe == 1'b1)
	    if (bsel == `invt)
		ytmp = ~x;
	    else
		ytmp =  x;
	else
	    ytmp = 1'bz;
	fbtmp = ytmp;
    end

    wire y = ytmp;

    always @(oe) #0 prev_oe = oe;
    always @(y or x or oe)
    begin
	case (prev_oe === oe)
	    0 : case (oe)

		0 : case (slsel)
		    `fast : #Txz ytmp = 1'bz;
		    `slow : #(Txz+Tsl) ytmp = 1'bz;
		endcase

		1 : case (slsel)
		    `fast : case (bsel)
			`invt : #Tzx ytmp = ~x;
			`ninv : #Tzx ytmp =  x;
		    endcase
		    `slow : case (bsel)
			`invt : #(Tzx+Tsl) ytmp = ~x;
			`ninv : #(Tzx+Tsl) ytmp =  x;
		    endcase
		endcase

	    endcase
	    1 : case (oe)
		0 : ytmp = 1'bz;

		1 : case (slsel)
		    `fast : case (bsel)
			`invt : #Tod ytmp = ~x;
			`ninv : #Tod ytmp =  x;
		    endcase
		    `slow : case (bsel)
			`invt : #(Tod+Tsl) ytmp = ~x;
			`ninv : #(Tod+Tsl) ytmp =  x;
		    endcase
		endcase

	    endcase
	endcase
    end

    always @(y)
    begin
	case (y)
	    1'b0 : fbtmp = 1'b0;
	    1'b1 : fbtmp = 1'b1;
	    1'bx : fbtmp = 1'bx;
	    1'bz : fbtmp = 1'bx;
	endcase
    end

    wire fb = fbtmp;

endmodule


`timescale 1ps/1ps

module c37kmux (x, fb) ;
    input x ;
    output fb ;

    parameter	Tsop = 4500;

    reg fb;
    initial fb <= 1'b0;

    always @x #Tsop fb = x;

endmodule


`timescale 1ps/1ps

module c37koreg (as, x, clk, ar, fb, q);
    input as;
    input x;
    input clk;
    input ar;
    output fb;
    output q;

    parameter oregister = `dreg;
    parameter source = `src_ptm;

    parameter	Tclk	= 2000 ,
		Tird	= 0500 ,
		Tilat	= 3500 ,
		Tirsu	= 4000 ,
		Tirh	= 0000 ,
		Tord	= 1000 ,
		Tocomb	= 0000 ,
		Tolat	= 3500 ,
		Torsu	= 1000 ,
		Torh	= 3500 ,
		Tfb	= 0000 ,
		Trst	= 4500 ,
		Tpst	= 4500 ,
		Twl	= 2500 ,
		Twh	= 2500 ,
		Trw	= 1000 ,
		Trr	=10000 ,
		Tpw	= 8000 ,
		Tpr	=10000 ,
		Tirsupt	= 3500 ,
		Tirhpt	= 1000 ,
		Torsupt	= 2500 ,
		Torhpt	= 2500 ,
		cksel	= `nopt;

    reg	regq_tsh, regq_twh, regq_twl;
    reg regq_tpw, regq_tpr, regq_trw, regq_trr;
    reg	prev_clk, q;

    reg regq_ts, regq_th;
    reg prev_x, prev_ar, prev_as;
    time xlastev, clklastev, clklastevhi, clklastevlo, arlastev, aslastev;

    initial
    begin
	regq_tsh = 1'b0; regq_twh = 1'b0; regq_twl = 1'b0;
	regq_tpw = 1'b0; regq_tpr = 1'b0; regq_trw = 1'b0; regq_trr = 1'b0;
	prev_clk = clk;

	regq_ts = 1'b0; regq_th = 1'b0;
	prev_x = x; prev_ar = ar; prev_as = as;
	xlastev = 0; clklastev = 0; clklastevhi = 0; clklastevlo = 0;
	arlastev = 0; aslastev = 0;

	if (oregister == `cmb)
	    q = x;
	else
	    q = 1'b0;
    end

    // Add the clock delay(s)

    wire #Tclk gclk = clk;
    wire dclk = (cksel == `ckpt) ? clk : gclk;

    // check clk pulse width
    always @(dclk)
	// Check only if the cell is not combinational.
	if (oregister != `cmb)
	begin
	    if (dclk == 1'b0)
	    begin
		if ((clklastevhi != 0) && (($time - clklastevhi) < Twh))
		begin
		    $display ("\n%m");
		    $write("CLK Width (H) ERROR: Setting output unknown");
		    $display($time);
		    regq_twh = 1'b1;
		    regq_twh = #1 1'b0;
		end
		clklastevlo = $time;
	    end
	    if (dclk == 1'b1)
	    begin
		if ((clklastevlo != 0) && (($time - clklastevlo) < Twl))
		begin
		    $display ("\n%m");
		    $write("CLK Width (L) ERROR: Setting output unknown");
		    $display($time);
		    regq_twl = 1'b1;
		    regq_twl = #1 1'b0;
		end
		clklastevhi = $time;
	    end
	end

    // check for clk setup/hold violations
    always @(x or posedge dclk)
	// Check if the cell is not combinational.
	if (oregister != `cmb)
	begin // setup violation check
	    if (prev_clk !== dclk && dclk == 1'b1)
	    begin
		if (source == `src_ptm)
		begin

		    if (cksel == `ckpt)
		    begin
			if ((xlastev != 0) && ($time - xlastev) < Torsupt)
			begin
			   $display ("\n%m");
			   $write("Setup ERROR ON X: Setting output unknown");
			   $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end
		    end
		    else
		    begin

			if ((xlastev != 0) && (($time - xlastev) < Torsu))
			begin
			    $display ("\n%m");
			    $write("Setup ERROR ON X: Setting output unknown");
			    $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end

		    end

		end
		else   // Buried macrocell used as input register
		begin

		    if (cksel == `ckpt)
		    begin
			if ((xlastev != 0) && ($time - xlastev) < Tirsupt)
			begin
			   $display ("\n%m");
			   $write("Setup ERROR ON X: Setting output unknown");
			   $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end
		    end
		    else
		    begin

			if ((xlastev != 0) && ($time - xlastev) < Tirsu)
			begin
			   $display ("\n%m");
			   $write("Setup ERROR ON X: Setting output unknown");
			   $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end

		    end

		end
		clklastev = $time;
	    end
	    // hold violation check
	    if (prev_x !== x)
	    begin
		if (source == `src_ptm)
		begin

		    if (cksel == `ckpt)
		    begin
			if ((clklastev != 0) && ($time - clklastev) < Torhpt)
			begin
			    $display ("\n%m");
			    $write("Hold ERROR ON X: Setting output unknown");
			    $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end
		    end
		    else
		    begin

			if ((clklastev != 0) && (($time - clklastev) < Torh))
			begin
			    $display ("\n%m");
			    $write(" Hold ERROR ON X: Setting output unknown");
			    $display($time);
			    regq_th = 1'b1;
			    regq_th = #1 1'b0;
			end

		    end

		end
		else   // Buried macrocell used as input register
		begin

		    if (cksel == `ckpt)
		    begin
			if ((clklastev != 0) && ($time - clklastev) < Tirhpt)
			begin
			    $display ("\n%m");
			    $write("Hold ERROR ON X: Setting output unknown");
			    $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end
		    end
		    else
		    begin

			if ((clklastev != 0) && ($time - clklastev) < Tirh)
			begin
			    $display ("\n%m");
			    $write("Hold ERROR ON X: Setting output unknown");
			    $display($time);
			    regq_ts = 1'b1;
			    regq_ts = #1 1'b0;
			end

		    end

		end
		xlastev = $time;
		#0 prev_x = x;
	    end
	    regq_tsh = regq_ts || regq_th;
	end

    // Check RESET minimum pulse width
    always @(ar)
	if (oregister != `cmb)
	begin
	    if ((ar == 1'b0) && (prev_ar == 1'b1) &&
		(arlastev != 0) && (($time - arlastev) < Trw))
	    begin
		$display ("\n%m");
		$write("Pulse Width ERROR on AR: Setting output unknown");
		$display($time);
		regq_trw = 1'b1;
		regq_trw = #1 1'b0;
	    end
	    arlastev = $time;
	    #0 prev_ar = ar;
	end

    // Check PRESET minimum pulse width
    always @(as)
	if (oregister != `cmb)
	begin
	    if ((as == 1'b0) && (prev_as == 1'b1) &&
		(aslastev != 0) && (($time - aslastev) < Tpw))
	    begin
		$display ("\n%m");
		$write("Pulse Width ERROR on AS: Setting output unknown");
		$display($time);
		regq_tpw = 1'b1;
		regq_tpw = #1 1'b0;
	    end
	    aslastev = $time;
	    #0 prev_as = as;
	end

    // Check for Asynchronous Reset/Preset Recovery violation
    always @(posedge dclk)
	if (oregister != `cmb)
	begin
	    if (ar == 1'b0)
	    begin
		if ((arlastev != 0) && (($time - arlastev) < Trr))
		begin
		    $display ("\n%m");
		    $write("Recovery ERROR on AR: Setting output unknown");
		    $display($time);
		    regq_trr = 1'b1;
		    regq_trr = #1 1'b0;
		end
	    end
	    if (as == 1'b0)
	    begin
		if ((aslastev != 0) && (($time - aslastev) < Tpr))
		begin
		    $display ("\n%m");
		    $write("Recovery ERROR on AS: Setting output unknown");
		    $display($time);
		    regq_tpr = 1'b1;
		    regq_tpr = #1 1'b0;
		end
	    end
	end

    // Simulate the register.
    wire errflg = (regq_tsh || regq_twh || regq_twl
		|| regq_trw || regq_tpw || regq_trr || regq_tpr);

    always @(x)
	case (oregister)
	    `cmb : case (source)
		    `src_ptm : q <= #Tocomb x;
		    `src_adj : $display ("Illegal config: Input combinatorial");
	    endcase
	endcase

    always @(dclk) #0 prev_clk = dclk;
    always @(dclk or x or as or ar or errflg)
    begin
	case (oregister)
	    `cmb : ;
	    default : case (errflg)
		0 : case (ar)
		    0 : case (as)
			0 : case (source)
			    `src_ptm : case (oregister)
				`oltch : case(prev_clk !== dclk && dclk == 1'b1)
				    0 : if (dclk == 1'b1) #Tolat q = x;
				    1 : q <= #Tord x;
				endcase
				`dreg : if (prev_clk !== dclk && dclk == 1'b1)
						 q <= #Tord x;
				`treg : if (prev_clk !== dclk && dclk == 1'b1 &&
					x == 1'b1) q <= #Tord ~q;
			    endcase
			    `src_adj : case (oregister)
				`oltch : case(prev_clk !== dclk && dclk == 1'b1)
				    0 : if (dclk == 1'b1) #Tilat q = x;
				    1 : q <= #Tird x;
				endcase
				`dreg : if (prev_clk !== dclk  && dclk == 1'b1)
						 q <= #Tird x;
				`treg : $display ("Illegal config: Input T-ff");
			    endcase
			endcase
			1 : q <= #Tpst 1'b1;
		    endcase
		    1 : q <= #Trst 1'b0;
		endcase
		1 : case (source)
		    `src_ptm : #Tord q = 1'bx;
		    `src_adj : #Tird q = 1'bx;
		endcase
	    endcase
	endcase
    end

    // Simulate the feedback
    wire #Tfb dq = q;
    wire fb = (source == `src_ptm) ? dq : q;
endmodule


`timescale 1ps/1ps
module c39kcf (din, dout, enr, enw, ckr, ckw, mrb, efb, hfb, pafeb);

    parameter	[45:0] cfgbits		= 46'b0;
    parameter	xcmfClockWthCy		= 100;
    parameter	xcmfClockWthHi		= 100;
    parameter	xcmfClockWthLo		= 100;
    parameter	xcmfDinAtClkWrSetup	= 100;
    parameter	xcmfDinAtClkWrHold	= 100;
    parameter	xcmfEnxAtClockSetup	= 100;
    parameter	xcmfEnxAtClockHold	= 100;
    parameter	xcmfEfbInAtClkRdSetup	= 100;
    parameter	xcmfEfbInAtClkRdHold	= 100;
    parameter	xcmfHfbInAtClkRdSetup	= 100;
    parameter	xcmfHfbInAtClkRdHold	= 100;
    parameter	xcmfEfbInAtClkWrSetup	= 100;
    parameter	xcmfEfbInAtClkWrHold	= 100;
    parameter	xcmfHfbInAtClkWrSetup	= 100;
    parameter	xcmfHfbInAtClkWrHold	= 100;
    parameter	xcmfMrbWthLo		= 100;
    parameter	xcmfMrbRcr		= 100;
    parameter	xcmfRdWrSkewEfb		= 100;
    parameter	xcmfRdWrSkewHfb		= 100;
    parameter	xcmfRdWrSkewPafeb	= 100;
    parameter	xcmfDoutRegReWthHi	= 100;
    parameter	xcmfDoutRegReRcr	= 100;
    parameter	xcmfClkWr2FlagOut	= 100;
    parameter	xcmfClkRd2FlagOut	= 100;
    parameter	xcmfMrb2Output		= 100;
    parameter	xcmfClock2Dout		= 100;
    parameter	xcmfReset2Dout		= 100;

    input [7:0]	din;
    inout [7:0]	dout;
    input	enr;
    input	enw;
    input	ckr;
    input	ckw;
    input	mrb;
    inout	efb;
    inout	hfb;
    output	pafeb;

    reg	[7:0]	VHDL2V_dout;
    reg		VHDL2V_efb;
    reg		VHDL2V_hfb;
    wire[7:0]	dout;
    tri1	mrb;
    wire	efb;
    wire	hfb;
    reg		pafeb;
    reg	[7:0]	memdata;

    reg		full;
    reg		empt;
    reg		half;
    reg		pafl;
    reg		paem;

    wire	wpafl = pafl;
    wire	wpaem = paem;

    reg	[7:0]	dtmp;
    reg	[7:0]	dslice;
    reg	[7:0]	mslice;
    reg	[7:0]	dierr;
    reg	[7:0]	doerr;

    time	ckredge;
    time	ckwedge;
    time	mrbedge;

    integer	wadd;
    integer	radd;
    integer	idx;
    integer	top;

    reg	[7:0]	mem [511:0];
    parameter unk = " Setting output unknown.";
    reg		ckrerr;
    parameter	read_high =
	{"Read clock high width violation:", unk};
    parameter	read_low =
	{"Read clock low width violation:", unk};
    parameter	read_cycle =
	{"Read clock cycle width violation:", unk};
    reg		ckwerr;
    parameter	write_high =
	{"Write clock high width violation:", unk};
    parameter	write_low =
	{"Write clock low width violation:", unk};
    parameter	write_cycle =
	{"Write clock cycle width violation:", unk};
    reg		wdserr;
    parameter	writedata_setup =
	{"Write data setup violation:", unk};
    reg		wdherr;
    parameter	writedata_hold =
	{"Write data hold violation:", unk};
    reg		enrserr;
    parameter	readen_setup =
	{"Read enable setup violation:", unk};
    reg		enrherr;
    parameter	readen_hold =
	{"Read enable hold violation:", unk};
    reg		enwserr;
    parameter	writeen_setup =
	{"Write enable setup violation:", unk};
    reg		enwherr;
    parameter	writeen_hold =
	{"Write enable hold violation:", unk};
    reg		rrcverr;
    parameter	readreset_rcvry =
	{"Read reset recovery violation:", unk};
    reg		wrcverr;
    parameter	writereset_rcvry =
	{"Write reset recovery violation:", unk};
    reg		mrberr;
    parameter	reset_width =
	{"Reset width violation:", unk};
    parameter	write2read_skew1 =
	"Write to read skew insufficient for current cycle empty/full update.";
    parameter	write2read_skew2 =
	"Write to read skew insufficient for current cycle almost empty update";
    parameter	read2write_skew2 =
	"Read to write skew insufficient for current cycle half full update.";
    parameter	read2write_skew3 =
	"Read to write skew insufficient for current cycle almost full update.";
    reg		refserr;
    parameter	refflag_setup =
	"Read clock to E/F flag setup violation.";
    reg		refherr;
    parameter	refflag_hold =
	"E/F flag to read clock hold violation.";
    reg		rhfserr;
    parameter	rhfflag_setup =
	"Read clock to H/F flag setup violation.";
    reg		rhfherr;
    parameter	rhfflag_hold =
	"H/F flag to read clock hold violation.";
    reg		wefserr;
    parameter	wefflag_setup =
	"Write clock to E/F flag setup violation.";
    reg		wefherr;
    parameter	wefflag_hold =
	"E/F flag to write clock hold violation.";
    reg		whfserr;
    parameter	whfflag_setup =
	"Write clock to H/F flag setup violation.";
    reg		whfherr;
    parameter	whfflag_hold =
	"H/F flag to write clock hold violation.";

    initial
    begin
	top = 0;
	idx = 0;
	radd = 0;
	wadd = 0;
	paem = 1'b0;
	pafl = 1'b1;
	half = 1'b0;
	empt = 1'b0;
	full = 1'b1;
	VHDL2V_hfb <= 1'bZ;
	VHDL2V_efb <= 1'bZ;
    end

    always @(posedge ckr)	ckredge = $time;
    always @(posedge ckw)	ckwedge = $time;
    always @(mrb)		mrbedge = $time;

    // check read clock cycle, high and low times.
    always @(ckr)
    begin : p1
	time	clkhi; 
	time	clklo; 
	if (ckr == 1'b 0)
	begin
	    if (clkhi != 0 & $time-clkhi < xcmfClockWthHi)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", read_high);
		$display("Time: ", $time);
		ckrerr <= 1'b 1;	
		ckrerr <= #(1000) 1'b 0;	
	    end
	    clklo = $time;	
	end
	else if (ckr == 1'b 1 )
	begin
	    if (clklo != 0 & $time-clklo < xcmfClockWthLo)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", read_low);
		$display("Time: ", $time);
		ckrerr <= 1'b 1;	
		ckrerr <= #(1000) 1'b 0;	
	    end
	    if (clkhi != 0 & $time-clkhi < xcmfClockWthCy)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", read_cycle);
		$display("Time: ", $time);
		ckrerr <= 1'b 1;	
		ckrerr <= #(1000) 1'b 0;	
	    end
	    clkhi = $time;	
	end
    end

    // check write clock cycle, high and low times.
    always @(ckw)
    begin : p2
	time	clkhi; 
	time	clklo; 
	if (ckw == 1'b 0)
	begin
	    if (clkhi != 0 & $time-clkhi < xcmfClockWthHi)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", write_high);
		$display("Time: ", $time);
		ckwerr <= 1'b 1;	
		ckwerr <= #(1000) 1'b 0;	
	    end
	    clklo = $time;	
	end
	else if (ckw == 1'b 1 )
	begin
	    if (clklo != 0 & $time-clklo < xcmfClockWthLo)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", write_low);
		$display("Time: ", $time);
		ckwerr <= 1'b 1;	
		ckwerr <= #(1000) 1'b 0;	
	    end
	    if (clkhi != 0 & $time-clkhi < xcmfClockWthCy)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", write_cycle);
		$display("Time: ", $time);
		ckwerr <= 1'b 1;	
		ckwerr <= #(1000) 1'b 0;	
	    end
	    clkhi = $time;	
	end
    end

    // check data setup
    wire	d_dckw;
    time	d_dckwedge;
    parameter	 DataSetup =(xcmfDinAtClkWrSetup < 0) ? -xcmfDinAtClkWrSetup :0;
    parameter	wDataSetup = xcmfDinAtClkWrSetup + DataSetup;
    assign #(DataSetup) d_dckw = ckw;
    always @(posedge d_dckw) d_dckwedge = $time;

    always @(din or d_dckwedge)
    begin : p3a
	time	din_ev; 
	if (d_dckwedge == $time)
	    if (din_ev != 0 & $time-din_ev < wDataSetup)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", writedata_setup);
		$display("Time: ", $time);
		wdserr <= 1'b 1;	
		wdserr <= #(1000) 1'b 0;	
	    end
	else
	    din_ev = $time;	
    end

    // check data hold
    wire [7:0]	ddin;
    parameter	 DataHold =(xcmfDinAtClkWrHold < 0) ?  -xcmfDinAtClkWrHold : 0;
    parameter	wDataHold = xcmfDinAtClkWrHold + DataHold;
    assign #(DataHold) ddin = din;

    always @(ddin or ckwedge)
    begin : p3b
	time	clk_ev; 
	if (ckwedge == $time)
	    clk_ev = $time;
	else
	    if (clk_ev != 0 & $time-clk_ev < wDataHold)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", writedata_hold);
		$display("Time: ", $time);
		wdherr <= 1'b 1;	
		wdherr <= #(1000) 1'b 0;	
	    end
    end

    // check read enable setup
    wire	e_dckr;
    time	e_dckredge;
    parameter	 EnSetup =(xcmfEnxAtClockSetup < 0) ? -xcmfEnxAtClockSetup :0;
    parameter	rEnSetup = xcmfEnxAtClockSetup + EnSetup;
    assign #(EnSetup) e_dckr = ckr;
    always @(posedge e_dckr) e_dckredge = $time;

    always @(enr or e_dckredge)
    begin : p4a
	time	enr_ev; 
	if (e_dckredge == $time)
	    if (enr_ev != 0 & $time - enr_ev < rEnSetup)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", readen_setup);
		$display("Time: ", $time);
		enrserr <= 1'b 1;	
		enrserr <= #(1000) 1'b 0;	
	    end
	else
	    enr_ev = $time;	
    end

    // check read enable hold
    wire	denr;
    parameter	 EnHold =(xcmfEnxAtClockHold < 0) ?  -xcmfEnxAtClockHold : 0;
    parameter	rEnHold = xcmfEnxAtClockHold + EnHold;
    assign #(EnHold) denr = enr;

    always @(denr or ckredge)
    begin : p4b
	time	clk_ev; 
	if (ckredge == $time)
	    clk_ev = $time;
	else
	    if (clk_ev != 0 & $time - clk_ev < rEnHold)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", readen_hold);
		$display("Time: ", $time);
		enrherr <= 1'b 1;	
		enrherr <= #(1000) 1'b 0;	
	    end
    end

    // check write enable setup
    wire	e_dckw;
    time	e_dckwedge;
    assign #(EnSetup) e_dckw = ckw;
    always @(posedge e_dckw) e_dckwedge = $time;

    always @(enw or e_dckwedge)
    begin : p5a
	time	enw_ev; 
	if (e_dckwedge == $time)
	    if (enw_ev != 0 & $time - enw_ev < rEnSetup)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", writeen_setup);
		$display("Time: ", $time);
		enwserr <= 1'b 1;	
		enwserr <= #(1000) 1'b 0;	
	    end
	else
	    enw_ev = $time;	
    end

    // check write enable hold
    wire	denw;
    assign #(EnHold) denw = enw;

    always @(denw or ckwedge)
    begin : p5b
	time	clk_ev; 
	if (ckwedge == $time)
	    clk_ev = $time;
	else
	    if (clk_ev != 0 & $time - clk_ev < rEnHold)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", writeen_hold);
		$display("Time: ", $time);
		enwherr <= 1'b 1;	
		enwherr <= #(1000) 1'b 0;	
	    end
    end

    // check reset width
    always @(mrb)
    begin : p6
	time	mrblo; 
	if (mrb == 1'b 0)
	begin
	    mrblo = $time;	
	end
	else
	begin
	    if (mrblo != 0 & $time - mrblo < xcmfMrbWthLo)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", reset_width);
		$display("Time: ", $time);
		mrberr <= 1'b 1;	
		mrberr <= #(1000) 1'b 0;	
	    end
	end
    end

    // check read reset recovery
    always @(mrbedge or ckredge)
    begin : p7
	time	mrblastev; 
	time	ckrlastev; 
	if (mrbedge == $time)
	begin
	    mrblastev = $time;	
	end
	if (mrb == 1'b 1 & ckredge == $time)
	begin
	    if (mrblastev != 0 & $time - mrblastev < xcmfMrbRcr)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", readreset_rcvry);
		$display("Time: ", $time);
		rrcverr <= 1'b 1;	
		rrcverr <= #(1000) 1'b 0;	
	    end
	    ckrlastev = $time;	
	end
    end

    // check write reset recovery
    always @(mrbedge or ckwedge)
    begin : p8
	time	mrblastev; 
	time	ckwlastev; 
	if (mrb == $time)
	begin
	    mrblastev = $time;	
	end
	if (mrb == 1'b 1 & ckwedge == $time)
	begin
	    if (mrblastev != 0 & $time - mrblastev < xcmfMrbRcr)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", writereset_rcvry);
		$display("Time: ", $time);
		wrcverr <= 1'b 1;	
		wrcverr <= #(1000) 1'b 0;	
	    end
	    ckwlastev = $time;	
	end
    end

    // check E/F flag to read clock setup
    wire	f_dckr;
    time	f_dckredge;
    parameter	 fflgSetupR =(xcmfEfbInAtClkRdSetup < 0) ?
			     -xcmfEfbInAtClkRdSetup :0;
    parameter	rfflgSetupR = xcmfEfbInAtClkRdSetup + fflgSetupR;
    assign #(fflgSetupR) f_dckr = ckr;
    always @(posedge f_dckr) f_dckredge = $time;

    always @(f_dckredge or efb)
    begin : p9a
	time	efb_ev; 
	if (cfgbits[1:0] == 2'b10)
	if (f_dckredge == $time)
	    if (efb_ev != 0 & $time - efb_ev < rfflgSetupR)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", refflag_setup);
		$display("Time: ", $time);
		refserr <= 1'b 1;	
		refserr <= #(1000) 1'b 0;	
	    end
	else
	    efb_ev = $time;
    end

    // check H/F flag to read clock setup
    wire	h_dckr;
    time	h_dckredge;
    parameter	 hflgSetupR =(xcmfHfbInAtClkRdSetup < 0) ?
			     -xcmfHfbInAtClkRdSetup :0;
    parameter	rhflgSetupR = xcmfHfbInAtClkRdSetup + hflgSetupR;
    assign #(hflgSetupR) h_dckr = ckr;
    always @(posedge h_dckr) h_dckredge = $time;

    always @(h_dckredge or hfb)
    begin : p9b
	time	hfb_ev; 
	if (cfgbits[1:0] == 2'b10)
	if (h_dckredge == $time)
	    if (hfb_ev != 0 & $time - hfb_ev < rhflgSetupR)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", rhfflag_setup);
		$display("Time: ", $time);
		rhfserr <= 1'b 1;	
		rhfserr <= #(1000) 1'b 0;	
	    end
	else
	    hfb_ev = $time;
    end

    // check E/F flag to read clock hold
    wire	r_efb;
    parameter	 fflgHoldR = (xcmfEfbInAtClkRdHold < 0) ?
			     -xcmfEfbInAtClkRdHold : 0;
    parameter	rfflgHoldR =  xcmfEfbInAtClkRdHold + fflgHoldR;
    assign #(fflgHoldR) r_efb = efb;

    always @(r_efb or ckredge)
    begin : p9c
	time	clk_ev; 
	if (cfgbits[1:0] == 2'b10)
	if (ckredge == $time)
	    clk_ev = $time;	
	else
	    if (clk_ev != 0 & $time - clk_ev < rfflgHoldR)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", refflag_hold);
		$display("Time: ", $time);
		refherr <= 1'b 1;	
		refherr <= #(1000) 1'b 0;	
	    end
    end

    // check H/F flag to read clock hold
    wire	r_hfb;
    parameter	 hflgHoldR = (xcmfHfbInAtClkRdHold < 0) ?
			     -xcmfHfbInAtClkRdHold : 0;
    parameter	rhflgHoldR =  xcmfHfbInAtClkRdHold + hflgHoldR;
    assign #(hflgHoldR) r_hfb = hfb;

    always @(r_hfb or ckredge)
    begin : p9d
	time	clk_ev; 
	if (cfgbits[1:0] == 2'b10)
	if (ckredge == $time)
	    clk_ev = $time;	
	else
	    if (clk_ev != 0 & $time - clk_ev < rhflgHoldR)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", rhfflag_hold);
		$display("Time: ", $time);
		rhfherr <= 1'b 1;	
		rhfherr <= #(1000) 1'b 0;	
	    end
    end

    // check E/F flag to write clock setup
    wire	f_dckw;
    time	f_dckwedge;
    parameter	 fflgSetupW =(xcmfEfbInAtClkWrSetup < 0) ?
			     -xcmfEfbInAtClkWrSetup :0;
    parameter	rfflgSetupW = xcmfEfbInAtClkWrSetup + fflgSetupW;
    assign #(fflgSetupW) f_dckw = ckw;
    always @(posedge f_dckw) f_dckwedge = $time;

    always @(f_dckwedge or efb)
    begin : p10a
	time	efb_ev; 
	if (cfgbits[1:0] == 2'b10)
	if (f_dckwedge == $time)
	    if (efb_ev != 0 & $time - efb_ev < rfflgSetupW)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", wefflag_setup);
		$display("Time: ", $time);
		wefserr <= 1'b 1;	
		wefserr <= #(1000) 1'b 0;	
	    end
	else
	    efb_ev = $time;
    end

    // check H/F flag to write clock setup
    wire	h_dckw;
    time	h_dckwedge;
    parameter	 hflgSetupW =(xcmfHfbInAtClkWrSetup < 0) ?
			     -xcmfHfbInAtClkWrSetup :0;
    parameter	rhflgSetupW = xcmfHfbInAtClkWrSetup + hflgSetupW;
    assign #(hflgSetupW) h_dckw = ckw;
    always @(posedge h_dckw) h_dckwedge = $time;

    always @(h_dckwedge or hfb)
    begin : p10b
	time	hfb_ev; 
	if (cfgbits[1:0] == 2'b10)
	if (h_dckwedge == $time)
	    if (hfb_ev != 0 & $time - hfb_ev < rhflgSetupW)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", whfflag_setup);
		$display("Time: ", $time);
		whfserr <= 1'b 1;	
		whfserr <= #(1000) 1'b 0;	
	    end
	else
	    hfb_ev = $time;	
    end

    // check E/F flag to write clock hold
    wire	w_efb;
    parameter	 fflgHoldW = (xcmfEfbInAtClkWrHold < 0) ?
			     -xcmfEfbInAtClkWrHold : 0;
    parameter	rfflgHoldW =  xcmfEfbInAtClkWrHold + fflgHoldW;
    assign #(fflgHoldW) w_efb = efb;

    always @(w_efb or ckwedge)
    begin : p10c
	time	clk_ev; 
	if (cfgbits[1:0] == 2'b10)
	if (ckwedge == $time)
	    clk_ev = $time;	
	else
	    if (clk_ev != 0 & $time - clk_ev < rfflgHoldW)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", wefflag_hold);
		$display("Time: ", $time);
		wefherr <= 1'b 1;	
		wefherr <= #(1000) 1'b 0;	
	    end
    end

    // check H/F flag to write clock hold
    wire	w_hfb;
    parameter	 hflgHoldW = (xcmfHfbInAtClkWrHold < 0) ?
			     -xcmfHfbInAtClkWrHold : 0;
    parameter	rhflgHoldW =  xcmfHfbInAtClkWrHold + hflgHoldW;
    assign #(hflgHoldW) w_hfb = hfb;

    always @(w_hfb or ckwedge)
    begin : p10d
	time	clk_ev; 
	if (cfgbits[1:0] == 2'b10)
	if (ckwedge == $time)
	    clk_ev = $time;	
	else
	    if (clk_ev != 0 & $time - clk_ev < rhflgHoldW)
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", whfflag_hold);
		$display("Time: ", $time);
		whfherr <= 1'b 1;	
		whfherr <= #(1000) 1'b 0;	
	    end
    end

    // check the skews between read and write for setting the flags
    always @(ckredge or ckwedge)
    begin : p11
	time	ckr_re; 
	time	ckw_re;
	if (cfgbits[1:0] == 2'b01)
	begin
	    if (ckredge == $time)
	    begin
		ckr_re = $time;	
	    end
	    if (ckwedge == $time)
	    begin
		ckw_re = $time;	
	    end
	    if (ckredge == $time & mrb == 1'b 1)
	    begin
		if ($time - ckw_re < xcmfRdWrSkewEfb & efb == 1'b 0)
		begin
		    $display ("\n%m");
		    $write("note: ");
		    $display("%s", write2read_skew1);
		    $display("Time: ", $time);
		end
		if ($time - ckw_re < xcmfRdWrSkewPafeb & paem == 1'b 0)
		begin
		    $display ("\n%m");
		    $write("note: ");
		    $display("%s", write2read_skew2);
		    $display("Time: ", $time);
		end
	    end
	    if (ckwedge == $time & mrb == 1'b 1)
	    begin
		if ($time - ckr_re < xcmfRdWrSkewHfb & hfb == 1'b 0)
		begin
		    $display ("\n%m");
		    $write("note: ");
		    $display("%s", read2write_skew2);
		    $display("Time: ", $time);
		end
		if ($time - ckr_re < xcmfRdWrSkewPafeb & pafl == 1'b 0)
		begin
		    $display ("\n%m");
		    $write("note: ");
		    $display("%s", read2write_skew3);
		    $display("Time: ", $time);
		end
	    end
	end
    end

    // simulate the fifo operations
    always @(mrbedge or ckwedge or ckredge or 
    		ckwerr or enwserr or enwherr or mrberr or wrcverr or
                ckrerr or wdserr or wdherr or enrserr or enrherr or rrcverr)
    begin
	case (cfgbits[3:2])
	    2'b 00: top = 512;
	    2'b 01: top = 1024;
	    2'b 10: top = 2048;
	    2'b 11: top = 4096;
	endcase

	// Condition input with errors
	if (ckwerr | enwserr | enwherr | mrberr | wrcverr | wdserr | wdherr)
	begin
	    dierr = {8{1'bx}};
	end
	else
	begin
	    dierr = din;
	end

	if (mrb == 1'b0)
	begin
	    idx = 0;
	    wadd = 1'b0;
	    radd = 1'b0;
	    doerr = {8{1'b0}};
	end
	else
	begin
	    case (cfgbits[1:0])
	    2'b 01:
	    begin
		if (ckwedge == $time)
		begin
		    if ((idx < top) && (enw == 1'b1) && (full != 1'b0))
		    begin
			idx = idx + 1;
			case (cfgbits[3:2])
			2'b 00:
			begin
			    mem[wadd] = dierr;
			end
			2'b 01:
			begin
			    dslice = mem[wadd/2];
			    case (wadd % 2)
				1: dslice[7:4] = dierr[3:0];
				0: dslice[3:0] = dierr[3:0];
			    endcase
			    mem[wadd/2] = dslice;
			end
			2'b 10:
			begin
			    dslice = mem[wadd/4];
			    case (wadd % 4)
				3: dslice[7:6] = dierr[1:0];
				2: dslice[5:4] = dierr[1:0];
				1: dslice[3:2] = dierr[1:0];
				0: dslice[1:0] = dierr[1:0];
			    endcase
			    mem[wadd/4] = dslice;
			end
			2'b 11:
			begin
			    dslice = mem[wadd/8];
			    dslice[(wadd % 8)] = dierr[0];
			    mem[wadd/8] = dslice;
			end
			endcase
			wadd = wadd + 1'b1;
			if (wadd >= top)
			begin
			    wadd = 1'b0;
			end
		    end
		end
		if (ckredge == $time)
		begin
		    if ((idx > 0)   && (enr == 1'b1) && (empt != 1'b0))
		    begin
			idx = idx - 1;
			doerr = {8{1'b0}};
			case (cfgbits[3:2])
			2'b 00:
			begin
			    doerr = mem[radd];
			end
			2'b 01:
			begin
			    mslice = mem[radd/2];
			    case (radd % 2)
				1: doerr[3:0] = mslice[7:4];
				0: doerr[3:0] = mslice[3:0];
			    endcase
			end
			2'b 10:
			begin
			    mslice = mem[radd/4];
			    case (radd % 4)
				3: doerr[1:0] = mslice[7:6];
				2: doerr[1:0] = mslice[5:4];
				1: doerr[1:0] = mslice[3:2];
				0: doerr[1:0] = mslice[1:0];
			    endcase
			end
			2'b 11:
			begin
			    mslice = mem[radd/8];
			    doerr[0] = mslice[(radd % 8)];
			end
			endcase
			radd = radd + 1'b1;
			if (radd >= top)
			begin
			    radd = 1'b0;
			end
		    end
		end
	    end
	    2'b 10:
	    begin
		if (ckwedge == $time)
		begin
		    if (!(efb == 1'b0 & hfb == 1'b0) & (enw == 1'b1))
		    begin
			case (cfgbits[3:2])
			2'b 00:
			begin
			    mem[wadd] = dierr;
			end
			2'b 01:
			begin
			    dslice = mem[wadd/2];
			    case (wadd % 2)
				1: dslice[7:4] = dierr[3:0];
				0: dslice[3:0] = dierr[3:0];
			    endcase
			    mem[wadd/2] = dslice;
			end
			2'b 10:
			begin
			    dslice = mem[wadd/4];
			    case (wadd % 4)
				3: dslice[7:6] = dierr[1:0];
				2: dslice[5:4] = dierr[1:0];
				1: dslice[3:2] = dierr[1:0];
				0: dslice[1:0] = dierr[1:0];
			    endcase
			    mem[wadd/4] = dslice;
			end
			2'b 11:
			    begin
				dslice = mem[wadd/8];
				dslice[(wadd % 8)] = dierr[0];
				mem[wadd/8] = dslice;
			    end
			endcase
			wadd = wadd + 1'b1;
			if (wadd >= top)
			begin
			    wadd = 1'b0;
			end
		    end
		end
		if (ckredge == $time)
		begin
		    if (!(efb == 1'b0 & hfb == 1'b1) & (enr == 1'b1))
		    begin
			doerr = {8{1'b0}};
			case (cfgbits[3:2])
			2'b 00:
			begin
			    doerr = mem[radd];
			end
			2'b 01:
			begin
			    mslice = mem[radd/2];
			    case (radd % 2)
				1: doerr[3:0] = mslice[7:4];
				0: doerr[3:0] = mslice[3:0];
			    endcase
			end
			2'b 10:
			begin
			    mslice = mem[radd/4];
			    case (radd % 4)
				3: doerr[1:0] = mslice[7:6];
				2: doerr[1:0] = mslice[5:4];
				1: doerr[1:0] = mslice[3:2];
				0: doerr[1:0] = mslice[1:0];
			    endcase
			end
			2'b 11:
			begin
			    mslice = mem[radd/8];
			    doerr[0] = mslice[(radd % 8)];
			end
			endcase
			radd = radd + 1'b1;
			if (radd >= top)
			begin
			    radd = 1'b0;
			end
		    end
		end
	    end
	    default:
		;
	    endcase
	end

	// Condition output with errors
	if(ckrerr | enrserr | enrherr | mrberr | rrcverr)
	begin
	    dtmp = {8{1'bx}};
	end
	else
	begin
	    dtmp = doerr;
	end

	if (mrbedge == $time)
	begin
	    VHDL2V_dout <= #(xcmfReset2Dout) {8{1'b0}};
	end
	else
	begin
	    VHDL2V_dout <= #(xcmfClock2Dout) dtmp;
	end

	case (cfgbits[1:0])
	2'b 01:
	begin
	    if (mrbedge == $time & mrb == 1'b0)
	    begin
		empt <= #(xcmfMrb2Output) 1'b0;
		paem <= #(xcmfMrb2Output) 1'b0;
		half <= #(xcmfMrb2Output) 1'b1;
		full <= #(xcmfMrb2Output) 1'b1;
		pafl <= #(xcmfMrb2Output) 1'b1;
	    end
	    else
	    begin
		if (ckredge == $time)
		begin
		    if (idx <= 0)
		    begin
			empt <= #(xcmfClkRd2FlagOut) 1'b0;
		    end
		    else
		    begin
			empt <= #(xcmfClkRd2FlagOut) 1'b1;
		    end
		    if (idx >= top / 2)
		    begin
			half <= #(xcmfClkWr2FlagOut) 1'b0;
		    end
		    else
		    begin
			half <= #(xcmfClkWr2FlagOut) 1'b1;
		    end
		    if (((idx <= (cfgbits[45:35])) && (top == 4096)) ||
			((idx <= (cfgbits[45:36])) && (top == 2048)) ||
			((idx <= (cfgbits[45:37])) && (top == 1024)) ||
			((idx <= (cfgbits[45:38])) && (top ==  512)))
		    begin
			paem <= #(xcmfClkRd2FlagOut) 1'b0;
		    end
		    else
		    begin
			paem <= #(xcmfClkRd2FlagOut) 1'b1;
		    end
		end
		if (ckwedge == $time)
		begin
		    if (idx >= top)
		    begin
			full <= #(xcmfClkWr2FlagOut) 1'b0;
		    end
		    else
		    begin
			full <= #(xcmfClkWr2FlagOut) 1'b1;
		    end
		    if (idx >= top / 2)
		    begin
			half <= #(xcmfClkWr2FlagOut) 1'b0;
		    end
		    else
		    begin
			half <= #(xcmfClkWr2FlagOut) 1'b1;
		    end
		    if (((top - idx <= (cfgbits[45:35])) && (top == 4096)) ||
			((top - idx <= (cfgbits[45:36])) && (top == 2048)) ||
			((top - idx <= (cfgbits[45:37])) && (top == 1024)) ||
			((top - idx <= (cfgbits[45:38])) && (top ==  512)))
		    begin
			pafl <= #(xcmfClkWr2FlagOut) 1'b0;
		    end
		    else
		    begin
			pafl <= #(xcmfClkWr2FlagOut) 1'b1;
		    end
		end
	    end
	end
	default:
	    ;
	endcase
    end

    always @(half or full or empt or pafl or paem)
    begin
	case (cfgbits[1:0])
	2'b 01:
	begin
	    VHDL2V_hfb <= half;
	    VHDL2V_efb <= full & empt;
	    pafeb <= pafl & paem & full & empt;
	end
	default:
	begin
	    VHDL2V_hfb <= 1'bZ;
	    VHDL2V_efb <= 1'bZ;
	end
	endcase
    end

    assign dout = VHDL2V_dout;
    assign hfb  = VHDL2V_hfb;
    assign efb  = VHDL2V_efb;

endmodule // c39kcf


`timescale 1ps/1ps
module c39kck (clk, nios, lock, glclk);

    parameter	[63:0]  cfgbits		= 64'b0;
    parameter	xplPulseWthLo		= 100;
    parameter	xplPulseWthHi		= 100;
    parameter	xplMinInputDuty		=  30;
    parameter	xplMaxInputDuty		=  70;
    parameter	xplJitterUncertainty	= 100;
    parameter	xplZeroFBUncertainty	= 100;
    parameter	xplTreeFBUncertainty	= 100;
    parameter	xplMinPinClkPeriod	= 100;
    parameter	xplMaxPinClkPeriod	= 100;
    parameter	xplLockTime		= 100;
    parameter	xplClockTreeOffset	= 100;
    parameter	xckPin2GClkDirect	= 100;
    parameter	xplSpreadFreqPercent	= 1.0;
    parameter	xplSpreadFreqKHz	= 1.0;

    input [3:0]	clk;
    reg   [3:0]	tmpglclk;
    input	nios;
    output	lock;
    output[3:0]	glclk;
    reg		lock;
    reg   [3:0]	glclk;

    reg		feedback;
    reg		int_fdbk;
    reg		tmp_fdbk;
    reg		vco;
    reg		plllock;
    reg		syncb;
    time	cyc;
    integer	mult;
    reg [3:0]	pllclk;
    wire[3:0]	xclk;
    reg [7:0]	pllout;
    reg		tracking;
    reg		speedup;
    reg		slowdown;
    reg		killvco;
    reg		switch;
    time	ckwidth;
    time	fbwidth;
    time	kpwidth;
    time	fbevent;
    time	clkedge;

    reg [8:0]	divide [3:0];
    reg [8:0]	phase  [3:0];
    reg	[3:0]	fourbits;
    reg	[2:0]	threebits;

    // To use the real silicon time, replace 3000000 with xplLockTime.
    parameter	simLockTime	= 3000000;

    parameter	clk_high	= "Clock high width violation.";
    parameter	clk_low		= "Clock low width violation.";
    parameter	clk_cycle_min	= "Clock cycle minimum width violation.";
    parameter	clk_cycle_max	= "Clock cycle maximum width violation.";
    parameter	clk_duty_cycle	= "Clock duty cycle violation.";
    parameter	JitterSpec	= 0.01;

    initial
    begin
	syncb = 1'b1;	
	plllock = 1'b0;	
	feedback = 1'b0;	
	int_fdbk = 1'b0;
	tmp_fdbk = 1'b0;
	vco = 1'b0;
	cyc = 0;
	ckwidth = 0;
	fbwidth = 0;
	kpwidth = 0;
	switch = 1'b0;
    end

    // check clk cycle, high and low times.
    always @(clk[0])
    begin : CLOCK_CHECK
	time	clkhi; 
	time	clklo; 
	if (cfgbits[0] == 1'b1)
	begin
	    if (clk[0] == 1'b0)
	    begin
		if (~(clkhi == 0 | $time-clkhi >= xplPulseWthHi))
		begin
		    $display ("\n%m");
		    $write("failure: ");
		    $display("%s", clk_high);
		    $finish;
		end
		clklo = $time;	
	    end
	    else if (clk[0] == 1'b1)
	    begin
		if (~(clklo == 0 | $time-clklo >= xplPulseWthLo))
		begin
		    $display ("\n%m");
		    $write("failure: ");
		    $display("%s", clk_low);
		    $finish;
		end
		if (~(clkhi == 0 | $time-clkhi >= xplMinPinClkPeriod))
		begin
		    $display ("\n%m");
		    $write("failure: ");
		    $display("%s", clk_cycle_min);
		    $finish;
		end
		if (~(clkhi == 0 | $time-clkhi <= xplMaxPinClkPeriod))
		begin
		    $display ("\n%m");
		    $write("failure: ");
		    $display("%s", clk_cycle_max);
		    $finish;
		end
		// Check the duty cycle
		if (((clklo > 0) & (clkhi > 0)) &
		    (((clklo - clkhi)*100/($time - clkhi) < xplMinInputDuty) ||
		     ((clklo - clkhi)*100/($time - clkhi) > xplMaxInputDuty)))
		 begin
		    $display ("\n%m");
		    $write("error: ");
		    $display("%s", clk_duty_cycle);
		 end
		clkhi = $time;	
	    end
	end
    end

    // feedback select
    always @(clk[1] or int_fdbk)
    begin
	if (cfgbits[0] == 1'b1)
	begin
	    case (cfgbits[5:4])
	    2'b 11:
	    begin
		feedback <= 1'b0;	
		$display ("\n%m");
		$write("failure: ");
		$display("Illegal PLL feedback select.");
		$finish;
	    end
	    2'b 10: feedback <= clk[1];	
	    2'b 01: feedback <= int_fdbk;
	    2'b 00: feedback <= int_fdbk;
	    endcase
	end
    end

    time fbkedge;
    integer i;
    always @(clk[0])		clkedge = $time;
    always @(posedge feedback)	fbkedge = $time;


    time ckevent;
    initial ckevent = 0;
    always @(posedge clk[0])
    begin : CLOCK_WIDTH
	if ((ckwidth == 0) || ($time != ckevent))
	begin
	    kpwidth = ckwidth;
	    ckwidth = $time - ckevent;
	    ckevent = $time;
	end
    end

    always @(posedge feedback)
    begin : FEEDBACK_WIDTH
	fbwidth = $time - fbevent;
	fbevent = $time;
    end

    always @(clkedge or fbkedge)
    begin

	if (cfgbits[0] == 1'b1)
	begin
	    case (cfgbits[5:4])
	    2'b 10 : mult = 1'b1;
	    default:
		case (cfgbits[3:1])
		3'b 111: mult = 3'b   110;	
		3'b 110: mult = 3'b   101;	
		3'b 101: mult = 2'b    11;	
		3'b 100: mult = 5'b 10000;	
		3'b 011: mult = 4'b  1000;	
		3'b 010: mult = 3'b   100;
		3'b 001: mult = 2'b    10;
		3'b 000: mult = 1'b     1;
		endcase
	    endcase

	    if (fbkedge == $time)
	    begin
		if ((((ckwidth-fbwidth > ckwidth*JitterSpec)  ||
		      (fbwidth-ckwidth > ckwidth*JitterSpec)) &&
			(plllock == 1'b1)) ||
		     ((ckwidth-kpwidth > ckwidth*JitterSpec)  ||
		      (kpwidth-ckwidth > ckwidth*JitterSpec)) ||
			(fbevent == fbwidth))
		begin
		    plllock <= 1'b0;	
		    syncb   <= 1'b1;	
		end
	    end

	    if (((clkedge == $time) && (clk[0] == 1'b1)) || (fbkedge == $time))
	    begin
	    	if (fbkedge == $time && $time > 0)
		    switch <= 1'b1;
		if (switch == 1'b0)
		begin
		    speedup  <= 1'b0;
		    slowdown <= 1'b0;
		end
		else if (fbkedge == $time)
		begin
		    if (ckwidth > fbwidth)
		    begin
			speedup  <= 1'b0;
			slowdown <= 1'b1 && syncb;
		    end
		    else if (ckwidth < fbwidth)
		    begin
			speedup  <= 1'b1 && syncb;
			slowdown <= 1'b0;
		    end
		    else
		    begin
			speedup  <= 1'b0;
			slowdown <= 1'b0;
			#(simLockTime/10);
			syncb   <= 1'b0;
			#(simLockTime*9/10);
			plllock <= 1'b1;
		    end
		end
	    end
	end
    end

    // Let the VCO run free (at 145 MHz. initially).
    time vco_width;
    initial vco_width = 6875;
    always
    begin : VCO_GENERATION
	integer vco_i;
	if (cfgbits[0] == 1'b 1)
	begin
	    if      ((speedup == 1'b1)  && (slowdown == 1'b0))
		if (ckwidth + 1000 < fbwidth)
		    vco_width = vco_width - 100;
		else
		    vco_width = vco_width - 1;
	    else if ((speedup == 1'b0)  && (slowdown == 1'b1))
		if (ckwidth - 1000 > fbwidth)
		    vco_width = vco_width + 100;
		else
		    vco_width = vco_width + 1;
	    else if ((speedup == 1'b0)  && (slowdown == 1'b0) && (ckwidth > 0))
		vco_width = ckwidth/(ckwidth/(vco_width - 5));

	    cyc <= vco_width / 2;	

	    for (vco_i = 1; vco_i <= 32; vco_i = vco_i + 1)
	    begin
		#(vco_width/2);
		vco <= ~vco;	
	    end
	    if (killvco)
		@ ( killvco ) 
		$stop;
	end
	else
	begin
	    vco <= 1'b 0;	
	    wait (0);
	end
    end

    wire lock_detect;
    assign lock_detect = (tracking | (cfgbits[5:4] !== 2'b10)) ? plllock : 1'b0;

    // Stop the VCO if the input clock is > 2X too slow after it has locked.
    always @(vco or clkedge)
    begin : VCO_KILL
    	time ckevent;
	if (clkedge == $time)
	    ckevent <= $time;
	if ($time-ckevent > 2 * xplMaxPinClkPeriod && lock_detect == 1'b1)
	    killvco <= 1'b1;
	else
	    killvco <= 1'b0;
    end

    always @(lock_detect or nios)
    begin
	if (cfgbits[0] == 1'b1)
	begin
	    case (cfgbits[42])
	    1'b1: lock <= lock_detect;	
	    1'b0: lock <= nios;	
	    endcase
	end
    end

    // VCO Frequency Check
    always @(posedge vco)
    begin : VCO_CHK
	parameter tmax = 10000;			// Min frequency = 100 MHz
	parameter tmin =  3750;			// Max frequency = 266 MHz
	time ckhi;
	if (cfgbits[0] == 1'b1)
	begin
	    if (syncb === 1'b0)
	    begin
		if (((($time - ckhi) < tmin) | (($time - ckhi) > tmax))
		    & ($time !== ckhi))
		begin
		    $write("warning: ");
		    $display("VCO frequency is outside its operating range.");
		    $display("Time: ", $time);
		end
	    end
	    ckhi = $time;  
	end
    end

    always @(vco)
    begin : process_2
	time	width;
	time	edges;
	if (cfgbits[0] == 1'b1)
	begin
	    if ($time == 0)
	    begin
		width <= $time;	
		edges <= $time;
	    end

	    if (edges < $time)
	    begin
		width <= $time - edges;	
		edges <= $time;	
		pllout[7] <= #(width * 3 / 4) ~vco;
		pllout[6] <= #(width * 2 / 4) ~vco;
		pllout[5] <= #(width * 1 / 4) ~vco;
		pllout[4] <= #(width * 0 / 4) ~vco;
		pllout[3] <= #(width * 3 / 4)  vco;
		pllout[2] <= #(width * 2 / 4)  vco;
		pllout[1] <= #(width * 1 / 4)  vco;
		pllout[0] <= #(width * 0 / 4)  vco;
	    end
	end
    end

    initial
    begin : process_3
	integer i;
	if (cfgbits[0] == 1'b1)
	begin
	    for (i = 0; i <= 3; i = i + 1)
	    begin
		case (i)
		0: begin
		    fourbits = cfgbits[21:18]; threebits = cfgbits[ 8: 6];
		end
		1: begin
		    fourbits = cfgbits[26:23]; threebits = cfgbits[11: 9];
		end
		2: begin
		    fourbits = cfgbits[31:28]; threebits = cfgbits[14:12];
		end
		3: begin
		    fourbits = cfgbits[36:33]; threebits = cfgbits[17:15];
		end
		endcase
		if (cfgbits[22 + i * 5] == 1'b 1)
		begin
		    divide[i] <= 1;
		    if      (fourbits == 4'b 0110)
			phase[i] <= 315;
		    else if (fourbits == 4'b 0101 )
			phase[i] <= 270;
		    else if (fourbits == 4'b 0100 )
			phase[i] <= 225;
		    else if (fourbits == 4'b 0011 )
			phase[i] <= 180;
		    else if (fourbits == 4'b 0010 )
			phase[i] <= 135;
		    else if (fourbits == 4'b 0001 )
			phase[i] <=  90;
		    else if (fourbits == 4'b 0000 )
			phase[i] <=  45;
		    else
		    begin
			$display ("\n%m");
			$write("failure: ");
			$display("Illegal phase and divide select.");
			$finish;
		    end
		end
		else
		begin
		    if      (threebits == 3'b 111)
			divide[i] <= 6;
		    else if (threebits == 3'b 110 )
			divide[i] <= 5;
		    else if (threebits == 3'b 101 )
			divide[i] <= 3;
		    else if (threebits == 3'b 100 )
			divide[i] <= 16;
		    else if (threebits == 3'b 011 )
			divide[i] <= 8;
		    else if (threebits == 3'b 010 )
			divide[i] <= 4;
		    else if (threebits == 3'b 001 )
			divide[i] <= 2;
		    else if (threebits == 3'b 000 )
			divide[i] <= 1;

		    if      (fourbits == 4'b 1110)
			phase[i] <=  315;
		    else if (fourbits == 4'b 1101 )
			phase[i] <=  270;
		    else if (fourbits == 4'b 1100 )
			phase[i] <=  225;
		    else if (fourbits == 4'b 1011 )
			phase[i] <=  180;
		    else if (fourbits == 4'b 1010 )
			phase[i] <=  135;
		    else if (fourbits == 4'b 1001 )
			phase[i] <=   90;
		    else if (fourbits == 4'b 1000 )
			phase[i] <=   45;
		    else if (fourbits == 4'b 0000 )
			phase[i] <=    0;
		    else
		    begin
			$display ("\n%m");
			$write("failure: ");
			$display("Illegal phase select.");
			$finish;
		    end
		end
	    end
	end
    end
    
    // Generate 4 clocks depending on the phase.
    assign xclk[3] =phase[3] === 315 ? pllout[7] : 
		    phase[3] === 270 ? pllout[6] : 
		    phase[3] === 225 ? pllout[5] : 
		    phase[3] === 180 ? pllout[4] : 
		    phase[3] === 135 ? pllout[3] : 
		    phase[3] ===  90 ? pllout[2] : 
		    phase[3] ===  45 ? pllout[1] : 
		    phase[3] ===   0 ? pllout[0] : 0; 
    assign xclk[2] =phase[2] === 315 ? pllout[7] : 
		    phase[2] === 270 ? pllout[6] : 
		    phase[2] === 225 ? pllout[5] : 
		    phase[2] === 180 ? pllout[4] : 
		    phase[2] === 135 ? pllout[3] : 
		    phase[2] ===  90 ? pllout[2] : 
		    phase[2] ===  45 ? pllout[1] : 
		    phase[2] ===   0 ? pllout[0] : 0; 
    assign xclk[1] =phase[1] === 315 ? pllout[7] : 
		    phase[1] === 270 ? pllout[6] : 
		    phase[1] === 225 ? pllout[5] : 
		    phase[1] === 180 ? pllout[4] : 
		    phase[1] === 135 ? pllout[3] : 
		    phase[1] ===  90 ? pllout[2] : 
		    phase[1] ===  45 ? pllout[1] : 
		    phase[1] ===   0 ? pllout[0] : 0; 
    assign xclk[0] =phase[0] === 315 ? pllout[7] : 
		    phase[0] === 270 ? pllout[6] : 
		    phase[0] === 225 ? pllout[5] : 
		    phase[0] === 180 ? pllout[4] : 
		    phase[0] === 135 ? pllout[3] : 
		    phase[0] ===  90 ? pllout[2] : 
		    phase[0] ===  45 ? pllout[1] : 
		    phase[0] ===   0 ? pllout[0] : 0; 

    //  Apply the divide amount to the clocks.
    always @(posedge vco)
    begin
	if ($time > 0)
	begin
	    tmp_fdbk <= 1'b 1;	
	    #( mult * cyc ); 
	    tmp_fdbk <= 1'b 0;	
	    #( (mult - 1'b 1) * cyc ); 
	end
    end

    always @(posedge xclk[3])
    begin
	if ($time > 0)
	begin
	    pllclk[3] <= 1'b 1;	
	    #( divide[3] * cyc ); 
	    pllclk[3] <= 1'b 0;	
	    #( (divide[3] - 1'b 1) * cyc ); 
	end
    end

    always @(posedge xclk[2])
    begin
	if ($time > 0)
	begin
	    pllclk[2] <= 1'b 1;	
	    #( divide[2] * cyc ); 
	    pllclk[2] <= 1'b 0;	
	    #( (divide[2] - 1'b 1) * cyc ); 
	end
    end

    always @(posedge xclk[1])
    begin
	if ($time > 0)
	begin
	    pllclk[1] <= 1'b 1;	
	    #( divide[1] * cyc ); 
	    pllclk[1] <= 1'b 0;	
	    #( (divide[1] - 1'b 1) * cyc ); 
	end
    end

    always @(posedge xclk[0])
    begin
	if ($time > 0)
	begin
	    pllclk[0] <= 1'b 1;	
	    #( divide[0] * cyc ); 
	    pllclk[0] <= 1'b 0;	
	    #( (divide[0] - 1'b 1) * cyc ); 
	end
    end

    // global clock output mux
    always @(pllclk or clk)
    begin : GEN_CLOCK
    	integer i;
	for (i = 3; i >= 0; i = i - 1)
	    if (cfgbits[38 + i] == 1'b1)
`ifdef __VERIWELL__
		if (cfgbits[0] == 1'b1)
		    tmpglclk[i]  = pllclk[i];	
`else
		if (cfgbits[0] == 1'b1)
		    tmpglclk[i] <= pllclk[i];	
`endif
		else
		begin
		    $display ("\n%m");
		    $write("failure: ");
		    $display("PLL powered down, no output signal available.");
		    $finish;
		end
	    else
`ifdef __VERIWELL__
		tmpglclk[i]  = clk[i];	
`else
		tmpglclk[i] <= clk[i];	
`endif
    end

    //  compensate for external feedback
    always @(tmpglclk or fbkedge or clkedge or tmp_fdbk)
    begin : EXCOMP
	time ckevent;
	time half;
	time var;
	time delay;
	if (cfgbits[0] === 1'b1)
	begin
	    if ((clkedge == $time) && (clk[0] == 1'b1))
		ckevent = $time;	
	    if ((clkedge == $time) && (clk[0] == 1'b0))
		half = $time - ckevent;	

	    if (syncb === 1'b 1)
	    begin
		if (fbkedge == $time)
		    if ($time - ckevent < half)
			var = 2 * half - ($time - ckevent);	
		    else
			var = 3 * half - ($time - ckevent);	
		glclk    <= tmpglclk;
		int_fdbk <= tmp_fdbk;
		tracking <= 1'b0;	
	    end
	    else
	    begin
		if (cfgbits[5:4] === 2'b10)
		begin
		    if (fbkedge == $time)
			if ($time - ckevent > half)
			    if (~tracking & (2 * half - ($time - ckevent) > 20))
				var = var + 20;
			    else
			    begin
				if (($time - ckevent) != 0)
				    var = var + 1;	
				tracking <= 1'b1;	
			    end
			else
			    if (~tracking & (($time - ckevent) > 20))
				var = var - 20;
			    else
			    begin
				if (($time - ckevent) != 0)
				    var = var - 1;	
				tracking <= 1'b1;	
			    end
		    glclk <= #(var) tmpglclk;
		end
		else
		begin
		    int_fdbk <= #(var - half) tmp_fdbk;
		    if      (cfgbits[5:4] === 2'b00)
		    	delay <= xckPin2GClkDirect;
		    else if (cfgbits[5:4] === 2'b01)
		    	delay <= 2*half + xckPin2GClkDirect -xplClockTreeOffset;
		    glclk    <= #(var - half + delay) tmpglclk;
		    tracking <= 1'b1;
		end
	    end
	end
	else
	    glclk <= #(xckPin2GClkDirect) tmpglclk;
    end

endmodule // module c39kck


`timescale 1ps/1ps
module c39kcm (din_a, din_b, addr_a, addr_b, we_a, we_b, iclk_a, iclk_b, oclk_a,
oclk_b, reset_a, reset_b, addr_matchb, dout_a, dout_b);

    parameter	[45:0] cfgbits			= 46'b0;
    parameter	xcmReadAddrWthHi		= 100;
    parameter	xcmWritAddrWthHi		= 100;
    parameter	xcmWriEnaWthHi			= 100;
    parameter	xcmAddrAtWriEnaFallSetup	= 100;
    parameter	xcmAddrAtWriEnaRiseSetup	= 100;
    parameter	xcmAddrAtWriEnaFallHold		= 100;
    parameter	xcmDinAtWriEnaFallSetup		= 100;
    parameter	xcmDinAtWriEnaFallHold		= 100;
    parameter	xcmAddr2DoutRegD		= 100;
    parameter	xcmWriEna2DoutRegD		= 100;
    parameter	xcmDin2DoutRegD			= 100;
    parameter	xcmDoutRegD2Dout		= 100;
    parameter	xcmClkInWthCy			= 100;
    parameter	xcmClkInWthHi			= 100;
    parameter	xcmClkInWthLo			= 100;
    parameter	xcmAddrAtClkInSetup		= 100;
    parameter	xcmAddrAtClkInHold		= 100;
    parameter	xcmWriEnaAtClkInSetup		= 100;
    parameter	xcmWriEnaAtClkInHold		= 100;
    parameter	xcmDinAtClkInSetup		= 100;
    parameter	xcmDinAtClkInHold		= 100;
    parameter	xcmClkIn2DoutRegD		= 100;
    parameter	xcmDoutRegCkWthCy		= 100;
    parameter	xcmDoutRegCkWthHi		= 100;
    parameter	xcmDoutRegCkWthLo		= 100;
    parameter	xcmDoutRegSetup			= 100;
    parameter	xcmDoutRegHold			= 100;
    parameter	xcmDoutRegReWthHi		= 100;
    parameter	xcmDoutRegReRcr			= 100;
    parameter	xcmReset2Dout			= 100;
    parameter	xcmClkOut2Dout			= 100;
    parameter	xcmAddrTransDetect		= 800;

    input [7:0]	din_a;
    input [7:0]	din_b;
    input[11:0]	addr_a;
    input[11:0]	addr_b;
    input	we_a;
    input	we_b;
    input	iclk_a;
    input	iclk_b;
    input	oclk_a;
    input	oclk_b;
    input	reset_a;
    input	reset_b;
    output	addr_matchb;
    output[7:0]	dout_a;
    output[7:0]	dout_b;

    reg		addr_matchb;

    reg	[11:0]	atmp_a;
    reg	[11:0]	atmp_b;
    reg	[7:0]	dtin_a;
    reg	[7:0]	dtin_b;
    reg	[7:0]	dtout_a;
    reg	[7:0]	dtout_b;
    reg	[7:0]	cdout_a;
    reg	[7:0]	cdout_b;
    reg		wtmp_a;
    reg		wtmp_b;

    reg [7:0]	mem [511:0];
    integer	vect_a;
    integer	vect_b;
    reg	[7:0]	data_a;
    reg	[7:0]	data_b;
    reg		atd_a;
    reg		atd_b;

    reg	[7:0]	dslice_a;
    reg	[7:0]	dslice_b;
    reg	[7:0]	mslice_a;
    reg	[7:0]	mslice_b;

    parameter	unk = " Setting output unknown.";
    reg		iclkerr_a;
    parameter	iclk_width_a =
    {"Input clock A cycle width violation:", unk};
    parameter	iclk_low_a =
    {"Input clock A low width violation:", unk};
    parameter	iclk_high_a =
    {"Input clock A high width violation:", unk};
    reg		aserr_a;
    parameter	addr2iclk_setup_a =
    {"Address A to input clock setup violation:", unk};
    reg		aherr_a;
    parameter	addr2iclk_hold_a =
    {"Input clock to address A hold violation:", unk};
    reg		wserr_a;
    parameter	write2iclk_setup_a =
    {"Write A to clock setup violation:", unk};
    reg		wherr_a;
    parameter	write2iclk_hold_a =
    {"Clock to write A hold violation:", unk};
    reg		dserr_a;
    parameter	data2iclk_setup_a =
    {"Data A to clock setup violation:", unk};
    reg		dherr_a;
    parameter	data2iclk_hold_a =
    {"Clock to data A hold violation:", unk};
    reg		wrwerr_a;
    parameter	write_width_a =
    {"Minimum write width A violation:", unk};
    reg		wcycerr_a;
    parameter	writeaddr_cycle_a =
    {"Minimum write cycle A violation:", unk};
    reg		rcycerr_a;
    parameter	readaddr_cycle_a =
    {"Minimum read cycle A violation:", unk};
    reg		awserr_a;
    parameter	addr2westart_setup_a =
    {"Address to we A start setup violation:", unk};
    parameter	addr2weend_setup_a =
    {"Address to we A end setup violation:", unk};
    reg		awherr_a;
    parameter	addr2we_hold_a =
    {"We to address A hold violation:", unk};
    reg		dwserr_a;
    parameter	data2we_setup_a =
    {"Data A to we setup violation:", unk};
    reg		dwherr_a;
    parameter	data2we_hold_a =
    {"We to data A hold violation:", unk};
    reg		oclkerr_a;
    parameter	outputclock_width_a =
    {"Output clock A cycle width violation:", unk};
    parameter	outputclock_low_a =
    {"Output clock A low width violation:", unk};
    parameter	outputclock_high_a =
    {"Output clock A high width violation:", unk};
    reg		rcverr_a;
    parameter	outreg_rcvry_a =
    {"Output reg. A reset recovery violation:", unk};
    reg		rsterr_a;
    parameter	reset_width_a =
    {"Reset A width violation:", unk};
    reg		oserr_a;
    parameter	data2oclk_setup_a =
    {"Data to output clock setup violation:", unk};
    parameter	addr2oclk_setup_a =
    {"Address to output clock setup violation:", unk};
    parameter	we2oclk_setup_a =
    {"WE to output clock setup violation:", unk};
    parameter	iclk2oclk_setup_a =
    {"In clock to out clock setup violation:", unk};
    reg		oherr_a;
    parameter	data2oclk_hold_a =
    {"Output clock to data hold violation:", unk};
    parameter	addr2oclk_hold_a =
    {"Output clock to address hold violation:", unk};
    parameter	we2oclk_hold_a =
    {"Output clock to WE hold violation:", unk};
    parameter	iclk2oclk_hold_a =
    {"Out clock to in clock hold violation:", unk};
    reg		iclkerr_b;
    parameter	iclk_width_b =
    {"Input clock B cycle width violation:", unk};
    parameter	iclk_low_b =
    {"Input clock B low width violation:", unk};
    parameter	iclk_high_b =
    {"Input clock B high width violation:", unk};
    reg		aserr_b;
    parameter	addr2iclk_setup_b =
    {"Address B to input clock setup violation:", unk};
    reg		aherr_b;
    parameter	addr2iclk_hold_b =
    {"Input clock to address B hold violation:", unk};
    reg		wserr_b;
    parameter	write2iclk_setup_b =
    {"Write B to clock setup violation:", unk};
    reg		wherr_b;
    parameter	write2iclk_hold_b =
    {"Clock to write B hold violation:", unk};
    reg		dserr_b;
    parameter	data2iclk_setup_b =
    {"Data B to clock setup violation:", unk};
    reg		dherr_b;
    parameter	data2iclk_hold_b =
    {"Clock to data B hold violation:", unk};
    reg		wrwerr_b;
    parameter	write_width_b =
    {"Minimum write width B violation:", unk};
    reg		wcycerr_b;
    parameter	writeaddr_cycle_b =
    {"Minimum write cycle B violation:", unk};
    reg		rcycerr_b;
    parameter	readaddr_cycle_b =
    {"Minimum read cycle B violation:", unk};
    reg		awserr_b;
    parameter	addr2westart_setup_b =
    {"Address to we B start setup violation:", unk};
    parameter	addr2weend_setup_b =
    {"Address to we B end setup violation:", unk};
    reg		awherr_b;
    parameter	addr2we_hold_b =
    {"We to address B hold violation:", unk};
    reg		dwserr_b;
    parameter	data2we_setup_b =
    {"Data B to we setup violation:", unk};
    reg		dwherr_b;
    parameter	data2we_hold_b =
    {"We to data B hold violation:", unk};
    reg		oclkerr_b;
    parameter	outputclock_width_b =
    {"Output clock B cycle width violation:", unk};
    parameter	outputclock_low_b =
    {"Output clock B low width violation:", unk};
    parameter	outputclock_high_b =
    {"Output clock B high width violation:", unk};
    reg		rcverr_b;
    parameter	outreg_rcvry_b =
    {"Output reg. B reset recovery violation:", unk};
    reg		rsterr_b;
    parameter	reset_width_b =
    {"Reset B width violation:", unk};
    reg		oserr_b;
    parameter	data2oclk_setup_b =
    {"Data to output clock setup violation:", unk};
    parameter	addr2oclk_setup_b =
    {"Address to output clock setup violation:", unk};
    parameter	we2oclk_setup_b =
    {"WE to output clock setup violation:", unk};
    parameter	iclk2oclk_setup_b =
    {"In clock to out clock setup violation:", unk};
    reg		oherr_b;
    parameter	data2oclk_hold_b =
    {"Output clock to data hold violation:", unk};
    parameter	addr2oclk_hold_b =
    {"Output clock to address hold violation:", unk};
    parameter	we2oclk_hold_b =
    {"Output clock to WE hold violation:", unk};
    parameter	iclk2oclk_hold_b =
    {"Out clock to in clock hold violation:", unk};

    time			iclkedge_a;
    always @(posedge iclk_a)	iclkedge_a = $time;
    time			iclkedge_b;
    always @(posedge iclk_b)	iclkedge_b = $time;
    time			oclkedge_a;
    always @(posedge oclk_a)	oclkedge_a = $time;
    time			oclkedge_b;
    always @(posedge oclk_b)	oclkedge_b = $time;
    time			weedge_a;
    always @(negedge we_a)	weedge_a   = $time;
    time			weedge_b;
    always @(negedge we_b)	weedge_b   = $time;
    time			atmpedge_a;
    always @(atmp_a)		atmpedge_a = $time;
    time			atmpedge_b;
    always @(atmp_b)		atmpedge_b = $time;
    time			wtmpedge_a;
    always @(wtmp_a)		wtmpedge_a = $time;
    time			wtmpedge_b;
    always @(wtmp_b)		wtmpedge_b = $time;
    time			dtinedge_a;
    always @(dtin_a)		dtinedge_a = $time;
    time			dtinedge_b;
    always @(dtin_b)		dtinedge_b = $time;
    time			resetedge_a;
    always @(reset_a)		resetedge_a= $time;
    time			resetedge_b;
    always @(reset_b)		resetedge_b= $time;

    // check sync iclk_a cycle, high and low times
    always @(iclk_a)
    begin : ICLK_CYCLE_CHECK_A
	time	clkhi;
	time	clklo;
	if (cfgbits[4] == 1'b1)
	begin
	    if (iclk_a == 1'b0)
	    begin
		if (~(clkhi == 0 | $time-clkhi >= xcmClkInWthHi))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", iclk_width_a);
		    $display("Time: ", $time);
		    iclkerr_a <= 1'b1;
		    iclkerr_a <= #(1000) 1'b0;
		end
		clklo = $time;
	    end
	    else if (iclk_a == 1'b1 )
	    begin
		if (~(clklo == 0 | $time-clklo >= xcmClkInWthLo))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", iclk_low_a);
		    $display("Time: ", $time);
		    iclkerr_a <= 1'b1;
		    iclkerr_a <= #(1000) 1'b0;
		end
		if (~(clkhi == 0 | $time-clkhi >= xcmClkInWthCy))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", iclk_high_a);
		    $display("Time: ", $time);
		    iclkerr_a <= 1'b1;
		    iclkerr_a <= #(1000) 1'b0;
		end
		clkhi = $time;
	    end
	end
    end

    // check sync iclk_b cycle, high and low times
    always @(iclk_b)
    begin : ICLK_CYCLE_CHECK_B
	time	clkhi;
	time	clklo;
	if (cfgbits[17] == 1'b1)
	begin
	    if (iclk_b == 1'b0)
	    begin
		if (~(clkhi == 0 | $time-clkhi >= xcmClkInWthHi))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", iclk_width_b);
		    $display("Time: ", $time);
		    iclkerr_b <= 1'b1;
		    iclkerr_b <= #(1000) 1'b0;
		end
		clklo = $time;
	    end
	    else if (iclk_b == 1'b1 )
	    begin
		if (~(clklo == 0 | $time-clklo >= xcmClkInWthLo))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", iclk_low_b);
		    $display("Time: ", $time);
		    iclkerr_b <= 1'b1;
		    iclkerr_b <= #(1000) 1'b0;
		end
		if (~(clkhi == 0 | $time-clkhi >= xcmClkInWthCy))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", iclk_high_b);
		    $display("Time: ", $time);
		    iclkerr_b <= 1'b1;
		    iclkerr_b <= #(1000) 1'b0;
		end
		clkhi = $time;
	    end
	end
    end

    parameter	syncAddrSetup = (xcmAddrAtClkInSetup < 0) ?
				-xcmAddrAtClkInSetup : 0;
    parameter	realAddrSetup =  xcmAddrAtClkInSetup + syncAddrSetup;
    parameter	syncAddrHold  = (xcmAddrAtClkInHold  < 0) ?
				-xcmAddrAtClkInHold  : 0;
    parameter	realAddrHold  =  xcmAddrAtClkInHold  + syncAddrHold;

    // check sync address setup _a
    wire	daiclk_a;
    time	daiclk_aedge;
    assign #(syncAddrSetup) daiclk_a = iclk_a;
    always @(posedge daiclk_a) daiclk_aedge = $time;

    always @(addr_a or daiclk_aedge)
    begin : SYNC_ADDRESS_SETUP_A
	time	addrev; 
	if (cfgbits[4] == 1'b1)
	    if (daiclk_aedge == $time)
		if (addrev != 0 && ($time-addrev < realAddrSetup))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", addr2iclk_setup_a);
		    $display("Time: ", $time);
		    aserr_a <= 1'b1;	
		    aserr_a <= #(1000) 1'b0;	
		end
	    else
	    	addrev = $time;
    end

    // check sync address hold _a
    wire	dsaddr_a;
    assign #(syncAddrHold) dsaddr_a = addr_a;

    always @(dsaddr_a or iclkedge_a)
    begin : SYNC_ADDRESS_HOLD_A
	time	clkev; 
	if (cfgbits[4] == 1'b1)
	    if (iclkedge_a == $time)
	    	clkev = $time;
	    else
		if (clkev != 0 && ($time-clkev < realAddrHold))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", addr2iclk_hold_a);
		    $display("Time: ", $time);
		    aherr_a <= 1'b1;	
		    aherr_a <= #(1000) 1'b0;	
		end
    end

    // check sync address setup _b
    wire	daiclk_b;
    time	daiclk_bedge;
    assign #(syncAddrSetup) daiclk_b = iclk_b;
    always @(posedge daiclk_b) daiclk_bedge = $time;

    always @(addr_b or daiclk_bedge)
    begin : SYNC_ADDRESS_SETUP_B
	time	addrev; 
	if (cfgbits[17] == 1'b1)
	    if (daiclk_bedge == $time)
		if (addrev != 0 && ($time-addrev < realAddrSetup))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", addr2iclk_setup_b);
		    $display("Time: ", $time);
		    aserr_b <= 1'b1;	
		    aserr_b <= #(1000) 1'b0;	
		end
	    else
	    	addrev = $time;
    end

    // check sync address hold _b
    wire	dsaddr_b;
    assign #(syncAddrHold) dsaddr_b = addr_b;

    always @(dsaddr_b or iclkedge_b)
    begin : SYNC_ADDRESS_HOLD_B
	time	clkev; 
	if (cfgbits[17] == 1'b1)
	    if (iclkedge_b == $time)
	    	clkev = $time;
	    else
		if (clkev != 0 && ($time-clkev < realAddrHold))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", addr2iclk_hold_b);
		    $display("Time: ", $time);
		    aherr_b <= 1'b1;	
		    aherr_b <= #(1000) 1'b0;	
		end
    end

    parameter	syncWESetup = (xcmWriEnaAtClkInSetup < 0) ?
			      -xcmWriEnaAtClkInSetup : 0;
    parameter	realWESetup =  xcmWriEnaAtClkInSetup + syncWESetup;
    parameter	syncWEHold  = (xcmWriEnaAtClkInHold < 0) ?
			      -xcmWriEnaAtClkInHold : 0;
    parameter	realWEHold  =  xcmWriEnaAtClkInHold + syncWEHold;

    // check sync write setup _a
    wire	dwiclk_a;
    time	dwiclk_aedge;
    assign #(syncWESetup) dwiclk_a = iclk_a;
    always @(posedge dwiclk_a) dwiclk_aedge = $time;

    always @(we_a or dwiclk_aedge)
    begin : SYNC_WRITE_SETUP_A
	time	writev; 
	if (cfgbits[4] == 1'b1)
	    if (dwiclk_aedge == $time)
		if (writev != 0 && ($time-writev < realWESetup))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", write2iclk_setup_a);
		    $display("Time: ", $time);
		    aserr_a <= 1'b1;	
		    aserr_a <= #(1000) 1'b0;	
		end
	    else
	    	writev = $time;
    end

    // check sync write hold _a
    wire	dswe_a;
    assign #(syncWEHold) dswe_a = we_a;

    always @(dswe_a or iclkedge_a)
    begin : SYNC_WRITE_HOLD_A
	time	clkev; 
	if (cfgbits[4] == 1'b1)
	    if (iclkedge_a == $time)
	    	clkev = $time;
	    else
		if (clkev != 0 && ($time-clkev < realWEHold))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", write2iclk_hold_a);
		    $display("Time: ", $time);
		    aherr_a <= 1'b1;	
		    aherr_a <= #(1000) 1'b0;	
		end
    end

    // check sync write setup _b
    wire	dwiclk_b;
    time	dwiclk_bedge;
    assign #(syncWESetup) dwiclk_b = iclk_b;
    always @(posedge dwiclk_b) dwiclk_bedge = $time;

    always @(we_b or dwiclk_bedge)
    begin : SYNC_WRITE_SETUP_B
	time	writev; 
	if (cfgbits[17] == 1'b1)
	    if (dwiclk_bedge == $time)
		if (writev != 0 && ($time-writev < realWESetup))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", write2iclk_setup_b);
		    $display("Time: ", $time);
		    aserr_b <= 1'b1;	
		    aserr_b <= #(1000) 1'b0;	
		end
	    else
	    	writev = $time;
    end

    // check sync write hold _b
    wire	dswe_b;
    assign #(syncWEHold) dswe_b = we_b;

    always @(dswe_b or iclkedge_b)
    begin : SYNC_WRITE_HOLD_B
	time	clkev; 
	if (cfgbits[17] == 1'b1)
	    if (iclkedge_b == $time)
	    	clkev = $time;
	    else
		if (clkev != 0 && ($time-clkev < realWEHold))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", write2iclk_hold_b);
		    $display("Time: ", $time);
		    aherr_b <= 1'b1;	
		    aherr_b <= #(1000) 1'b0;	
		end
    end

    parameter	syncDataSetup = (xcmDinAtClkInSetup < 0) ?
				-xcmDinAtClkInSetup : 0;
    parameter	realDataSetup =  xcmDinAtClkInSetup + syncDataSetup;
    parameter	syncDataHold =  (xcmDinAtClkInHold  < 0) ?
				-xcmDinAtClkInHold  : 0;
    parameter	realDataHold =   xcmDinAtClkInHold  + syncDataHold;

    // check sync data setup _a
    wire	ddiclk_a;
    time	ddiclk_aedge;
    assign #(syncDataSetup) ddiclk_a = iclk_a;
    always @(posedge ddiclk_a) ddiclk_aedge = $time;

    always @(din_a or ddiclk_aedge)
    begin : SYNC_DATA_SETUP_A
	time	dataev; 
	if (cfgbits[5] == 1'b1)
	    if (ddiclk_aedge == $time)
		if (dataev != 0 && ($time-dataev < realDataSetup))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", data2iclk_setup_a);
		    $display("Time: ", $time);
		    dserr_a <= 1'b1;	
		    dserr_a <= #(1000) 1'b0;	
		end
	    else
	    	dataev = $time;
    end

    // check sync data hold _a
    wire	dsdin_a;
    assign #(syncDataHold) dsdin_a = din_a;

    always @(dsdin_a or iclkedge_a)
    begin : SYNC_DATA_HOLD_A
	time	clkev; 
	if (cfgbits[5] == 1'b1)
	    if (iclkedge_a == $time)
	    	clkev = $time;
	    else
		if (clkev != 0 && ($time-clkev < realDataHold))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", data2iclk_hold_a);
		    $display("Time: ", $time);
		    dherr_a <= 1'b1;	
		    dherr_a <= #(1000) 1'b0;	
		end
    end

    // check sync data setup _b
    wire	ddiclk_b;
    time	ddiclk_bedge;
    assign #(syncDataSetup) ddiclk_b = iclk_b;
    always @(posedge ddiclk_b) ddiclk_bedge = $time;

    always @(din_b or ddiclk_bedge)
    begin : SYNC_DATA_SETUP_B
	time	dataev; 
	if (cfgbits[18] == 1'b1)
	    if (ddiclk_bedge == $time)
		if (dataev != 0 && ($time-dataev < realDataSetup))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", data2iclk_setup_b);
		    $display("Time: ", $time);
		    dserr_b <= 1'b1;	
		    dserr_b <= #(1000) 1'b0;	
		end
	    else
	    	dataev = $time;
    end

    // check sync data hold _b
    wire	dsdin_b;
    assign #(syncDataHold) dsdin_b = din_b;

    always @(dsdin_b or iclkedge_b)
    begin : SYNC_DATA_HOLD_B
	time	clkev; 
	if (cfgbits[18] == 1'b1)
	    if (iclkedge_b == $time)
	    	clkev = $time;
	    else
		if (clkev != 0 && ($time-clkev < realDataHold))
		begin
		    $display ("\n%m");
		    $write("warning: ");
		    $display("%s", data2iclk_hold_b);
		    $display("Time: ", $time);
		    dherr_b <= 1'b1;	
		    dherr_b <= #(1000) 1'b0;	
		end
    end

    // check async write_a minimum valid
    always @(we_a)
    begin : MIN_WRITE_A
	time	write_ev;
	if (cfgbits[4] == 1'b0 & we_a == 1'b0)
	begin
	    if (~(write_ev == 0 | $time-write_ev >= xcmWriEnaWthHi))
	    begin
		$display ("\n%m");
		$write("warning: ");
		$display("%s", write_width_a);
		$display("Time: ", $time);
		wrwerr_a <= 1'b1;
		wrwerr_a <= #(1000) 1'b0;
	    end
	    write_ev = $time;
	end
    end

    // check async write_b minimum valid
